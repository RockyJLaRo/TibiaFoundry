    "files": [
      {"id": "msi", "file": "TibiaFoundry-{version}-MSI.zip", "inner": "TibiaFoundry-{version}.msi"},
      {"id": "portable", "file": "TibiaFoundry-{version}-Portable.zip"},
      {"id": "source", "file": "TibiaFoundry-{version}-Source.zip"}
    ],
    "checksums": "SHA256SUMS.txt",
    "releasePage": "https://github.com/RockyJLaRo/TibiaFoundry/releases/tag/v{version}",
    "allReleases": "https://github.com/RockyJLaRo/TibiaFoundry/releases"
  },
