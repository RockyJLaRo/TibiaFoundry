      "rule": "calc.experience.rule.levelExp",
      "sources": [
        {
          "url": "https://tibia.fandom.com/wiki/Experience_Formula",
          "kind": "wiki",
          "read": "2026-11-18",
          "note": "Experience for level x = 50/3*(x^3-6x^2+17x-12)."
        },
        {
          "url": "https://www.tibia.com/library/?subtopic=experiencetable",
          "kind": "official",
          "read": "2026-11-18",
          "note": "Official experience table: levels 2, 8, 100, 200, 2000 match the formula exactly."
        }
