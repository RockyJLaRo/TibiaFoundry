    {
      "id": "characterStats",
      "calc": "stats",
      "rule": "calc.stats.rule.characterStats",
      "sources": [
        {
          "url": "https://www.tibia.com/gameguides/?subtopic=manual&section=characters",
          "kind": "official",
          "read": "2026-11-18",
          "note": "Official manual, section 5.1 Characters, table 'Vocation Specific Data': hit points / mana / capacity gained per level - Druid 5/30/10, Knight 15/5/25, Monk 10/10/25, Paladin 10/15/20, Sorcerer 5/30/10; 'characters up to level 8 get a smaller hit and mana point gain for each level advance'."
        },
        {
          "url": "https://tibiaroute.com/news/A-New-Helping-Hand-II-8543-hBGo",
          "kind": "news",
          "read": "2026-11-19",
          "note": "TibiaRoute's copy of CipSoft's news 'A New Helping Hand II' (15 Oct 2025, tibia.com news id 8543, author CipSoft; capture research/calc-tests/capacity-tibiaroute-news-8543.json), about the October 2025 update (the news says 'The release is scheduled for next week, Tuesday, October 21st'): 'The base capacity for all characters, regardless of vocation, has been increased by 200, raising it to 600. This will only take effect for your character in the game after you have levelled up.' tibia.com itself answered our capture with a bot check, which we did not bypass, so the official page was not read directly.",
          "label": "calc.how.label.newsTibiaroute"
