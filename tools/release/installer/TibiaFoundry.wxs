<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows Installer package (8.8) of the folder edition: installs to Program Files\Tibia Foundry, adds a
  Start menu shortcut and an "Apps & features" entry, and upgrades an older version in place.
  Settings, logs, the Asset Library and exports live in %LOCALAPPDATA%\TibiaFoundry and the output
  folder: the installer never touches them, also not on uninstall.
  Built by tools/release/build_installer.py (WiX Toolset 5.0.2 .NET tool).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Tibia Foundry" Manufacturer="Tibia Foundry" Version="$(var.Version)"
           UpgradeCode="6F0C2D5E-8A1B-4E57-9B3C-71D4A2E9F810" Scope="perMachine" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Tibia Foundry is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="TibiaFoundry.ico" SourceFile="$(var.PublishDir)\TibiaFoundry.exe" />
    <Property Id="ARPPRODUCTICON" Value="TibiaFoundry.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://tibiafoundry.com/" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Tibia Foundry">
        <Files Include="$(var.PublishDir)\**" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="B0E6C1F4-3D72-4A8E-9C05-5E2F7A1D9B36">
        <Shortcut Id="TibiaFoundryShortcut" Name="Tibia Foundry" Description="Tibia client tools for TibiaWiki and fansites"
                  Target="[INSTALLFOLDER]TibiaFoundry.exe" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\TibiaFoundry\Installer" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>
  </Package>
</Wix>
