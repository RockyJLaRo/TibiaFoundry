<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Test-only tool. It loads the ORIGINAL TibiaWikiTools.exe (from 00_original_backup) and drives
    its code via reflection to capture screenshots and reference outputs for parity testing.
    It is not part of the shipped application.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\..\04_reference\harness_bin\</OutputPath>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>
  <PropertyGroup>
    <Orig>..\..\00_original_backup\</Orig>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="TibiaWikiTools"><HintPath>$(Orig)TibiaWikiTools.exe</HintPath></Reference>
    <Reference Include="Google.Protobuf"><HintPath>$(Orig)Google.Protobuf.dll</HintPath></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(Orig)Newtonsoft.Json.dll</HintPath></Reference>
    <Reference Include="Magick.NET-Q16-AnyCPU"><HintPath>$(Orig)Magick.NET-Q16-AnyCPU.dll</HintPath></Reference>
    <Reference Include="Magick.NET.Core"><HintPath>$(Orig)Magick.NET.Core.dll</HintPath></Reference>
    <Reference Include="NAudio.Core"><HintPath>$(Orig)NAudio.Core.dll</HintPath></Reference>
    <Reference Include="NAudio.Vorbis"><HintPath>$(Orig)NAudio.Vorbis.dll</HintPath></Reference>
    <Reference Include="NVorbis"><HintPath>$(Orig)NVorbis.dll</HintPath></Reference>
    <Reference Include="taglib-sharp"><HintPath>$(Orig)taglib-sharp.dll</HintPath></Reference>
    <Reference Include="System.Memory"><HintPath>$(Orig)System.Memory.dll</HintPath></Reference>
    <Reference Include="System.Buffers"><HintPath>$(Orig)System.Buffers.dll</HintPath></Reference>
    <Reference Include="System.Runtime.CompilerServices.Unsafe"><HintPath>$(Orig)System.Runtime.CompilerServices.Unsafe.dll</HintPath></Reference>
    <Reference Include="System.Numerics.Vectors"><HintPath>$(Orig)System.Numerics.Vectors.dll</HintPath></Reference>
    <Reference Include="System.ValueTuple"><HintPath>$(Orig)System.ValueTuple.dll</HintPath></Reference>
  </ItemGroup>
  <ItemGroup>
    <None Include="$(Orig)Magick.Native-Q16-x86.dll" Link="Magick.Native-Q16-x86.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(Orig)Magick.Native-Q16-x64.dll" Link="Magick.Native-Q16-x64.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
