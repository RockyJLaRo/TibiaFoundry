<Project>
  <!-- Central, pinned package versions (reproducible builds). -->
  <ItemGroup>
    <!-- Data formats -->
    <PackageVersion Include="Google.Protobuf" Version="3.36.2" />
    <PackageVersion Include="Grpc.Tools" Version="2.84.0" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- Imaging -->
    <PackageVersion Include="Magick.NET-Q16-AnyCPU" Version="14.16.0" />
    <PackageVersion Include="System.Drawing.Common" Version="10.0.12" />
    <!-- File metadata (8.6): tags of images, audio and video, written in place without re-encoding -->
    <PackageVersion Include="TagLibSharp" Version="2.3.0" />
    <!-- Asset Library (8.8): local SQLite index of assets, collections and versions (MIT; SQLite itself is public domain) -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <!-- Audio -->
    <PackageVersion Include="NAudio.Core" Version="2.2.1" />
    <PackageVersion Include="NAudio.WinMM" Version="2.2.1" />
    <PackageVersion Include="NAudio.Vorbis" Version="1.5.0" />
    <!-- UI -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit.v3" Version="1.1.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.0.2" />
  </ItemGroup>
</Project>
