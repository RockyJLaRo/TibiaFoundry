    <!-- TibiaProjectAuditorScript -->
    <sys:String x:Key="TibiaProjectAuditorScript.TibiaProjectFileAuditor">Auditor de archivos de proyectos de Tibia</sys:String>
    <sys:String x:Key="TibiaProjectAuditorScript.ChecksAFolderOfTibiaFiles">Comprueba una carpeta de archivos de Tibia, como un cliente archivado o la biblioteca de gráficos y exportaciones de un fansite: qué archivos de cliente contiene, si existe cada archivo que lista un catalog-content.json (y, opcionalmente, si las hojas de sprites coinciden con la suma de comprobación de su nombre), archivos que un catálogo no lista, nombres duplicados, archivos vacíos o diminutos y extensiones que no coinciden con el contenido. Compara con un manifiesto de sumas de comprobación si le das uno. No se cambia nada.</sys:String>
    <sys:String x:Key="TibiaProjectAuditorScript.ClientAssetsFoldersSpriteGalleryAnd">Carpetas assets de clientes, carpetas de sprites, galerías y exportaciones, archivos RCC, Tibia.dat/Tibia.spr heredados, cualquier carpeta</sys:String>
    <sys:String x:Key="TibiaProjectAuditorScript.ThereIsNoUniversalListOf">No existe una lista universal de archivos que deba contener un proyecto de Tibia: los archivos faltantes solo se informan respecto de un catalog-content.json encontrado en la carpeta o de un manifiesto que proporciones. Los archivos que un catálogo no lista se informan para revisión, no como errores (el cliente también guarda otros archivos allí).</sys:String>
    <sys:String x:Key="TibiaProjectAuditorScript.ExpectedFilesOptional">Archivos esperados (opcional)</sys:String>
    <sys:String x:Key="TibiaProjectAuditorScript.AChecksumManifestAsMadeBy">Un manifiesto de sumas de comprobación (como el que crea el script de sumas) que lista los archivos que debe contener la carpeta.</sys:String>
    <sys:String x:Key="TibiaProjectAuditorScript.ChecksumManifestsSha256TxtAllFiles">Manifiestos de sumas de comprobación|*.sha256;*.txt|Todos los archivos|*.*</sys:String>
    <sys:String x:Key="TibiaProjectAuditorScript.TinyFileThresholdBytes">Umbral de archivo diminuto (bytes)</sys:String>
    <sys:String x:Key="TibiaProjectAuditorScript.FilesSmallerThanThisButNot">Los archivos más pequeños que esto (pero no vacíos) se listan como sospechosos.</sys:String>
