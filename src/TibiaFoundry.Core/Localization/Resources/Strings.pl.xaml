    <!-- ClientConverter -->
    <sys:String x:Key="ClientConverter.WhatTheClientConverterIsFor">Do czego służy Konwerter klienta</sys:String>
    <sys:String x:Key="ClientConverter.WritesTheOfficialClientSModern">Zapisuje nowoczesne zasoby oficjalnego klienta w klasycznych formatach Tibia.dat i Tibia.spr oraz rozpoznaje starsze pliki znalezione w archiwach dawnych klientów. Użyj go, aby porównać dzisiejsze obiekty i sprite'y z wersjami z ery klasycznej w artykułach historycznych, otworzyć zasoby w przeglądarkach i narzędziach do sprite'ów obsługujących starszy format lub pociąć sprite'y do galerii.</sys:String>
    <sys:String x:Key="ClientConverter.SourceAndDestination">Źródło i cel</sys:String>
    <sys:String x:Key="ClientConverter.UseTheAssetsOfTheInstalled">Użyj zasobów zainstalowanego klienta Tibii (tylko odczyt)</sys:String>
    <sys:String x:Key="ClientConverter.ChooseAModernAssetsFolderWith">Wybierz folder nowoczesnych zasobów (z catalog-content.json), np. kopię zapisaną w Edytorze zasobów</sys:String>
    <sys:String x:Key="ClientConverter.FolderForTibiaDatAndTibia">Folder dla Tibia.dat i Tibia.spr</sys:String>
    <sys:String x:Key="ClientConverter.TibiaDatAndTibiaSprAre">Tibia.dat i Tibia.spr są zapisywane tutaj. Istniejące pliki są obsługiwane zgodnie z Ustawienia → Bezpieczeństwo plików (domyślnie zostaniesz zapytany, a zastępowane pliki najpierw trafią do kopii zapasowej). Pliki samego klienta są tylko odczytywane.</sys:String>
    <sys:String x:Key="ClientConverter.TargetClient">Klient docelowy</sys:String>
    <sys:String x:Key="ClientConverter.TargetClientFormat">Format klienta docelowego</sys:String>
    <sys:String x:Key="ClientConverter.OwnSignatures">Własne sygnatury</sys:String>
    <sys:String x:Key="ClientConverter.TibiaDat">Tibia.dat</sys:String>
    <sys:String x:Key="ClientConverter.HexadecimalSignatureForTibiaDatEmpty">Sygnatura szesnastkowa dla Tibia.dat (puste = sygnatura formatu)</sys:String>
    <sys:String x:Key="ClientConverter.TibiaDatSignature">Sygnatura Tibia.dat</sys:String>
    <sys:String x:Key="ClientConverter.TibiaSpr">Tibia.spr</sys:String>
    <sys:String x:Key="ClientConverter.HexadecimalSignatureForTibiaSprEmpty">Sygnatura szesnastkowa dla Tibia.spr (puste = sygnatura formatu)</sys:String>
    <sys:String x:Key="ClientConverter.TibiaSprSignature">Sygnatura Tibia.spr</sys:String>
    <sys:String x:Key="ClientConverter.OnlyForLegacyFormatToolsThat">Tylko dla narzędzi starszego formatu, które oczekują innej sygnatury. Pozostaw puste, aby użyć sygnatury formatu.</sys:String>
    <sys:String x:Key="ClientConverter.KeepTransparencyRGBASprites">Zachowaj przezroczystość (sprite'y RGBA)</sys:String>
    <sys:String x:Key="ClientConverter.StoreAnAlphaChannelWithEvery">Zapisuj kanał alfa dla każdego piksela. Tylko dla czytników obsługujących przezroczyste sprite'y; bez tego częściowo przezroczyste piksele staną się nieprzezroczyste.</sys:String>
    <sys:String x:Key="ClientConverter.DoNotStoreEmptySprites">Nie zapisuj pustych sprite'ów</sys:String>
    <sys:String x:Key="ClientConverter.FullyTransparent3232TilesGet">W pełni przezroczyste kafelki 32×32 dostają ID sprite'a 0 zamiast być zapisywane (mniejszy plik, ten sam wygląd)</sys:String>
    <sys:String x:Key="ClientConverter.ShortenMarketNamesForClient11">Skracaj nazwy marketu dla klienta 11 (29 znaków)</sys:String>
    <sys:String x:Key="ClientConverter.Client11IsReportedToRefuse">Według zgłoszeń klient 11 odrzuca Tibia.dat z nazwami marketu o długości 30 lub więcej znaków</sys:String>
    <sys:String x:Key="ClientConverter.ListNewerMarketCategoriesUnderOthers">Wymieniaj nowsze kategorie marketu w „Others”</sys:String>
    <sys:String x:Key="ClientConverter.TibiaCoinsCreatureProductsQuiversSoul">Tibia Coins, produkty stworów, kołczany, soul cores i bronie pięściarskie (kategorie 23–27) nie istniały w klientach z ery 10.98. Wyłącz tylko dla czytnika, który je zna.</sys:String>
    <sys:String x:Key="ClientConverter.ExtendedAttributesThirdPartyLegacyFormat">Atrybuty rozszerzone (tylko narzędzia innych firm w starszym formacie)</sys:String>
    <sys:String x:Key="ClientConverter.TheseModernItemPropertiesAreNot">Te nowoczesne właściwości przedmiotów nie należą do starszych formatów CipSoftu. Można je zapisać jako dodatkowe atrybuty (bajty 40–51) dla narzędzi innych firm, które je odczytują; klient CipSoftu nie otworzy pliku Tibia.dat zawierającego którąkolwiek z nich. Gdy są odznaczone, pojawiają się poniżej jako niezapisane.</sys:String>
