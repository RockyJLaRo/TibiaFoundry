    <sys:String x:Key="AppearanceExport.FrameDelays">Opóźnienia klatek</sys:String>
    <sys:String x:Key="AppearanceExport.EachAnimationPhaseInTheClient">Każda faza animacji w kliencie trwa od czasu minimalnego do maksymalnego. Wybierz, której wartości GIF użyje jako opóźnienia każdej klatki.</sys:String>
