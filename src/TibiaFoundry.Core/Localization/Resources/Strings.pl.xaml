    <!-- Home -->
    <sys:String x:Key="Home.WelcomeToTibiaFoundry">Witaj w Tibia Foundry</sys:String>
    <sys:String x:Key="Home.AnIndependentCommunityProjectTibiaIts">Niezależny projekt społeczności. Tibia, jej grafika i dane gry są © CipSoft GmbH; Tibia Foundry nie jest powiązana z CipSoft GmbH ani Fandom ani przez nie popierana.</sys:String>
    <sys:String x:Key="Home.OfficialFansites">Oficjalne fansite'y</sys:String>
    <sys:String x:Key="Home.TheOfficialTibiaFansitesAndCipSoft">Oficjalne fansite'y Tibii i Fansite Programme firmy CipSoft na tibia.com</sys:String>
    <sys:String x:Key="Home.OpenTheFolderAllExportsAre">Otwórz folder, w którym zapisywane są wszystkie eksporty (Ustawienia → Pliki i foldery)</sys:String>
    <sys:String x:Key="Home.OfficialClientLibrary">Oficjalna biblioteka klientów</sys:String>
    <sys:String x:Key="Home.ManageClients">Zarządzaj klientami…</sys:String>
    <sys:String x:Key="Home.TheClientEveryPageReads">Klient, z którego korzystają wszystkie strony:</sys:String>
    <sys:String x:Key="Home.ArchiveEachOfficialClientVersionTo">Archiwizuj każdą oficjalną wersję klienta, aby zachować jej zasoby do artykułów historycznych i porównywania aktualizacji.</sys:String>
    <sys:String x:Key="Home.RecentlyUsedTools">Ostatnio używane narzędzia</sys:String>
    <sys:String x:Key="Home.TheToolsYouOpenAppearHere">Otwierane narzędzia pojawiają się tutaj, od najnowszych, dostępne jednym kliknięciem.</sys:String>
    <sys:String x:Key="Home.RecentExports">Ostatnie eksporty</sys:String>
    <sys:String x:Key="Home.FilesAndFoldersYouSaveAppear">Zapisywane pliki i foldery pojawiają się tutaj; kliknij jeden, aby pokazać go w Eksploratorze plików. Są też dodawane do Biblioteki zasobów.</sys:String>
    <sys:String x:Key="Home.GraphicsAndContentWorkflows">Przepływy pracy dla grafiki i treści</sys:String>
    <sys:String x:Key="Home.Workflows">Przepływy pracy</sys:String>
    <sys:String x:Key="Home.AllTools">Wszystkie narzędzia</sys:String>
    <sys:String x:Key="Home.TibiaFoundryIsAnIndependentDesktop">Tibia Foundry to niezależny zestaw narzędzi na komputer dla administratorów fansite'ów, redaktorów wiki, artystów i twórców treści związanych z Tibią. Przeglądaj oficjalne zasoby gry, generuj grafikę, renderuj stroje i stwory, twórz mapy, przetwarzaj multimedia i przygotowuj materiały dla stron społeczności Tibii.</sys:String>
    <sys:String x:Key="Home.GenerateACompleteCreatureOutfitOr">Wygeneruj pełną galerię stworów, strojów lub przedmiotów</sys:String>
    <sys:String x:Key="Home.ContentStudioNewProjectChooseCreatures">Studio treści → Nowy projekt → wybierz stwory, stroje lub przedmioty → wybierz profil publikacji → Uruchom. Obrazy, arkusze, manifesty i galeria HTML powstają w tle.</sys:String>
    <sys:String x:Key="Home.KeepEveryResourceSearchableInOne">Wszystkie materiały w jednej przeszukiwalnej bibliotece</sys:String>
    <sys:String x:Key="Home.AssetLibraryAddFolderYourExports">Biblioteka zasobów → Dodaj folder… (eksporty są dodawane automatycznie) → szukaj, taguj i zbieraj; Znajdź duplikaty pokazuje identyczne i podobne obrazy bez usuwania czegokolwiek.</sys:String>
    <sys:String x:Key="Home.CreatureOrItemImagesForA">Obrazy stworów lub przedmiotów do artykułu wiki</sys:String>
    <sys:String x:Key="Home.AppearancesFindTheObjectOrOutfit">Wyglądy → znajdź obiekt lub strój → karta Eksport → ustawienie „Obraz TibiaWiki” → Zapisz jako GIF. Twoje przypisanie autorstwa jest zapisywane w każdym pliku.</sys:String>
    <sys:String x:Key="Home.AConsistentOutfitOrCreatureGallery">Spójna galeria strojów lub stworów</sys:String>
    <sys:String x:Key="Home.AppearancesSelectSeveralOutfitsPresetOutfit">Wyglądy → wybierz kilka strojów → ustawienie „Galeria strojów” lub „Galeria stworów” (2×, posortowane w folderach) → Zapisz jako GIF. Kolory i dodatki ustawisz na karcie Outfitter.</sys:String>
    <sys:String x:Key="Home.MapReferencesAndHouseImages">Odniesienia do map i obrazy domów</sys:String>
    <sys:String x:Key="Home.MapToolsForMapImagesAreas">Narzędzia map do obrazów map, obszarów i pozycji NPC; Obrazy domów do zdjęcia każdego domu, gotowego do artykułów o domach.</sys:String>
    <sys:String x:Key="Home.WhatChangedInTheLatestClient">Co zmieniło się w najnowszej aktualizacji klienta</sys:String>
    <sys:String x:Key="Home.ClientsArchiveEachOfficialVersionCompare">Klienci → zarchiwizuj każdą oficjalną wersję → Porównaj pliki, aby wypisać nowe, zmienione i usunięte obiekty, stwory i dane map do artykułów o aktualizacjach.</sys:String>
    <sys:String x:Key="Home.BatchProcessAndCreditPublishedImages">Przetwarzanie wsadowe i podpisywanie publikowanych obrazów</sys:String>
    <sys:String x:Key="Home.ScriptsBatchImageConverterAndResizer">Skrypty → Wsadowy konwerter i skaler obrazów do zmiany rozmiaru (najbliższy sąsiad zachowuje ostrość pixel artu) i formatu; Metadane plików do sprawdzania lub ustawiania autora i praw autorskich hurtowo.</sys:String>
