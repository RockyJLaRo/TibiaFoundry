    <!-- About -->
    <sys:String x:Key="About.Tagline">Hasło</sys:String>
    <sys:String x:Key="About.TibiaFoundryIsAnIndependentDesktop">Tibia Foundry to niezależny zestaw narzędzi na komputer, stworzony, by wspierać społeczność Tibii. Zawiera narzędzia do zarządzania zasobami, generowania grafiki, konwersji, przeglądania danych i tworzenia treści, przeznaczone dla administratorów fansite'ów, redaktorów wiki, artystów i twórców związanych z Tibią.</sys:String>
    <sys:String x:Key="About.ItReadsTheOfficialFilesOf">Odczytuje oficjalne pliki zainstalowanego klienta Tibii i zamienia je w materiały dla wiki, fansite'ów, poradników i galerii: sprite'y i animowane GIF-y, obrazy strojów, stworów i domów, mapy, dźwięki, dane przedmiotów i stworów oraz tabele handlu z NPC – każdy z Twoim przypisaniem autorstwa.</sys:String>
