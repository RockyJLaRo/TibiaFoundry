    <!-- Rebuilder -->
    <sys:String x:Key="Rebuilder.MakesANormalFolderFromAn">Tworzy zwykły folder z zarchiwizowanej rewizji, wyłącznie z jej własnego zapisu i zarchiwizowanej zawartości (nigdy z zainstalowanego klienta). Pełna instalacja jest odtwarzana; każda inna rewizja jest przywracana jako folder, którym była. Folder wyjściowy musi być nowy lub pusty: nic nie jest zastępowane. Każdy plik jest sprawdzany, zanim folder zostanie użyty.</sys:String>
    <sys:String x:Key="Rebuilder.ARebuiltFolderHasEveryRecorded">Odtworzony folder zawiera każdy zapisany plik z zapisaną zawartością. Nie jest sprawdzane, czy klient z niego wystartuje: zależy to od systemu Windows, launchera, Twojego konta i serwerów gry.</sys:String>
