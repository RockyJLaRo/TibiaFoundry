<UserControl x:Class="TibiaFoundry.App.Views.Pages.ScriptsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TibiaFoundry.App.ViewModels"
             xmlns:controls="clr-namespace:TibiaFoundry.App.Controls"
             xmlns:loc="clr-namespace:TibiaFoundry.App.Localization">
    <UserControl.Resources>
        <CollectionViewSource x:Key="GroupedScripts" Source="{Binding Visible}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Category" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <DataTemplate x:Key="InputTemplate" DataType="{x:Type vm:ScriptParameterItem}">
            <StackPanel Margin="0,0,0,10" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}" Width="170" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <!-- Path inputs: text box and pickers -->
                    <DockPanel Visibility="{Binding IsPath, Converter={StaticResource BoolToVisibility}}">
                        <Button DockPanel.Dock="Right" Content="{loc:Tr Scripts.Folder}" Command="{Binding PickFolderCommand}" Margin="6,0,0,0"
                                Visibility="{Binding CanPickFolder, Converter={StaticResource BoolToVisibility}}" ToolTip="{loc:Tr Scripts.ChooseAFolder}" />
                        <Button DockPanel.Dock="Right" Content="{loc:Tr Scripts.File}" Command="{Binding PickFileCommand}" Margin="6,0,0,0"
                                Visibility="{Binding CanPickFile, Converter={StaticResource BoolToVisibility}}" ToolTip="{loc:Tr Scripts.ChooseAFile}" />
                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged, Delay=300}" FontFamily="{StaticResource App.MonoFont}" FontSize="12"
                                 AutomationProperties.Name="{Binding Label}" ToolTip="{Binding Help}" />
                    </DockPanel>
                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged, Delay=300}" Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}"
                             AutomationProperties.Name="{Binding Label}" ToolTip="{Binding Help}" />
                    <CheckBox IsChecked="{Binding BoolValue}" Visibility="{Binding IsBoolean, Converter={StaticResource BoolToVisibility}}" VerticalAlignment="Center"
                              AutomationProperties.Name="{Binding Label}" ToolTip="{Binding Help}" />
                    <ComboBox ItemsSource="{Binding Choices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Value}"
                              Visibility="{Binding IsChoice, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{Binding Label}" ToolTip="{Binding Help}" />
                </DockPanel>
                <TextBlock Text="{Binding Help}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="170,3,0,0" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="16,14,16,14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" MinWidth="220" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="420" />
        </Grid.ColumnDefinitions>

        <!-- Script list -->
        <GroupBox Header="{loc:Tr Common.Scripts}">
            <DockPanel>
                <TextBox DockPanel.Dock="Top" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=150}" controls:Input.Placeholder="{loc:Tr Scripts.SearchScripts}" Margin="0,0,0,6"
                         AutomationProperties.Name="{loc:Tr Scripts.SearchScripts}" />
                <ComboBox DockPanel.Dock="Top" ItemsSource="{Binding Categories}" loc:Choice.Prefix="Choice.ScriptCategory" SelectedItem="{Binding Category}" Margin="0,0,0,8" AutomationProperties.Name="{loc:Tr Scripts.ScriptCategory}" />
                <ListBox x:Name="ScriptList" ItemsSource="{Binding Source={StaticResource GroupedScripts}}" SelectedItem="{Binding Selected}" AutomationProperties.Name="{loc:Tr Common.Scripts}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Margin="6,10,0,2" Foreground="{DynamicResource App.TextSecondary}" Typography.Capitals="AllSmallCaps" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ScriptItem}">
                            <StackPanel Margin="2,3" ToolTip="{Binding Description}">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{loc:Tr Scripts.CanChangeFilesPreviewedFirst}" FontSize="11" Foreground="{DynamicResource App.TextSecondary}"
                                           Visibility="{Binding ChangesFiles, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </GroupBox>

        <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Center" Background="Transparent" />

        <TabControl Grid.Column="2">
            <TabItem Header="{loc:Tr Common.Run}">
                <Grid>
                    <TextBlock Style="{StaticResource EmptyState}" Text="{loc:Tr Scripts.ChooseAScriptOnTheLeft}"
                               Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Margin="12,10,12,12">
                            <TextBlock Text="{Binding Selected.Name}" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding Selected.Description}" TextWrapping="Wrap" Margin="0,4,0,6" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"><Run Text="{loc:Tr Scripts.Reads}" FontWeight="SemiBold" /> <Run Text="{Binding SupportedInputs, Mode=OneWay}" /></TextBlock>
                            <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,12"><Run Text="{loc:Tr Scripts.Limits}" FontWeight="SemiBold" /> <Run Text="{Binding Limitations, Mode=OneWay}" /></TextBlock>

                            <ItemsControl ItemsSource="{Binding Inputs}" ItemTemplate="{StaticResource InputTemplate}" AutomationProperties.Name="{loc:Tr Scripts.ScriptInputs}" />
                            <CheckBox Content="{loc:Tr Scripts.ShowAdvancedOptions}" IsChecked="{Binding ShowAdvanced}" Margin="170,0,0,10"
                                      Visibility="{Binding HasAdvanced, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding Problems}" Foreground="{DynamicResource App.Danger}" TextWrapping="Wrap" Margin="170,0,0,8"
                                       Visibility="{Binding Problems, Converter={StaticResource NullToVisibility}}" />
                            <StackPanel Orientation="Horizontal" Margin="170,0,0,14">
                                <Button Content="{Binding RunLabel}" Style="{StaticResource PrimaryButton}" Command="{Binding RunCommand}" MinWidth="130" Margin="0,0,8,0"
                                        ToolTip="{loc:Tr Scripts.StartTheScriptWithTheseInputs}" />
                                <Button Content="{loc:Tr Common.SaveReport}" Command="{Binding ExportReportCommand}" IsEnabled="{Binding HasResult}" Margin="0,0,8,0" ToolTip="{loc:Tr Scripts.SaveTheResultTableAsCSV}" />
                                <Button Content="{loc:Tr Common.OpenOutput}" Command="{Binding OpenOutputCommand}" Visibility="{Binding OutputFolder, Converter={StaticResource NullToVisibility}}" Margin="0,0,8,0" />
                                <Button Content="{loc:Tr Scripts.OpenBackup}" Command="{Binding OpenBackupCommand}" Visibility="{Binding BackupFolder, Converter={StaticResource NullToVisibility}}"
                                        ToolTip="{loc:Tr Scripts.TheFilesThisRunReplacedOr}" />
                            </StackPanel>

                            <!-- Result -->
                            <TextBox Style="{StaticResource ValueText}" Text="{Binding ResultSummary, Mode=OneWay}" FontWeight="SemiBold" Margin="0,0,0,6" AutomationProperties.Name="{loc:Tr Scripts.ResultSummary}" />
                            <ItemsControl ItemsSource="{Binding Messages}" Margin="0,0,0,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,2" /></DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Preview of proposed changes -->
                            <Border Style="{StaticResource InfoBanner}" Padding="10" Margin="0,0,0,10" Visibility="{Binding HasPlan, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <Button DockPanel.Dock="Right" Content="{loc:Tr Scripts.ApplySelectedChanges}" Style="{StaticResource PrimaryButton}" Command="{Binding ApplyCommand}"
                                                ToolTip="{loc:Tr Scripts.ChangeTheFilesAfterOneMore}" />
                                        <Button DockPanel.Dock="Right" Content="{loc:Tr Scripts.None}" Command="{Binding SelectAllCommand}" CommandParameter="none" Margin="0,0,8,0" />
                                        <Button DockPanel.Dock="Right" Content="{loc:Tr Scripts.All}" Command="{Binding SelectAllCommand}" CommandParameter="all" Margin="0,0,6,0" />
                                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold"><Run Text="{loc:Tr Scripts.PreviewNothingHasBeenChangedYet}" /> <Run Text="{Binding PlanSummary, Mode=OneWay}" /></TextBlock>
                                    </DockPanel>
                                    <ListView ItemsSource="{Binding Plan}" MaxHeight="320" VirtualizingPanel.IsVirtualizing="True" AutomationProperties.Name="{loc:Tr Scripts.ProposedChanges}">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Width="36">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate><CheckBox IsChecked="{Binding Selected}" IsEnabled="{Binding IsEnabled}" AutomationProperties.Name="{loc:Tr Scripts.IncludeThisChange}" /></DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="{loc:Tr Scripts.Action}" Width="130" DisplayMemberBinding="{Binding Action}" />
                                                <GridViewColumn Header="{loc:Tr Common.File}" Width="300" DisplayMemberBinding="{Binding Source}" />
                                                <GridViewColumn Header="{loc:Tr Scripts.NewNameTarget}" Width="260" DisplayMemberBinding="{Binding Target}" />
                                                <GridViewColumn Header="{loc:Tr Common.Note}" Width="260" DisplayMemberBinding="{Binding Detail}" />
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </StackPanel>
                            </Border>

                            <DataGrid ItemsSource="{Binding ResultTable}" AutoGenerateColumns="True" IsReadOnly="True" MaxHeight="520" CanUserAddRows="False"
                                      HeadersVisibility="Column" VirtualizingPanel.IsVirtualizing="True" EnableRowVirtualization="True"
                                      Visibility="{Binding ResultTable, Converter={StaticResource NullToVisibility}}" AutomationProperties.Name="{loc:Tr Scripts.ResultTable}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Header="{loc:Tr Common.History}">
                <DockPanel Margin="10">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="{loc:Tr Common.ClearHistory}" Command="{Binding ClearHistoryCommand}" ToolTip="{loc:Tr Scripts.ForgetTheListBelowFilesWritten}" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Text="{loc:Tr Scripts.RunsPreviewsAndAppliedChangesNewest}" />
                    </DockPanel>
                    <ListView ItemsSource="{Binding History}" AutomationProperties.Name="{loc:Tr Scripts.ScriptHistory}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="{loc:Tr Scripts.When}" Width="130" DisplayMemberBinding="{Binding StartedUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}, ConverterCulture=en-US}" />
                                <GridViewColumn Header="{loc:Tr Scripts.Script}" Width="190" DisplayMemberBinding="{Binding ScriptName}" />
                                <GridViewColumn Header="{loc:Tr Common.Kind}" Width="70" DisplayMemberBinding="{Binding Kind}" />
                                <GridViewColumn Header="{loc:Tr Scripts.ChangedFiles}" Width="96" DisplayMemberBinding="{Binding ChangesApplied}" />
                                <GridViewColumn Header="{loc:Tr Scripts.OKFailed}" Width="90">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate><TextBlock><Run Text="{Binding Succeeded, Mode=OneWay}" /> / <Run Text="{Binding Failed, Mode=OneWay}" /></TextBlock></DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{loc:Tr Common.Input}" Width="220" DisplayMemberBinding="{Binding Input}" />
                                <GridViewColumn Header="{loc:Tr Common.Summary}" Width="420" DisplayMemberBinding="{Binding Summary}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
