<UserControl x:Class="TibiaFoundry.App.Views.Pages.StaticDataPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TibiaFoundry.App.ViewModels"
             xmlns:controls="clr-namespace:TibiaFoundry.App.Controls"
             xmlns:loc="clr-namespace:TibiaFoundry.App.Localization">
    <Grid Margin="16,14,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Panel}" Padding="12,10" Margin="0,0,0,12">
            <DockPanel>
                <TextBlock Text="{loc:Tr StaticData.StaticData}" Style="{StaticResource FieldLabel}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button Content="{loc:Tr Common.Load}" Style="{StaticResource PrimaryButton}" Command="{Binding LoadCommand}" MinWidth="70" ToolTip="{loc:Tr StaticData.ReadTheStaticDataFileShown}" />
                    <Button Content="{loc:Tr Common.ChangeFile}" Command="{Binding ChangeFileCommand}" Margin="6,0,0,0" ToolTip="{loc:Tr StaticData.ChooseADifferentStaticdataDatFile}" />
                    <Button Content="{loc:Tr Common.ExportJSON}" Command="{Binding ExportJsonCommand}" Margin="6,0,0,0" ToolTip="{loc:Tr StaticData.SaveAllStaticDataInOne}" />
                </StackPanel>
                <TextBox Style="{StaticResource PathBox}" Text="{Binding DatPath, Mode=OneWay, Converter={StaticResource LocOr}, ConverterParameter=StaticData.NoStaticDataFileFound}" AutomationProperties.Name="{loc:Tr StaticData.StaticDataFile}" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350" MinWidth="240" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" MinWidth="400" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Panel}" Padding="10">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource SegmentHost}" HorizontalAlignment="Left" Margin="0,0,0,8">
                        <WrapPanel>
                            <RadioButton Style="{StaticResource SegmentRadio}" Content="{loc:Tr StaticData.Monsters}" GroupName="SK" IsChecked="{Binding Kind, Converter={StaticResource EnumEquals}, ConverterParameter=Monsters}" />
                            <RadioButton Style="{StaticResource SegmentRadio}" Content="{loc:Tr StaticData.Bosses}" GroupName="SK" IsChecked="{Binding Kind, Converter={StaticResource EnumEquals}, ConverterParameter=Bosses}" />
                            <RadioButton Style="{StaticResource SegmentRadio}" Content="{loc:Tr StaticData.Achievements}" GroupName="SK" IsChecked="{Binding Kind, Converter={StaticResource EnumEquals}, ConverterParameter=Achievements}" />
                            <RadioButton Style="{StaticResource SegmentRadio}" Content="{loc:Tr Common.Houses}" GroupName="SK" IsChecked="{Binding Kind, Converter={StaticResource EnumEquals}, ConverterParameter=Houses}" />
                            <RadioButton Style="{StaticResource SegmentRadio}" Content="{loc:Tr StaticData.Quests}" GroupName="SK" IsChecked="{Binding Kind, Converter={StaticResource EnumEquals}, ConverterParameter=Quests}" />
                        </WrapPanel>
                    </Border>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="2" Style="{StaticResource SubtleButton}" Command="{Binding ClearFiltersCommand}" Margin="4,0,0,0"
                                ToolTip="{loc:Tr Common.ClearFilters}" AutomationProperties.Name="{loc:Tr Common.ClearFilters}">
                            <TextBlock Text="&#xE894;" Style="{StaticResource Icon}" FontSize="12" />
                        </Button>
                        <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=150}" ToolTip="{loc:Tr Common.FilterByNameOrID}" controls:Input.Placeholder="{loc:Tr Common.FilterByNameOrID}" AutomationProperties.Name="{loc:Tr Common.FilterByNameOrID}" />
                        <TextBox Grid.Column="1" Width="96" Margin="6,0,0,0" Text="{Binding SpriteFilter, UpdateSourceTrigger=PropertyChanged, Delay=300}" controls:Input.Placeholder="{loc:Tr Common.SpriteID}"
                                 ToolTip="{loc:Tr StaticData.ShowCreaturesWhoseOutfitUsesThis}" AutomationProperties.Name="{loc:Tr StaticData.FilterBySpriteID}"
                                 Visibility="{Binding IsCreatureList, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Foreground="{DynamicResource App.TextSecondary}" FontSize="12" VerticalAlignment="Center">
                            <Run Text="{Binding VisibleCount, Mode=OneWay, Converter={StaticResource Number}}" /> <Run Text="{loc:Tr Common.Of}" /> <Run Text="{Binding TotalCount, Mode=OneWay, Converter={StaticResource Number}}" />
                        </TextBlock>
                        <Button DockPanel.Dock="Left" Style="{StaticResource SubtleButton}" Content="{loc:Tr StaticData.SelectAll}" Command="{Binding SelectAllCommand}" Margin="8,0,0,0"
                                ToolTip="{loc:Tr StaticData.SelectAllTip}" Visibility="{Binding IsCreatureList, Converter={StaticResource BoolToVisibility}}" />
                        <CheckBox DockPanel.Dock="Right" Content="{loc:Tr StaticData.ColoredThumbnails}" IsChecked="{Binding RenderOutfits}" Visibility="{Binding IsCreatureList, Converter={StaticResource BoolToVisibility}}"
                                  ToolTip="{loc:Tr StaticData.ShowEachCreatureSCompleteOutfit}" />
                    </DockPanel>
                    <Grid>
                        <ListView x:Name="List" ItemsSource="{Binding VisibleItems}" SelectedItem="{Binding SelectedItem}" SelectionMode="Extended" SelectionChanged="OnListSelectionChanged"
                                  VirtualizingPanel.ScrollUnit="Pixel" AutomationProperties.Name="{loc:Tr StaticData.StaticDataList}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="" Width="76">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type vm:ListItem}">
                                                <Border Width="64" Height="64" Background="{DynamicResource App.Checkerboard}" CornerRadius="3"
                                                        Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVisibility}}">
                                                    <Image Source="{Binding Thumbnail}" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                                </Border>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="ID" Width="60" DisplayMemberBinding="{Binding Id}" />
                                    <GridViewColumn Header="{loc:Tr Common.Name}" Width="170">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type vm:ListItem}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource App.TextSecondary}" Visibility="{Binding Detail, Converter={StaticResource NullToVisibility}}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <TextBlock Style="{StaticResource EmptyState}" Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"
                                   Text="{loc:Tr StaticData.NoStaticDataLoadedYetClick}" />
                    </Grid>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" />

            <DockPanel Grid.Column="2">
                <Border DockPanel.Dock="Top" Style="{StaticResource Panel}" Margin="0,0,0,10" Visibility="{Binding IsCreatureList, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource PreviewSurface}" Tag="{Binding PreviewBackground}" Width="140" Height="140" MouseLeftButtonUp="OnPreviewClicked" AutomationProperties.Name="{loc:Tr StaticData.CreaturePreview}">
                            <Grid>
                                <controls:AnimatedSprite Frames="{Binding Frames}" Delays="{Binding Delays}" IsAnimating="{Binding Animate}" ForcedDelay="{Binding EffectiveDelay}" Zoom="2" Fit="True" Margin="6" />
                                <TextBlock Text="{Binding PreviewMessage}" Style="{StaticResource EmptyState}" FontSize="11" Margin="6" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="{Binding SelectedItem.Name}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Foreground="{DynamicResource App.TextSecondary}" Margin="0,2,0,10"><Run Text="{loc:Tr StaticData.Race}" /> <Run Text="{Binding SelectedItem.Id, Mode=OneWay}" /></TextBlock>
                            <WrapPanel>
                                <CheckBox Content="{loc:Tr Common.Animate}" IsChecked="{Binding Animate}" Margin="0,0,14,6" ToolTip="{loc:Tr Common.PlayTheAnimationInThePreview}" />
                                <CheckBox Content="{loc:Tr Common.FixedFrameDelay}" IsChecked="{Binding ForceDelay}" Margin="0,0,6,6" ToolTip="{loc:Tr StaticData.UseThisDelayBetweenFramesIn}" />
                                <controls:NumericUpDown Value="{Binding ForcedDelayMs}" Minimum="10" Maximum="5000" Increment="10" Width="86" Margin="0,0,4,6" IsEnabled="{Binding ForceDelay}" AutomationProperties.Name="{loc:Tr Common.FixedFrameDelayInMilliseconds}" />
                                <TextBlock Text="{loc:Tr Common.Ms}" VerticalAlignment="Center" Margin="0,0,0,6" Foreground="{DynamicResource App.TextSecondary}" />
                            </WrapPanel>
                            <WrapPanel>
                                <Button Content="{loc:Tr StaticData.OpenInOutfitter}" Command="{Binding OpenInOutfitterCommand}" Margin="0,0,8,0" ToolTip="{loc:Tr StaticData.OpenThisCreatureSOutfitWith}" />
                                <Button Command="{Binding ExportGifCommand}" Margin="0,0,8,0" ToolTip="{loc:Tr StaticData.ExportGIFTip}">
                                    <TextBlock><Run Text="{loc:Tr StaticData.ExportGIF}" /> <Run Text="{Binding SelectedCount, Mode=OneWay, StringFormat=({0:N0})}" /></TextBlock>
                                </Button>
                                <Button Content="{loc:Tr StaticData.ExportAllMonstersAndBosses}" Command="{Binding ExportAllCreatureGifsCommand}" Margin="0,0,8,0" ToolTip="{loc:Tr StaticData.ExportAllTip}" />
                                <Button Content="{loc:Tr StaticData.GalleryOfTheList}" Command="{Binding CreateGalleryCommand}"
                                        ToolTip="{loc:Tr StaticData.ContentStudioACreatureGalleryProject}" />
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Border>
                <ItemsControl Style="{StaticResource PropertyList}" ItemsSource="{Binding Properties}" Tag="220" AutomationProperties.Name="{loc:Tr Common.Properties}" />
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
