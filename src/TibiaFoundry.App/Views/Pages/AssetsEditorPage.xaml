<UserControl x:Class="TibiaFoundry.App.Views.Pages.AssetsEditorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TibiaFoundry.App.ViewModels"
             xmlns:infra="clr-namespace:TibiaFoundry.App.Infrastructure"
             xmlns:controls="clr-namespace:TibiaFoundry.App.Controls"
             xmlns:appearances="clr-namespace:TibiaFoundry.Core.Appearances;assembly=TibiaFoundry.Core"
             xmlns:loc="clr-namespace:TibiaFoundry.App.Localization">
    <UserControl.Resources>
        <!-- Property rows: one template per kind of field. -->
        <DataTemplate x:Key="HeaderRow" DataType="{x:Type vm:PropertyNode}">
            <TextBlock Text="{Binding Label}" Style="{StaticResource SectionTitle}" FontSize="13" Margin="0,10,0,4" />
        </DataTemplate>
        <DataTemplate x:Key="BoolRow" DataType="{x:Type vm:PropertyNode}">
            <CheckBox Content="{Binding Label}" IsChecked="{Binding BoolValue}" IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBool}}"
                      Margin="{Binding Indent, Converter={StaticResource IndentMargin}}" ToolTip="{Binding Help}" Padding="6,1,0,1" />
        </DataTemplate>
        <DataTemplate x:Key="PresenceRow" DataType="{x:Type vm:PropertyNode}">
            <CheckBox Content="{Binding Label}" IsChecked="{Binding BoolValue}" FontWeight="SemiBold"
                      Margin="{Binding Indent, Converter={StaticResource IndentMargin}}" ToolTip="{Binding Help}" Padding="6,1,0,1" />
        </DataTemplate>
        <DataTemplate x:Key="ValueRow" DataType="{x:Type vm:PropertyNode}">
            <DockPanel Margin="{Binding Indent, Converter={StaticResource IndentMargin}}" ToolTip="{Binding Help}">
                <TextBlock Text="{Binding Label}" Width="150" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource App.TextSecondary}" />
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Error}" Foreground="{DynamicResource App.Danger}" FontSize="11" TextWrapping="Wrap"
                           Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}" />
                <TextBox Text="{Binding TextValue, UpdateSourceTrigger=LostFocus}" IsReadOnly="{Binding IsReadOnly}" MinHeight="24" Padding="4,1" AutomationProperties.Name="{Binding Label}" />
            </DockPanel>
        </DataTemplate>
        <DataTemplate x:Key="EnumRow" DataType="{x:Type vm:PropertyNode}">
            <DockPanel Margin="{Binding Indent, Converter={StaticResource IndentMargin}}" ToolTip="{Binding Help}">
                <TextBlock Text="{Binding Label}" Width="150" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource App.TextSecondary}" />
                <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}" MinHeight="24" AutomationProperties.Name="{Binding Label}" />
            </DockPanel>
        </DataTemplate>
        <DataTemplate x:Key="ListHeaderRow" DataType="{x:Type vm:PropertyNode}">
            <DockPanel Margin="{Binding Indent, Converter={StaticResource IndentMargin}}" ToolTip="{Binding Help}">
                <Button DockPanel.Dock="Right" Content="{loc:Tr Common.Add}" Command="{Binding AddCommand}" MinHeight="22" Padding="8,0"
                        Visibility="{Binding CanAdd, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{loc:Tr AssetsEditor.AddAnEntry}" />
                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
        </DataTemplate>
        <DataTemplate x:Key="ItemHeaderRow" DataType="{x:Type vm:PropertyNode}">
            <DockPanel Margin="{Binding Indent, Converter={StaticResource IndentMargin}}">
                <Button DockPanel.Dock="Right" Content="{loc:Tr Common.Remove}" Command="{Binding RemoveCommand}" MinHeight="22" Padding="8,0"
                        Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{loc:Tr AssetsEditor.RemoveThisEntry}" />
                <TextBlock Text="{Binding Label}" Foreground="{DynamicResource App.TextSecondary}" VerticalAlignment="Center" />
            </DockPanel>
        </DataTemplate>
        <infra:PropertyTemplateSelector x:Key="PropertyTemplates" Header="{StaticResource HeaderRow}" Bool="{StaticResource BoolRow}" Presence="{StaticResource PresenceRow}"
                                        Number="{StaticResource ValueRow}" Text="{StaticResource ValueRow}" RepeatedValues="{StaticResource ValueRow}"
                                        Enum="{StaticResource EnumRow}" ListHeader="{StaticResource ListHeaderRow}" ItemHeader="{StaticResource ItemHeaderRow}" />

        <GridView x:Key="SheetColumns" x:Shared="False">
            <GridViewColumn Header="{loc:Tr Common.Sprites}" Width="130" DisplayMemberBinding="{Binding Range}" />
            <GridViewColumn Header="{loc:Tr Common.Size}" Width="64" DisplayMemberBinding="{Binding Size}" />
            <GridViewColumn Header="{loc:Tr AssetsEditor.Count}" Width="56" DisplayMemberBinding="{Binding Count}" />
        </GridView>
    </UserControl.Resources>

    <Grid Margin="16,14,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Folder and saving -->
        <Border Style="{StaticResource Panel}" Padding="12,10" Margin="0,0,0,10">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="{loc:Tr Common.Assets}" Style="{StaticResource FieldLabel}" Width="60" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                        <Button Content="{loc:Tr Common.Open2}" Command="{Binding OpenCommand}" Margin="0,0,6,0" ToolTip="{loc:Tr AssetsEditor.OpenAClientAssetsFolderThe}" />
                        <Button Content="{loc:Tr Common.InstalledClient}" Command="{Binding OpenClientCommand}" Margin="0,0,6,0" ToolTip="{loc:Tr AssetsEditor.OpenTheInstalledClientSAssets}" />
                        <Button Content="{loc:Tr Common.Save}" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" Margin="0,0,6,0" IsEnabled="{Binding HasProject}"
                                ToolTip="{loc:Tr AssetsEditor.SaveIntoThisFolderNewFiles}" />
                        <Button Content="{loc:Tr Common.SaveAs}" Command="{Binding SaveAsCommand}" Margin="0,0,6,0" IsEnabled="{Binding HasProject}" ToolTip="{loc:Tr AssetsEditor.SaveACompleteCopyOfThe}" />
                        <Button Content="{loc:Tr AssetsEditor.ExportToLegacyClient}" Command="{Binding ExportLegacyCommand}" IsEnabled="{Binding HasProject}"
                                ToolTip="{loc:Tr AssetsEditor.ConvertTheSavedFolderIntoTibia}" />
                    </StackPanel>
                    <TextBox Style="{StaticResource PathBox}" Text="{Binding FolderText, Mode=OneWay}" AutomationProperties.Name="{loc:Tr AssetsEditor.AssetsFolder}" />
                </DockPanel>
                <TextBlock Text="{Binding Summary}" Margin="60,8,0,0" FontWeight="SemiBold" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1">
            <TabItem Header="{loc:Tr Common.Objects}">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <!-- List, preview and properties share the width; the minimums fit the smallest window. -->
                        <ColumnDefinition Width="290" MinWidth="220" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="200" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="1.3*" MinWidth="260" />
                    </Grid.ColumnDefinitions>

                    <!-- Object list -->
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource SegmentHost}" HorizontalAlignment="Stretch" Margin="0,0,0,8">
                            <UniformGrid Columns="4">
                                <RadioButton Style="{StaticResource SegmentRadio}" Content="{loc:Tr Common.Objects}" GroupName="EditorKind" IsChecked="{Binding Kind, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static appearances:AppearanceKind.Object}}" />
                                <RadioButton Style="{StaticResource SegmentRadio}" Content="{loc:Tr Common.Outfits}" GroupName="EditorKind" IsChecked="{Binding Kind, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static appearances:AppearanceKind.Outfit}}" />
                                <RadioButton Style="{StaticResource SegmentRadio}" Content="{loc:Tr Common.Effects}" GroupName="EditorKind" IsChecked="{Binding Kind, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static appearances:AppearanceKind.Effect}}" />
                                <RadioButton Style="{StaticResource SegmentRadio}" Content="{loc:Tr Common.Missiles}" GroupName="EditorKind" IsChecked="{Binding Kind, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static appearances:AppearanceKind.Missile}}" />
                            </UniformGrid>
                        </Border>
                        <TextBox DockPanel.Dock="Top" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=250}" controls:Input.Placeholder="{loc:Tr AssetsEditor.IDIDRange100200Or}" Margin="0,0,0,6"
                                 AutomationProperties.Name="{loc:Tr AssetsEditor.SearchObjects}" />
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="{loc:Tr AssetsEditor.HasFlag}" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{Binding FlagFilters}" loc:Choice.Prefix="Choice.Common" SelectedItem="{Binding FlagFilter}" AutomationProperties.Name="{loc:Tr AssetsEditor.FlagFilter}" ToolTip="{loc:Tr AssetsEditor.ShowOnlyObjectsThatHaveThis}" />
                        </DockPanel>
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <Button Content="{loc:Tr AssetsEditor.New}" Command="{Binding NewObjectCommand}" Margin="0,0,4,4" IsEnabled="{Binding HasProject}" ToolTip="{loc:Tr AssetsEditor.CreateANewObjectOfThis}" />
                            <Button Content="{loc:Tr AssetsEditor.Duplicate}" Command="{Binding DuplicateCommand}" Margin="0,0,4,4" IsEnabled="{Binding HasSelection}" ToolTip="{loc:Tr AssetsEditor.CopyTheSelectedObjectUnderA}" />
                            <Button Content="{loc:Tr AssetsEditor.Delete}" Command="{Binding DeleteCommand}" Margin="0,0,4,4" IsEnabled="{Binding HasSelection}" ToolTip="{loc:Tr AssetsEditor.DeleteTheSelectedObjectsYouAre}" />
                            <Button Content="{loc:Tr AssetsEditor.ChangeID}" Command="{Binding ChangeIdCommand}" Margin="0,0,4,4" IsEnabled="{Binding HasSelection}" />
                            <Button Content="{loc:Tr Common.Revert}" Command="{Binding RevertCommand}" Margin="0,0,4,4" IsEnabled="{Binding HasSelection}" ToolTip="{loc:Tr AssetsEditor.DiscardTheUnsavedChangesOfThis}" />
                            <Button Content="{loc:Tr AssetsEditor.CopyFlags}" Command="{Binding CopyFlagsCommand}" Margin="0,0,4,4" IsEnabled="{Binding HasSelection}" />
                            <Button Content="{loc:Tr AssetsEditor.PasteFlags}" Command="{Binding PasteFlagsCommand}" Margin="0,0,4,4" IsEnabled="{Binding HasSelection}" ToolTip="{loc:Tr AssetsEditor.ReplaceTheFlagsOfTheSelected}" />
                            <Button Content="{loc:Tr AssetsEditor.ExportPackage}" Command="{Binding ExportPackageCommand}" Margin="0,0,4,4" IsEnabled="{Binding HasSelection}"
                                    ToolTip="{loc:Tr AssetsEditor.SaveTheSelectedObjectsWithTheir}" />
                            <Button Content="{loc:Tr AssetsEditor.ImportPackage}" Command="{Binding ImportPackageCommand}" Margin="0,0,4,4" IsEnabled="{Binding HasProject}" />
                            <Button Content="{loc:Tr AssetsEditor.CopyFromFolder}" Command="{Binding ImportFromFolderCommand}" Margin="0,0,4,4" IsEnabled="{Binding HasProject}"
                                    ToolTip="{loc:Tr AssetsEditor.CopyObjectsWithTheirSpritesFrom}" />
                            <Button Content="{loc:Tr AssetsEditor.ExportImages}" Command="{Binding ExportImagesCommand}" Margin="0,0,4,4" IsEnabled="{Binding HasSelection}"
                                    ToolTip="{loc:Tr AssetsEditor.SaveTheSelectedObjectsAsPNG}" />
                        </WrapPanel>
                        <Grid>
                            <ListBox x:Name="ObjectList" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" SelectionMode="Extended" SelectionChanged="OnObjectSelectionChanged"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     AutomationProperties.Name="{loc:Tr Common.Objects}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:EditorListItem}">
                                        <DockPanel Margin="0,1">
                                            <Border DockPanel.Dock="Left" Width="{Binding DataContext.ThumbnailSize, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    Height="{Binding DataContext.ThumbnailSize, RelativeSource={RelativeSource AncestorType=ListBox}}" Background="{DynamicResource App.Checkerboard}" CornerRadius="3" Margin="0,0,8,0">
                                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                            </Border>
                                            <TextBlock DockPanel.Dock="Right" Text="&#xE70F;" Style="{StaticResource Icon}" FontSize="11" Foreground="{DynamicResource App.Accent}" ToolTip="{loc:Tr AssetsEditor.ChangedNotSaved}"
                                                       Visibility="{Binding IsModified, Converter={StaticResource BoolToVisibility}}" VerticalAlignment="Center" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Id}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource App.TextSecondary}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Style="{StaticResource EmptyState}" Text="{loc:Tr AssetsEditor.OpenAnAssetsFolderOrThe}"
                                       Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                        </Grid>
                    </DockPanel>

                    <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Center" Background="Transparent" />

                    <!-- Preview, layout and sprites -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                            <Border Style="{StaticResource PreviewSurface}" Height="220" Cursor="Arrow" ToolTip="{loc:Tr Common.Preview}">
                                <Grid>
                                    <controls:AnimatedSprite Frames="{Binding PreviewFrames}" Delays="{Binding PreviewDelays}" Fit="True" Margin="10" AutomationProperties.Name="{loc:Tr AssetsEditor.ObjectPreview}" />
                                    <TextBlock Text="{Binding PreviewMessage}" Style="{StaticResource EmptyState}" Visibility="{Binding PreviewMessage, Converter={StaticResource NullToVisibility}}" />
                                </Grid>
                            </Border>
                            <WrapPanel Margin="0,8,0,8">
                                <TextBlock Text="{loc:Tr AssetsEditor.FrameGroup}" VerticalAlignment="Center" Margin="0,0,6,4" />
                                <ComboBox ItemsSource="{Binding FrameGroups}" SelectedItem="{Binding FrameGroup}" Width="60" Margin="0,0,14,4" AutomationProperties.Name="{loc:Tr AssetsEditor.FrameGroup}" />
                                <TextBlock Text="{loc:Tr AssetsEditor.Direction}" VerticalAlignment="Center" Margin="0,0,6,4" Visibility="{Binding IsOutfit, Converter={StaticResource BoolToVisibility}}" />
                                <ComboBox SelectedIndex="{Binding Direction}" Width="90" Margin="0,0,14,4" Visibility="{Binding IsOutfit, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{loc:Tr AssetsEditor.Direction}">
                                    <ComboBoxItem Content="{loc:Tr AssetsEditor.North}" />
                                    <ComboBoxItem Content="{loc:Tr AssetsEditor.East}" />
                                    <ComboBoxItem Content="{loc:Tr AssetsEditor.South}" />
                                    <ComboBoxItem Content="{loc:Tr AssetsEditor.West}" />
                                </ComboBox>
                                <CheckBox Content="{loc:Tr Common.Addon1}" IsChecked="{Binding Addon1}" Margin="0,0,10,4" Visibility="{Binding IsOutfit, Converter={StaticResource BoolToVisibility}}" VerticalAlignment="Center" />
                                <CheckBox Content="{loc:Tr Common.Addon2}" IsChecked="{Binding Addon2}" Margin="0,0,10,4" Visibility="{Binding IsOutfit, Converter={StaticResource BoolToVisibility}}" VerticalAlignment="Center" />
                            </WrapPanel>

                            <GroupBox Header="{loc:Tr AssetsEditor.SpriteLayoutOfThisFrameGroup}" Margin="0,0,0,10">
                                <StackPanel>
                                    <WrapPanel>
                                        <TextBlock Text="{loc:Tr Common.Layers}" VerticalAlignment="Center" Margin="0,0,4,4" />
                                        <TextBox Text="{Binding Layers}" Width="40" Margin="0,0,10,4" AutomationProperties.Name="{loc:Tr Common.Layers}" />
                                        <TextBlock Text="{loc:Tr AssetsEditor.PatternsX}" VerticalAlignment="Center" Margin="0,0,4,4" />
                                        <TextBox Text="{Binding PatternWidth}" Width="40" Margin="0,0,10,4" AutomationProperties.Name="{loc:Tr Common.PatternWidth}" />
                                        <TextBlock Text="Y" VerticalAlignment="Center" Margin="0,0,4,4" />
                                        <TextBox Text="{Binding PatternHeight}" Width="40" Margin="0,0,10,4" AutomationProperties.Name="{loc:Tr Common.PatternHeight}" />
                                        <TextBlock Text="Z" VerticalAlignment="Center" Margin="0,0,4,4" />
                                        <TextBox Text="{Binding PatternDepth}" Width="40" Margin="0,0,10,4" AutomationProperties.Name="{loc:Tr Common.PatternDepth}" />
                                        <TextBlock Text="{loc:Tr AssetsEditor.Phases}" VerticalAlignment="Center" Margin="0,0,4,4" />
                                        <TextBox Text="{Binding Phases}" Width="44" Margin="0,0,10,4" AutomationProperties.Name="{loc:Tr AssetsEditor.AnimationPhases}" />
                                        <Button Content="{loc:Tr AssetsEditor.Apply}" Command="{Binding ApplyLayoutCommand}" Margin="0,0,0,4"
                                                ToolTip="{loc:Tr AssetsEditor.ResizeTheSpriteListToLayers}" />
                                    </WrapPanel>
                                    <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                                               Text="{loc:Tr AssetsEditor.OutfitsPatternsXAreTheFour}" />
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="{loc:Tr Common.Sprites}">
                                <StackPanel>
                                    <ListBox ItemsSource="{Binding SpriteCells}" SelectedItem="{Binding SelectedCell}" MaxHeight="300" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             AutomationProperties.Name="{loc:Tr AssetsEditor.SpritesOfTheFrameGroup}">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:SpriteCell}">
                                                <StackPanel Width="76" ToolTip="{Binding Label}">
                                                    <Border Width="68" Height="68" Background="{DynamicResource App.Checkerboard}" CornerRadius="3">
                                                        <Image Source="{Binding Image}" Stretch="Uniform" MaxWidth="64" MaxHeight="64" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                                    </Border>
                                                    <TextBlock Text="{Binding IdText}" FontSize="11" HorizontalAlignment="Center" />
                                                    <TextBlock Text="{Binding Marker}" FontSize="10" Foreground="{DynamicResource App.Accent}" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Text="{Binding SpriteUses}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,6" />
                                    <WrapPanel>
                                        <Button Content="{loc:Tr AssetsEditor.NewImageForThisCell}" Command="{Binding NewImageForCellCommand}" Margin="0,0,4,4" ToolTip="{loc:Tr AssetsEditor.MakeANewSpriteFromAn}" />
                                        <Button Content="{loc:Tr AssetsEditor.ReplaceSpriteImage}" Command="{Binding ReplaceSpriteImageCommand}" Margin="0,0,4,4" ToolTip="{loc:Tr AssetsEditor.ChangeTheSpriteSImageEverywhere}" />
                                        <Button Content="{loc:Tr AssetsEditor.SetSpriteID}" Command="{Binding SetSpriteIdCommand}" Margin="0,0,4,4" ToolTip="{loc:Tr AssetsEditor.UseAnotherExistingSpriteOfThe}" />
                                        <Button Content="{loc:Tr AssetsEditor.SaveSprite}" Command="{Binding ExportSpriteCommand}" Margin="0,0,4,4" ToolTip="{loc:Tr AssetsEditor.SaveThisSpriteAsAPNG}" />
                                        <Button Content="{loc:Tr AssetsEditor.ImportSprites}" Command="{Binding ImportSpritesCommand}" Margin="0,0,4,4" ToolTip="{loc:Tr AssetsEditor.AddImagesAsNewSpritesThey}" />
                                    </WrapPanel>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>

                    <GridSplitter Grid.Column="3" Width="10" HorizontalAlignment="Center" Background="Transparent" />

                    <!-- Properties -->
                    <GroupBox Grid.Column="4" Header="{loc:Tr Common.Properties}">
                        <ListBox ItemsSource="{Binding Properties}" ItemTemplateSelector="{StaticResource PropertyTemplates}" HorizontalContentAlignment="Stretch"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AutomationProperties.Name="{loc:Tr AssetsEditor.ObjectProperties}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="Padding" Value="2,1" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter Margin="{TemplateBinding Padding}" />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="{loc:Tr AssetsEditor.SpriteSheets}">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="290" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Button Content="{loc:Tr AssetsEditor.FindSprite}" Command="{Binding FindSpriteCommand}" Margin="0,0,6,0" IsEnabled="{Binding HasProject}" />
                            <Button Content="{loc:Tr AssetsEditor.ImportSprites}" Command="{Binding ImportSpritesCommand}" Margin="0,0,6,0" IsEnabled="{Binding HasProject}" />
                            <Button Content="{loc:Tr AssetsEditor.SaveSheet}" Command="{Binding ExportSheetCommand}" ToolTip="{loc:Tr AssetsEditor.SaveTheShownSheetAsA}" />
                        </WrapPanel>
                        <ListView ItemsSource="{Binding Sheets}" SelectedItem="{Binding SelectedSheet}" View="{StaticResource SheetColumns}" VirtualizingPanel.IsVirtualizing="True"
                                  AutomationProperties.Name="{loc:Tr AssetsEditor.SpriteSheets}" />
                    </DockPanel>
                    <DockPanel Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" Text="{Binding SheetInfo}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <Border Style="{StaticResource PreviewSurface}" Cursor="Cross" HorizontalAlignment="Left" VerticalAlignment="Top" ToolTip="{loc:Tr AssetsEditor.ClickASpriteToSeeWhere}">
                            <Image x:Name="SheetView" Source="{Binding SheetImage}" Width="384" Height="384" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"
                                   MouseLeftButtonDown="OnSheetClick" AutomationProperties.Name="{loc:Tr AssetsEditor.SpriteSheet}" />
                        </Border>
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
