<UserControl x:Class="TibiaFoundry.App.Views.Pages.ComparePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TibiaFoundry.App.Controls"
             xmlns:vm="clr-namespace:TibiaFoundry.App.ViewModels"
             xmlns:cmp="clr-namespace:TibiaFoundry.Core.Compare;assembly=TibiaFoundry.Core"
             xmlns:loc="clr-namespace:TibiaFoundry.App.Localization">
    <Grid Margin="16,14,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Panel}" Padding="12,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="{loc:Tr Compare.OldFile}" Style="{StaticResource FieldLabel}" Width="70" />
                        <Button DockPanel.Dock="Right" Content="{loc:Tr Common.Browse}" Command="{Binding BrowseOldCommand}" Margin="8,0,0,0" ToolTip="{loc:Tr Compare.ChooseTheOlderFile}" />
                        <TextBox Text="{Binding OldFile, UpdateSourceTrigger=PropertyChanged}" controls:Input.Placeholder="{loc:Tr Compare.EGAnOlderAppearancesDat}" FontFamily="{StaticResource App.MonoFont}" FontSize="12" AutomationProperties.Name="{loc:Tr Compare.OldFile}" />
                    </DockPanel>
                    <DockPanel>
                        <TextBlock Text="{loc:Tr Compare.NewFile}" Style="{StaticResource FieldLabel}" Width="70" />
                        <Button DockPanel.Dock="Right" Content="{loc:Tr Common.Browse}" Command="{Binding BrowseNewCommand}" Margin="8,0,0,0" ToolTip="{loc:Tr Compare.ChooseTheNewerFileOfThe}" />
                        <TextBox Text="{Binding NewFile, UpdateSourceTrigger=PropertyChanged}" controls:Input.Placeholder="{loc:Tr Compare.TheNewerFileOfTheSame}" FontFamily="{StaticResource App.MonoFont}" FontSize="12" AutomationProperties.Name="{loc:Tr Compare.NewFile}" />
                    </DockPanel>
                    <WrapPanel Margin="70,10,0,0">
                        <CheckBox Content="{loc:Tr Compare.IgnoreSpriteIDChanges}" IsChecked="{Binding IgnoreSpriteIds}" VerticalAlignment="Center" Margin="0,0,16,0"
                                  ToolTip="{loc:Tr Compare.SpriteIDsChangeWithAlmostEvery}" />
                        <Button Style="{StaticResource SubtleButton}" Command="{Binding SwapCommand}" ToolTip="{loc:Tr Compare.SwapTheOldAndTheNew}" AutomationProperties.Name="{loc:Tr Compare.SwapFiles}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8AB;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0" /><TextBlock Text="{loc:Tr Compare.Swap}" /></StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Top" MinWidth="150">
                    <Button Content="{loc:Tr Compare.CompareFiles}" Style="{StaticResource PrimaryButton}" Command="{Binding CompareFilesCommand}" Margin="0,0,0,6"
                            ToolTip="{loc:Tr Compare.CompareTheTwoSelectedFiles}" />
                    <Button Content="{loc:Tr Compare.CompareFolders}" Command="{Binding CompareFoldersCommand}" Margin="0,0,0,6"
                            ToolTip="{loc:Tr Compare.CompareEveryDataFileInTwo}" />
                    <Button Content="{loc:Tr Common.SaveReport}" Command="{Binding SaveReportCommand}" IsEnabled="{Binding HasResult}" ToolTip="{loc:Tr Compare.SaveTheComparisonResultAsA}" />
                    <Button Content="{loc:Tr Compare.VisualGallery}" Command="{Binding VisualGalleryCommand}" Margin="0,6,0,0"
                            ToolTip="{loc:Tr Compare.ContentStudioImagesOfEveryObject}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" MinWidth="180" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="260" MinWidth="180" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="{loc:Tr Common.Categories}">
                <Grid>
                    <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" AutomationProperties.Name="{loc:Tr Common.Categories}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type cmp:CompareCategory}">
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock FontSize="11" Foreground="{DynamicResource App.TextSecondary}">
                                        <Run Text="{Binding Changed.Count, Mode=OneWay}" /> <Run Text="{loc:Tr Compare.Changed}" />
                                        <Run Text="{Binding Added.Count, Mode=OneWay}" /> <Run Text="{loc:Tr Compare.New}" />
                                        <Run Text="{Binding Removed.Count, Mode=OneWay}" /> <Run Text="{loc:Tr Compare.Removed}" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Style="{StaticResource EmptyState}" Margin="12" IsHitTestVisible="False"
                               Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"
                               Text="{loc:Tr Compare.PickAnOldAndANew}" />
                </Grid>
            </GroupBox>

            <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" />

            <GroupBox Grid.Column="2" Header="{loc:Tr Compare.Entries}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                               Text="{loc:Tr Compare.DoubleClickAnAppearanceToOpen}"
                               Visibility="{Binding SelectedCategory.AppearanceKind, Converter={StaticResource NullToVisibility}, FallbackValue=Collapsed}" />
                    <ListView x:Name="EntryList" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}" MouseDoubleClick="OnEntryDoubleClick"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="{loc:Tr Compare.ChangedEntries}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="{loc:Tr Compare.IDKey}" Width="120" DisplayMemberBinding="{Binding Key}" />
                                <GridViewColumn Header="{loc:Tr Common.State}" Width="100">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:CompareEntry}">
                                            <Border x:Name="Badge" CornerRadius="8" Padding="8,1" HorizontalAlignment="Left" Background="{DynamicResource App.AccentSoft}">
                                                <TextBlock x:Name="BadgeText" Text="{Binding State}" FontSize="11" Foreground="{DynamicResource App.Link}" />
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="New">
                                                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource App.SuccessSoft}" />
                                                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource App.Success}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Removed">
                                                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource App.DangerSoft}" />
                                                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource App.Danger}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </GroupBox>

            <GridSplitter Grid.Column="3" Width="10" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" />

            <GroupBox Grid.Column="4" Header="{loc:Tr Common.Changes}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Notes}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="{Binding Notes, Converter={StaticResource NullToVisibility}}" />
                    <TextBox Text="{Binding ChangesText, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource App.MonoFont}" FontSize="12"
                             TextWrapping="NoWrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{loc:Tr Common.Changes}" />
                </DockPanel>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>
