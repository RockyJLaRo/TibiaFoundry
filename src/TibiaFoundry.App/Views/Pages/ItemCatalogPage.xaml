<UserControl x:Class="TibiaFoundry.App.Views.Pages.ItemCatalogPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TibiaFoundry.App.Controls"
             xmlns:vm="clr-namespace:TibiaFoundry.App.ViewModels"
             xmlns:loc="clr-namespace:TibiaFoundry.App.Localization">
    <Grid Margin="16,14,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Catalog, imports and exports -->
        <Border Style="{StaticResource Panel}" Padding="12,10" Margin="0,0,0,12">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="{loc:Tr ItemCatalog.Catalog}" Style="{StaticResource FieldLabel}" Width="70" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                        <Button Content="{loc:Tr ItemCatalog.NewCatalog}" Command="{Binding NewCatalogCommand}" ToolTip="{loc:Tr ItemCatalog.CreateAnEmptyCatalogForExample}" />
                        <Button Content="{loc:Tr ItemCatalog.OpenAnother}" Command="{Binding OpenOtherCatalogCommand}" Margin="6,0,0,0" ToolTip="{loc:Tr ItemCatalog.OpenACatalogInAnotherFolder}" />
                        <Button Style="{StaticResource SubtleButton}" Command="{Binding OpenCatalogFolderCommand}" Margin="6,0,0,0" ToolTip="{loc:Tr ItemCatalog.OpenTheCatalogSFolder}" AutomationProperties.Name="{loc:Tr ItemCatalog.OpenTheCatalogFolder}">
                            <TextBlock Text="&#xE838;" Style="{StaticResource Icon}" FontSize="13" />
                        </Button>
                    </StackPanel>
                    <ComboBox ItemsSource="{Binding Catalogs}" SelectedItem="{Binding SelectedCatalog}" DisplayMemberPath="Name" MinWidth="240" HorizontalAlignment="Left"
                              AutomationProperties.Name="{loc:Tr ItemCatalog.Catalog}" ToolTip="{Binding CatalogsFolder}" />
                </DockPanel>
                <WrapPanel Margin="0,8,0,0">
                    <TextBlock Text="{loc:Tr ItemCatalog.Import}" Style="{StaticResource FieldLabel}" Width="70" VerticalAlignment="Center" />
                    <Button Content="{loc:Tr ItemCatalog.ClientData}" Style="{StaticResource PrimaryButton}" Command="{Binding ImportClientCommand}" Margin="0,0,6,4"
                            ToolTip="{loc:Tr ItemCatalog.EveryObjectOfTheClientIn}" />
                    <Button Content="{loc:Tr ItemCatalog.TibiaWikiItemIDs}" Command="{Binding ImportTibiaWikiCommand}" Margin="0,0,6,4"
                            ToolTip="{loc:Tr ItemCatalog.TibiaWikiSItemIDsListObject}" />
                    <Button Content="{loc:Tr ItemCatalog.FromAFile}" Command="{Binding ImportFileCommand}" Margin="0,0,18,4"
                            ToolTip="{loc:Tr ItemCatalog.AListOfIdNameLines}" />
                    <TextBlock Text="{loc:Tr Common.Export}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,4" />
                    <ComboBox ItemsSource="{Binding ExportScopes}" SelectedItem="{Binding ExportScope}" DisplayMemberPath="Label" Width="250" Margin="0,0,6,4"
                              AutomationProperties.Name="{loc:Tr ItemCatalog.WhatToExport}" />
                    <Button Content="{loc:Tr ItemCatalog.NameList}" Command="{Binding ExportNameListCommand}" Margin="0,0,6,4"
                            ToolTip="{loc:Tr ItemCatalog.IdNameLinesWithAHeader}" />
                    <Button Content="CSV" Command="{Binding ExportCsvCommand}" Margin="0,0,6,4" ToolTip="{loc:Tr ItemCatalog.OneRowPerIdentifierTheSettled}" />
                    <Button Content="{loc:Tr ItemCatalog.RecordsCSV}" Command="{Binding ExportRecordsCommand}" Margin="0,0,6,4" ToolTip="{loc:Tr ItemCatalog.OneRowPerRecordWithIts}" />
                    <Button Content="{loc:Tr ItemCatalog.XLSX}" Command="{Binding ExportXlsxCommand}" Margin="0,0,6,4" ToolTip="{loc:Tr ItemCatalog.AnExcelWorkbookWithTheItems}" />
                    <Button Content="JSON" Command="{Binding ExportJsonCommand}" Margin="0,0,0,4" ToolTip="{loc:Tr ItemCatalog.TheSelectedIdentifiersWithEveryRecord}" />
                </WrapPanel>
                <TextBlock Text="{Binding CatalogSummary}" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" Padding="0,10,0,0">
            <TabItem Header="{loc:Tr Common.Items}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="420" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="380" MinWidth="240" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Panel}" Padding="10">
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBox Width="300" Margin="0,0,8,6" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}" AutomationProperties.Name="{loc:Tr Common.Search}"
                                         controls:Input.Placeholder="{loc:Tr ItemCatalog.IDRange100200ExactName}"
                                         ToolTip="{loc:Tr ItemCatalog.AnID3031AnIDRange}" />
                                <ComboBox ItemsSource="{Binding AgreementFilters}" SelectedItem="{Binding AgreementFilter}" DisplayMemberPath="Label" Width="140" Margin="0,0,8,6"
                                          AutomationProperties.Name="{loc:Tr ItemCatalog.Agreement}" ToolTip="{loc:Tr ItemCatalog.HowSureTheNameIs}" />
                                <ComboBox ItemsSource="{Binding SourceFilters}" SelectedItem="{Binding SourceFilter}" DisplayMemberPath="Label" Width="210" Margin="0,0,8,6"
                                          AutomationProperties.Name="{loc:Tr Common.Source}" ToolTip="{loc:Tr ItemCatalog.OnlyIdentifiersWithOrWithoutA}" />
                                <ComboBox ItemsSource="{Binding SortOrders}" SelectedItem="{Binding SortOrder}" DisplayMemberPath="Label" Width="120" Margin="0,0,8,6"
                                          AutomationProperties.Name="{loc:Tr Common.Sort}" />
                                <CheckBox Content="{loc:Tr ItemCatalog.NotNamedByTheClient}" IsChecked="{Binding OnlyUnnamedInClient}" Margin="0,0,12,6" VerticalAlignment="Center"
                                          ToolTip="{loc:Tr ItemCatalog.ObjectsTheClientListsWithoutA}" />
                                <CheckBox Content="{loc:Tr ItemCatalog.DifferingNames}" IsChecked="{Binding OnlyDisagreements}" Margin="0,0,0,6" VerticalAlignment="Center"
                                          ToolTip="{loc:Tr ItemCatalog.IdentifiersWhoseSourcesGiveDifferentNames}" />
                            </WrapPanel>
                            <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" Foreground="{DynamicResource App.TextSecondary}" FontSize="12">
                                <Run Text="{Binding VisibleCount, Mode=OneWay, Converter={StaticResource Number}}" /> <Run Text="{loc:Tr Common.Of}" />
                                <Run Text="{Binding TotalCount, Mode=OneWay, Converter={StaticResource Number}}" /> <Run Text="{loc:Tr ItemCatalog.Identifiers}" />
                            </TextBlock>
                            <Grid>
                                <ListView ItemsSource="{Binding VisibleRows}" SelectedItem="{Binding SelectedRow}" AutomationProperties.Name="{loc:Tr Common.Items}"
                                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ListView.InputBindings>
                                        <KeyBinding Key="F2" Command="{Binding BeginRenameCommand}" />
                                    </ListView.InputBindings>
                                    <ListView.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{loc:Tr Common.Rename}" InputGestureText="F2" Command="{Binding BeginRenameCommand}"
                                                      ToolTip="{loc:Tr ItemCatalog.ANameOfYourOwnFor}" />
                                            <MenuItem Header="{loc:Tr ItemCatalog.RestoreOriginalName}" Command="{Binding WithdrawDecisionCommand}"
                                                      ToolTip="{loc:Tr ItemCatalog.RemoveYourNameTheIdentifierSettles}" />
                                        </ContextMenu>
                                    </ListView.ContextMenu>
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="ID" Width="70" DisplayMemberBinding="{Binding Id}" />
                                            <GridViewColumn Header="{loc:Tr Common.Name}" Width="220">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate DataType="{x:Type vm:CatalogEntryRow}">
                                                        <Grid>
                                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ToolTip}"
                                                                       Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                                                <TextBlock.InputBindings>
                                                                    <MouseBinding Gesture="LeftDoubleClick" CommandParameter="{Binding}"
                                                                                  Command="{Binding DataContext.BeginRenameCommand, RelativeSource={RelativeSource AncestorType=ListView}}" />
                                                                </TextBlock.InputBindings>
                                                            </TextBlock>
                                                            <!-- Renaming in place: Enter or ✓ saves, Esc, ✕ or clicking elsewhere cancels (the buttons take no focus, so clicking them does not count as leaving). -->
                                                            <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}" MinWidth="180">
                                                                <DockPanel>
                                                                    <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Focusable="False" Content="✕" Padding="5,0" Margin="2,0,0,0"
                                                                            Command="{Binding DataContext.CancelRenameCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="button"
                                                                            ToolTip="{loc:Tr ItemCatalog.CancelEsc}" AutomationProperties.Name="{loc:Tr ItemCatalog.CancelTheRename}" />
                                                                    <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Focusable="False" Content="✓" Padding="5,0" Margin="2,0,0,0"
                                                                            Command="{Binding DataContext.CommitRenameCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                                            ToolTip="{loc:Tr ItemCatalog.SaveTheNameEnter}" AutomationProperties.Name="{loc:Tr ItemCatalog.SaveTheName}" />
                                                                    <TextBox Text="{Binding DataContext.EditText, RelativeSource={RelativeSource AncestorType=ListView}, UpdateSourceTrigger=PropertyChanged}"
                                                                             MaxLength="200" AutomationProperties.Name="{loc:Tr ItemCatalog.NewName}" controls:Input.FocusWhenVisible="True"
                                                                             controls:Input.LostFocusCommand="{Binding DataContext.CancelRenameCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                                             ToolTip="{loc:Tr ItemCatalog.WithAOrAnInFront}">
                                                                        <TextBox.InputBindings>
                                                                            <KeyBinding Key="Enter" Command="{Binding DataContext.CommitRenameCommand, RelativeSource={RelativeSource AncestorType=ListView}}" />
                                                                            <KeyBinding Key="Escape" CommandParameter="key"
                                                                                        Command="{Binding DataContext.CancelRenameCommand, RelativeSource={RelativeSource AncestorType=ListView}}" />
                                                                        </TextBox.InputBindings>
                                                                    </TextBox>
                                                                </DockPanel>
                                                                <TextBlock Text="{Binding DataContext.EditProblem, RelativeSource={RelativeSource AncestorType=ListView}}" Foreground="{DynamicResource App.Danger}"
                                                                           FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                                                                           Visibility="{Binding DataContext.EditProblem, RelativeSource={RelativeSource AncestorType=ListView}, Converter={StaticResource NullToVisibility}}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="{loc:Tr ItemCatalog.Agreement}" Width="110" DisplayMemberBinding="{Binding AgreementText}" />
                                            <GridViewColumn Header="{loc:Tr ItemCatalog.ClientName}" Width="190" DisplayMemberBinding="{Binding ClientName}" />
                                            <GridViewColumn Header="{loc:Tr ItemCatalog.OtherNames}" Width="220">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate DataType="{x:Type vm:CatalogEntryRow}">
                                                        <TextBlock Text="{Binding OtherNames}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ToolTip}" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="{loc:Tr Common.Category}" Width="130" DisplayMemberBinding="{Binding Category}" />
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                                <TextBlock Style="{StaticResource EmptyState}" Visibility="{Binding HasCatalog, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"
                                           Text="{loc:Tr ItemCatalog.NoCatalogIsOpenClickNew}" />
                            </Grid>
                        </DockPanel>
                    </Border>

                    <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" />

                    <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="12,10">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{Binding DetailsTitle}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8" Visibility="{Binding SelectedRow, Converter={StaticResource NullToVisibility}}">
                                <Button Content="{loc:Tr Common.Rename}" Command="{Binding DecideOtherNameCommand}" Margin="0,0,6,0"
                                        ToolTip="{loc:Tr ItemCatalog.ANameOfYourOwnFor2}" />
                                <Button Content="{loc:Tr ItemCatalog.RestoreOriginalName}" Command="{Binding WithdrawDecisionCommand}"
                                        Visibility="{Binding CanWithdrawDecision, Converter={StaticResource BoolToVisibility}}"
                                        ToolTip="{loc:Tr ItemCatalog.RemoveYourNameTheIdentifierSettles}" />
                            </WrapPanel>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Visibility="{Binding SelectedRow, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}"
                                       Text="{loc:Tr ItemCatalog.SelectAnIdentifierToSeeEvery}" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                <ItemsControl ItemsSource="{Binding Details}" AutomationProperties.Name="{loc:Tr ItemCatalog.RecordsOfTheSelectedIdentifier}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ObservationRow}">
                                            <Border BorderBrush="{DynamicResource App.GridLine}" BorderThickness="0,0,0,1" Padding="0,6">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource App.TextSecondary}" Margin="8,0,0,0" />
                                                        <TextBlock FontWeight="SemiBold" TextWrapping="Wrap">
                                                            <Run Text="{Binding Source, Mode=OneWay}" /> <Run Text="{Binding Trust, Mode=OneWay, StringFormat='({0})'}" FontWeight="Normal" Foreground="{DynamicResource App.TextSecondary}" />
                                                        </TextBlock>
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                    <TextBlock Text="{Binding Details}" FontSize="11" Foreground="{DynamicResource App.TextSecondary}" TextWrapping="Wrap"
                                                               Visibility="{Binding Details, Converter={StaticResource NullToVisibility}}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding MappingText}" FontSize="11" Foreground="{DynamicResource App.TextSecondary}" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Visibility="{Binding MappingText, Converter={StaticResource NullToVisibility}}" />

                                <!-- Conflict review: choosing a name records a decision of its own; no source is changed. -->
                                <StackPanel Margin="0,12,0,0" Visibility="{Binding NameChoices.Count, Converter={StaticResource NullToVisibility}}" AutomationProperties.Name="{loc:Tr ItemCatalog.ChooseAName}">
                                    <TextBlock Text="{loc:Tr ItemCatalog.TheSourcesDisagree}" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,6"
                                               Text="{loc:Tr ItemCatalog.ChooseTheNameThisCatalogShould}" />
                                    <ItemsControl ItemsSource="{Binding NameChoices}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:NameChoiceRow}">
                                                <DockPanel Margin="0,0,0,6">
                                                    <Button DockPanel.Dock="Right" Content="{loc:Tr ItemCatalog.UseThisName}" Command="{Binding ChooseCommand}" IsEnabled="{Binding CanChoose}" Margin="8,0,0,0" VerticalAlignment="Top" />
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Sources}" FontSize="11" Foreground="{DynamicResource App.TextSecondary}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{loc:Tr ItemCatalog.YourDecision}" FontSize="11" Foreground="{DynamicResource App.Success}" Visibility="{Binding IsDecision, Converter={StaticResource BoolToVisibility}}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="{loc:Tr Common.Compare}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Panel}" Padding="12,10" Margin="0,0,0,10">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="{loc:Tr Common.Compare}" Style="{StaticResource FieldLabel}" Width="80" />
                                <ComboBox ItemsSource="{Binding LeftChoices}" SelectedItem="{Binding LeftChoice}" DisplayMemberPath="Label" Width="300" HorizontalAlignment="Left"
                                          AutomationProperties.Name="{loc:Tr ItemCatalog.CompareWhatOfTheOpenCatalog}" ToolTip="{loc:Tr ItemCatalog.ASourceOfTheOpenCatalog}" />
                            </DockPanel>
                            <WrapPanel Margin="0,0,0,6">
                                <TextBlock Text="{loc:Tr ItemCatalog.With}" Style="{StaticResource FieldLabel}" Width="80" VerticalAlignment="Center" />
                                <ComboBox ItemsSource="{Binding Catalogs}" SelectedItem="{Binding RightCatalog}" DisplayMemberPath="Name" Width="240" Margin="0,0,8,0"
                                          AutomationProperties.Name="{loc:Tr ItemCatalog.CompareWithCatalog}" ToolTip="{loc:Tr ItemCatalog.TheOpenCatalogOrAnotherOne}" />
                                <ComboBox ItemsSource="{Binding RightChoices}" SelectedItem="{Binding RightChoice}" DisplayMemberPath="Label" Width="300"
                                          AutomationProperties.Name="{loc:Tr ItemCatalog.CompareWithWhatOfThatCatalog}" />
                            </WrapPanel>
                            <WrapPanel>
                                <CheckBox Content="{loc:Tr ItemCatalog.TranslateItemsOtbIDsWithItems}" IsChecked="{Binding CompareUseMappings}" Margin="80,0,16,6" VerticalAlignment="Center"
                                          ToolTip="{loc:Tr ItemCatalog.ItemsOtbIDsAreComparedThrough}" />
                                <CheckBox Content="{loc:Tr ItemCatalog.TreatItemsOtbClientIDsAs}" IsChecked="{Binding CompareOtbAsObjects}" Margin="0,0,16,6" VerticalAlignment="Center"
                                          ToolTip="{loc:Tr ItemCatalog.AnAssumptionAnItemsOtbStates}" />
                                <Button Content="{loc:Tr Common.Compare}" Style="{StaticResource PrimaryButton}" Command="{Binding CompareCommand}" Margin="0,0,6,6" />
                                <Button Content="{loc:Tr ItemCatalog.SaveResult}" Command="{Binding ExportComparisonCommand}" Margin="0,0,0,6" ToolTip="{loc:Tr ItemCatalog.SaveTheDifferencesAsAnExcel}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <TextBox Grid.Row="1" Text="{Binding ComparisonSummary, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontSize="12" MaxHeight="140" Margin="0,0,0,8"
                             VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{loc:Tr ItemCatalog.ComparisonSummary}" Visibility="{Binding ComparisonSummary, Converter={StaticResource NullToVisibility}}" />
                    <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="10">
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Top" Content="{loc:Tr ItemCatalog.OnlyContainersDoorsTeleportsAndOther}" IsChecked="{Binding OnlyBehaviorSensitive}" Margin="0,0,0,8" />
                            <Grid>
                                <ListView ItemsSource="{Binding ComparisonRows}" AutomationProperties.Name="{loc:Tr ItemCatalog.Differences}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="{loc:Tr ItemCatalog.Change}" Width="120" DisplayMemberBinding="{Binding Kind}" />
                                            <GridViewColumn Header="ID" Width="110" DisplayMemberBinding="{Binding Id}" />
                                            <GridViewColumn Header="{loc:Tr ItemCatalog.Left}" Width="240" DisplayMemberBinding="{Binding Left}" />
                                            <GridViewColumn Header="{loc:Tr ItemCatalog.Right}" Width="240" DisplayMemberBinding="{Binding Right}" />
                                            <GridViewColumn Header="{loc:Tr ItemCatalog.Sensitive}" Width="70" DisplayMemberBinding="{Binding Sensitive}" />
                                            <GridViewColumn Header="{loc:Tr Common.Note}" Width="200" DisplayMemberBinding="{Binding Note}" />
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                                <TextBlock Style="{StaticResource EmptyState}" Visibility="{Binding ComparisonSummary, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}"
                                           Text="{loc:Tr ItemCatalog.ChooseWhatToCompareTwoSources}" />
                            </Grid>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="{loc:Tr ItemCatalog.SourcesAndCoverage}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="1100" HorizontalAlignment="Left">
                        <GroupBox Header="{loc:Tr ItemCatalog.Sources}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                                           Text="{loc:Tr ItemCatalog.EachSourceKeepsItsOwnRecords}" />
                                <ItemsControl ItemsSource="{Binding Sources}" AutomationProperties.Name="{loc:Tr ItemCatalog.Sources}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:CatalogSourceRow}">
                                            <Border BorderBrush="{DynamicResource App.GridLine}" BorderThickness="0,0,0,1" Padding="0,6">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Content="{loc:Tr ItemCatalog.Remove}" Command="{Binding RemoveCommand}" VerticalAlignment="Center" Margin="8,0,0,0"
                                                            Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibility}}"
                                                            ToolTip="{loc:Tr ItemCatalog.RemoveThisSourceAndItsRecords}" />
                                                    <StackPanel>
                                                        <TextBlock FontWeight="SemiBold">
                                                            <Run Text="{Binding Name, Mode=OneWay}" /> <Run Text="{Binding Trust, Mode=OneWay, StringFormat='({0})'}" FontWeight="Normal" Foreground="{DynamicResource App.TextSecondary}" />
                                                        </TextBlock>
                                                        <TextBlock FontSize="12" Foreground="{DynamicResource App.TextSecondary}" TextWrapping="Wrap">
                                                            <Run Text="{Binding Records, Mode=OneWay}" /> <Run Text="{loc:Tr ItemCatalog.RecordsImported}" /> <Run Text="{Binding Imported, Mode=OneWay}" />
                                                            <Run Text="{loc:Tr ItemCatalog.Version}" /> <Run Text="{Binding Version, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding IdTypeText}" FontSize="11" Foreground="{DynamicResource App.TextSecondary}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Origin}" FontSize="11" FontFamily="{StaticResource App.MonoFont}" Foreground="{DynamicResource App.TextSecondary}"
                                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Origin}" Visibility="{Binding Origin, Converter={StaticResource NullToVisibility}}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource Muted}" Text="{loc:Tr ItemCatalog.NoSourcesYet}" Margin="0,4,0,0"
                                           Visibility="{Binding Sources.Count, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="{loc:Tr ItemCatalog.Coverage}" Margin="0,0,0,12">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Content="{loc:Tr ItemCatalog.ComputeCoverage}" Command="{Binding ComputeCoverageCommand}"
                                            ToolTip="{loc:Tr ItemCatalog.CountWhatTheCatalogCoversPer}" />
                                    <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                                               Text="{loc:Tr ItemCatalog.CompletenessIsStatedRelativeToThe}" />
                                </DockPanel>
                                <TextBox Text="{Binding Coverage, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="{StaticResource App.MonoFont}" FontSize="12"
                                         MinHeight="80" AutomationProperties.Name="{loc:Tr ItemCatalog.Coverage}" Visibility="{Binding Coverage, Converter={StaticResource NullToVisibility}}" />
                            </StackPanel>
                        </GroupBox>

                        <Expander Header="{loc:Tr ItemCatalog.LastImportPreview}" Visibility="{Binding LastPreview, Converter={StaticResource NullToVisibility}}">
                            <TextBox Text="{Binding LastPreview, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="{StaticResource App.MonoFont}" FontSize="12" Margin="0,6,0,0"
                                     AutomationProperties.Name="{loc:Tr ItemCatalog.LastImportPreview}" />
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
