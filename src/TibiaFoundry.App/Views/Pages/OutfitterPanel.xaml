<UserControl x:Class="TibiaFoundry.App.Views.Pages.OutfitterPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TibiaFoundry.App.ViewModels"
             xmlns:img="clr-namespace:TibiaFoundry.Core.Imaging;assembly=TibiaFoundry.Core"
             xmlns:controls="clr-namespace:TibiaFoundry.App.Controls"
             xmlns:loc="clr-namespace:TibiaFoundry.App.Localization">
    <UserControl.Resources>
        <Style x:Key="Arrow" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <TextBlock Style="{StaticResource EmptyState}" Text="{Binding OutfitTitle}" Visibility="{Binding HasOutfit, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding HasOutfit, Converter={StaticResource BoolToVisibility}}">
            <WrapPanel>
                <!-- preview with facing arrows -->
                <Border Style="{StaticResource Panel}" Margin="0,0,12,12" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{Binding OutfitTitle}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                        <Grid HorizontalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="1" Style="{StaticResource Arrow}" Command="{Binding FaceCommand}" CommandParameter="{x:Static img:Direction.North}" ToolTip="{loc:Tr Outfitter.FaceNorth}" AutomationProperties.Name="{loc:Tr Outfitter.FaceNorth}" Margin="0,0,0,6">
                                <TextBlock Text="&#xE70E;" Style="{StaticResource Icon}" />
                            </Button>
                            <Button Grid.Row="1" Style="{StaticResource Arrow}" Command="{Binding FaceCommand}" CommandParameter="{x:Static img:Direction.West}" ToolTip="{loc:Tr Outfitter.FaceWest}" AutomationProperties.Name="{loc:Tr Outfitter.FaceWest}" Margin="0,0,6,0">
                                <TextBlock Text="&#xE76B;" Style="{StaticResource Icon}" />
                            </Button>
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource PreviewSurface}" Tag="{Binding Background}" Width="196" Height="196"
                                    MouseLeftButtonUp="OnPreviewClicked" AutomationProperties.Name="{loc:Tr Outfitter.OutfitPreview}">
                                <Grid>
                                    <controls:AnimatedSprite Frames="{Binding Frames}" Delays="{Binding Delays}" Zoom="3" Fit="True" Margin="4" />
                                    <TextBlock Text="{Binding Message}" Style="{StaticResource EmptyState}" FontSize="11" Margin="6" />
                                </Grid>
                            </Border>
                            <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource Arrow}" Command="{Binding FaceCommand}" CommandParameter="{x:Static img:Direction.East}" ToolTip="{loc:Tr Outfitter.FaceEast}" AutomationProperties.Name="{loc:Tr Outfitter.FaceEast}" Margin="6,0,0,0">
                                <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" />
                            </Button>
                            <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource Arrow}" Command="{Binding FaceCommand}" CommandParameter="{x:Static img:Direction.South}" ToolTip="{loc:Tr Outfitter.FaceSouth}" AutomationProperties.Name="{loc:Tr Outfitter.FaceSouth}" Margin="0,6,0,0">
                                <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" />
                            </Button>
                        </Grid>
                        <TextBlock HorizontalAlignment="Center" Margin="0,6,0,0" Foreground="{DynamicResource App.TextSecondary}" FontSize="12">
                            <Run Text="{loc:Tr Common.Facing}" /> <Run Text="{Binding Facing, Mode=OneWay}" />
                        </TextBlock>
                        <Button Content="{loc:Tr Outfitter.SaveAsGIF}" Style="{StaticResource PrimaryButton}" Command="{Binding SaveGifCommand}" HorizontalAlignment="Stretch" Margin="0,10,0,0" ToolTip="{loc:Tr Outfitter.SaveTheOutfitAsShownIn}" />
                    </StackPanel>
                </Border>

                <!-- options -->
                <StackPanel Width="440">
                    <GroupBox Header="{loc:Tr Outfitter.Pose}">
                        <WrapPanel>
                            <StackPanel Margin="0,0,28,0">
                                <TextBlock Text="{loc:Tr Common.Movement}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <RadioButton Content="{loc:Tr Common.Idle}" GroupName="Mov" IsChecked="{Binding Moving, Converter={StaticResource InverseBool}}" />
                                <RadioButton Content="{loc:Tr Common.Moving}" GroupName="Mov" IsChecked="{Binding Moving}" IsEnabled="{Binding CanMove}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,28,0">
                                <TextBlock Text="{loc:Tr Outfitter.Mount}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <RadioButton Content="{loc:Tr Outfitter.Walking}" GroupName="Mnt" IsChecked="{Binding Mounted, Converter={StaticResource InverseBool}}" />
                                <RadioButton Content="{loc:Tr Outfitter.Mounted}" GroupName="Mnt" IsChecked="{Binding Mounted}" IsEnabled="{Binding CanMount}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{loc:Tr Outfitter.Addons}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <CheckBox Content="{loc:Tr Common.Addon1}" IsChecked="{Binding Addon1}" IsEnabled="{Binding HasAddons}" />
                                <CheckBox Content="{loc:Tr Common.Addon2}" IsChecked="{Binding Addon2}" IsEnabled="{Binding HasAddons}" />
                            </StackPanel>
                        </WrapPanel>
                    </GroupBox>
                    <GroupBox Header="{loc:Tr Outfitter.MountCreature}">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="{loc:Tr Outfitter.DrawMount}" IsChecked="{Binding UseMount}" Margin="0,0,14,0" VerticalAlignment="Center"
                                      ToolTip="{loc:Tr Outfitter.DrawTheMountWithTheOutfit}" />
                            <TextBlock Text="{loc:Tr Outfitter.MountOutfitID}" Style="{StaticResource FieldLabel}" />
                            <controls:NumericUpDown Value="{Binding MountId}" Minimum="0" Maximum="100000" Width="96" AutomationProperties.Name="{loc:Tr Outfitter.MountOutfitID}" />
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="{loc:Tr Outfitter.Colors}">
                        <StackPanel>
                            <WrapPanel Margin="0,0,0,10">
                                <Border Style="{StaticResource SegmentHost}" Margin="0,0,12,6">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource SegmentRadio}" Content="{loc:Tr Outfitter.Outfit}" GroupName="ColTarget" IsChecked="{Binding EditMountColors, Converter={StaticResource InverseBool}}" />
                                        <RadioButton Style="{StaticResource SegmentRadio}" Content="{loc:Tr Outfitter.Mount}" GroupName="ColTarget" IsChecked="{Binding EditMountColors}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SegmentHost}" Margin="0,0,12,6">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource SegmentRadio}" GroupName="ColPart" IsChecked="{Binding Part, Converter={StaticResource EnumEquals}, ConverterParameter=Head}">
                                            <StackPanel Orientation="Horizontal"><Border Width="10" Height="10" CornerRadius="2" Background="{Binding HeadBrush}" Margin="0,0,5,0" /><TextBlock Text="{loc:Tr Outfitter.Head}" /></StackPanel>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource SegmentRadio}" GroupName="ColPart" IsChecked="{Binding Part, Converter={StaticResource EnumEquals}, ConverterParameter=Primary}">
                                            <StackPanel Orientation="Horizontal"><Border Width="10" Height="10" CornerRadius="2" Background="{Binding PrimaryBrush}" Margin="0,0,5,0" /><TextBlock Text="{loc:Tr Outfitter.Primary}" /></StackPanel>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource SegmentRadio}" GroupName="ColPart" IsChecked="{Binding Part, Converter={StaticResource EnumEquals}, ConverterParameter=Secondary}">
                                            <StackPanel Orientation="Horizontal"><Border Width="10" Height="10" CornerRadius="2" Background="{Binding SecondaryBrush}" Margin="0,0,5,0" /><TextBlock Text="{loc:Tr Outfitter.Secondary}" /></StackPanel>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource SegmentRadio}" GroupName="ColPart" IsChecked="{Binding Part, Converter={StaticResource EnumEquals}, ConverterParameter=Detail}">
                                            <StackPanel Orientation="Horizontal"><Border Width="10" Height="10" CornerRadius="2" Background="{Binding DetailBrush}" Margin="0,0,5,0" /><TextBlock Text="{loc:Tr Outfitter.Detail}" /></StackPanel>
                                        </RadioButton>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                            <ListBox ItemsSource="{Binding Palette}" SelectedIndex="{Binding SelectedColorIndex}" Padding="4" Width="412" HorizontalAlignment="Left"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{loc:Tr Outfitter.ColorPalette}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Margin" Value="1" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="ToolTip" Value="{Binding Hex}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Ring" Width="20" Height="20" CornerRadius="4" BorderThickness="2" BorderBrush="Transparent">
                                                        <Border CornerRadius="2" Background="{Binding Brush}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource App.InputBorderHover}" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource App.Accent}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                            <Button Content="{loc:Tr Outfitter.DefaultColors}" Command="{Binding DefaultColorsCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" ToolTip="{loc:Tr Outfitter.ResetTheHeadPrimarySecondaryAnd}" />
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </WrapPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
