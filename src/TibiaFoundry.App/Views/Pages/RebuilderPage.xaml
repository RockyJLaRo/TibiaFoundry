<UserControl x:Class="TibiaFoundry.App.Views.Pages.RebuilderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:TibiaFoundry.App.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16,14,16,20" MaxWidth="1100" HorizontalAlignment="Left">
            <Border Style="{StaticResource Panel}" Padding="18,14" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                               Text="{loc:Tr Rebuilder.MakesANormalFolderFromAn}" />
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12"
                               Text="{loc:Tr Rebuilder.ARebuiltFolderHasEveryRecorded}" />
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding Empty}" Foreground="{DynamicResource App.Warning}" TextWrapping="Wrap" Margin="0,0,0,10"
                       Visibility="{Binding Empty, Converter={StaticResource NullToVisibility}}" />

            <TextBlock Text="{loc:Tr Rebuilder.1ChooseARevision}" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
            <Border Style="{StaticResource Panel}" Padding="0" Margin="0,0,0,8">
                <ListView ItemsSource="{Binding Revisions}" SelectedItem="{Binding Selected}" MinHeight="90" MaxHeight="300" BorderThickness="0" AutomationProperties.Name="{loc:Tr Common.ArchivedRevisions}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="{loc:Tr Common.Name}" Width="220" DisplayMemberBinding="{Binding Label}" />
                            <GridViewColumn Header="{loc:Tr Common.Server}" Width="90" DisplayMemberBinding="{Binding Server}" />
                            <GridViewColumn Header="{loc:Tr Common.Version}" Width="120" DisplayMemberBinding="{Binding Version}" />
                            <GridViewColumn Header="{loc:Tr Rebuilder.What}" Width="140" DisplayMemberBinding="{Binding Kind}" />
                            <GridViewColumn Header="{loc:Tr Rebuilder.Completeness}" Width="210" DisplayMemberBinding="{Binding Completeness}" />
                            <GridViewColumn Header="{loc:Tr Common.Files}" Width="70" DisplayMemberBinding="{Binding Files}" />
                            <GridViewColumn Header="{loc:Tr Common.Size}" Width="80" DisplayMemberBinding="{Binding Size}" />
                            <GridViewColumn Header="{loc:Tr Common.Archived}" Width="130" DisplayMemberBinding="{Binding Archived}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>
            <TextBlock Text="{Binding Details}" TextWrapping="Wrap" Margin="0,0,0,14" />

            <TextBlock Text="{loc:Tr Rebuilder.2ChooseTheOutputFolder}" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
            <DockPanel Margin="0,0,0,6">
                <Button DockPanel.Dock="Right" Content="{loc:Tr Rebuilder.Choose}" Command="{Binding ChooseOutputCommand}" Margin="8,0,0,0" />
                <TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:Tr Common.OutputFolder}" />
            </DockPanel>
            <TextBlock Text="{Binding PlanText}" TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,0,0,14" />

            <TextBlock Text="{loc:Tr Rebuilder.3Start}" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding RebuildCommand}" Margin="0,0,8,0">
                    <Button.Content>
                        <PriorityBinding>
                            <Binding Path="Selected.Kind" />
                            <Binding Source="{x:Static loc:LocalizedStrings.Instance}" Path="[Rebuilder.Rebuild]" Mode="OneWay" />
                        </PriorityBinding>
                    </Button.Content>
                </Button>
                <Button Content="{loc:Tr Rebuilder.OpenTheResult}" Command="{Binding OpenOutputCommand}" Margin="0,0,8,0" Visibility="{Binding LastOutput, Converter={StaticResource NullToVisibility}}" />
                <Button Content="{loc:Tr Rebuilder.Refresh}" Command="{Binding RefreshCommand}" />
            </StackPanel>

            <GroupBox Header="{loc:Tr Rebuilder.LastReport}" Visibility="{Binding Report, Converter={StaticResource NullToVisibility}}">
                <TextBox Text="{Binding Report, Mode=OneWay}" Style="{StaticResource ValueText}" FontFamily="Consolas" FontSize="12" />
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
