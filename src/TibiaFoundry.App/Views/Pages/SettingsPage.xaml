<UserControl x:Class="TibiaFoundry.App.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TibiaFoundry.App.ViewModels"
             xmlns:loc="clr-namespace:TibiaFoundry.App.Localization">
    <UserControl.Resources>
        <Style x:Key="RowLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
            <Setter Property="Width" Value="190" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="LastChildFill" Value="True" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="190,-4,0,10" />
        </Style>
        <Style x:Key="Warn" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource App.Warning}" />
            <Setter Property="Margin" Value="190,-6,0,8" />
        </Style>
        <Style x:Key="SectionReset" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Padding" Value="8,2" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Categories: selecting one scrolls to it. -->
        <Border BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,1,0" Padding="10,14,10,14">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{loc:Tr Common.Categories}" Style="{StaticResource FieldLabel}" Margin="6,0,0,8" />
                <ListBox ItemsSource="{Binding Categories}" loc:Choice.Prefix="Choice.SettingsCategory" SelectedItem="{Binding SelectedCategory}" SelectionChanged="OnCategorySelected" Background="Transparent" BorderThickness="0"
                         AutomationProperties.Name="{loc:Tr Settings.SettingsCategories}" />
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="Scroller" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="Sections" Margin="16,14,16,20" MaxWidth="940" HorizontalAlignment="Left">

                <!-- ============================================================ General -->
                <GroupBox Header="{loc:Tr Settings.General}" Tag="General" Margin="0,0,0,14">
                    <StackPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="{loc:Tr Settings.StartPage}" Style="{StaticResource RowLabel}" />
                            <CheckBox Content="{loc:Tr Settings.ThePageUsedLast}" IsChecked="{Binding StartWithLastPage}" VerticalAlignment="Center" Margin="0,0,14,0" />
                            <ComboBox ItemsSource="{Binding StartPages}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding StartPageName}" Width="220" HorizontalAlignment="Left"
                                      IsEnabled="{Binding StartWithLastPage, Converter={StaticResource InverseBool}}" AutomationProperties.Name="{loc:Tr Settings.FixedStartPage}" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="{loc:Tr Settings.ThePageTibiaFoundryOpensOn}" />
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="{loc:Tr Settings.Folders}" Style="{StaticResource RowLabel}" />
                            <CheckBox Content="{loc:Tr Settings.RememberTheFoldersLastUsedWith}" IsChecked="{Binding RememberLastFolders}" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="{loc:Tr Settings.FileAndFolderPickersStartWhere}" />
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="{loc:Tr Settings.PreviousSession}" Style="{StaticResource RowLabel}" />
                            <CheckBox Content="{loc:Tr Settings.ReopenTheFileAndFolderThe}" IsChecked="{Binding ReopenLastFiles}" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="{loc:Tr Settings.TheRCCEditorAndTheAssets}" />
                        <StackPanel Orientation="Horizontal" Margin="190,0,0,0">
                            <Button Content="{loc:Tr Settings.ExportSettings}" Command="{Binding ExportSettingsCommand}" Margin="0,0,8,0" ToolTip="{loc:Tr Settings.SaveAllSettingsToAFile}" />
                            <Button Content="{loc:Tr Settings.ImportSettings}" Command="{Binding ImportSettingsCommand}" Margin="0,0,8,0" ToolTip="{loc:Tr Settings.ReplaceTheSettingsWithThoseOf}" />
                            <Button Content="{loc:Tr Settings.ForgetRememberedFolders}" Command="{Binding ForgetFoldersCommand}" ToolTip="{loc:Tr Settings.ClearTheListOfFoldersAnd}" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- ============================================================ Appearance & Themes -->
                <GroupBox Header="{loc:Tr Settings.AppearanceThemes}" Tag="Appearance &amp; Themes" Margin="0,0,0,14" DataContext="{Binding}">
                    <StackPanel>
                        <!-- Theme list: choosing one applies it at once. -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="290" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ListBox ItemsSource="{Binding Themes.Themes}" SelectedItem="{Binding Themes.SelectedTheme}" Height="190" AutomationProperties.Name="{loc:Tr Settings.Themes}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ThemeEntry}">
                                        <DockPanel Margin="2,3">
                                            <TextBlock DockPanel.Dock="Left" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="12" Width="20" Foreground="{DynamicResource App.Success}"
                                                       Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" ToolTip="{loc:Tr Settings.ActiveTheme}" />
                                            <TextBlock DockPanel.Dock="Left" Width="20" Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock FontSize="11" Foreground="{DynamicResource App.TextSecondary}" TextTrimming="CharacterEllipsis"><Run Text="{Binding Badge, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Description, Mode=OneWay}" /></TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                <TextBlock FontWeight="SemiBold" FontSize="14"><Run Text="{loc:Tr Settings.ActiveTheme2}" /><Run Text="{Binding Themes.ActiveThemeName, Mode=OneWay}" /></TextBlock>
                                <TextBlock Text="{Binding Themes.ActiveThemeSummary}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,10" />
                                <WrapPanel>
                                    <Button Content="{loc:Tr Settings.NewTheme}" Command="{Binding Themes.NewThemeCommand}" Margin="0,0,6,6"
                                            ToolTip="{loc:Tr Settings.MakeACustomThemeFromThe}" />
                                    <Button Content="{loc:Tr Common.Rename}" Command="{Binding Themes.RenameThemeCommand}" Margin="0,0,6,6" IsEnabled="{Binding Themes.CanEdit}" />
                                    <Button Content="{loc:Tr Common.Delete}" Command="{Binding Themes.DeleteThemeCommand}" Margin="0,0,6,6" IsEnabled="{Binding Themes.CanEdit}"
                                            ToolTip="{loc:Tr Settings.DeleteTheActiveCustomThemeBuilt}" />
                                    <Button Content="{loc:Tr Settings.Import}" Command="{Binding Themes.ImportThemeCommand}" Margin="0,0,6,6" ToolTip="{loc:Tr Settings.AddAThemeFromATftheme}" />
                                    <Button Content="{loc:Tr Common.Export2}" Command="{Binding Themes.ExportThemeCommand}" Margin="0,0,6,6" IsEnabled="{Binding Themes.CanEdit}" />
                                </WrapPanel>
                                <WrapPanel Margin="0,4,0,0">
                                    <Button Content="{loc:Tr Settings.SaveTheme}" Style="{StaticResource PrimaryButton}" Command="{Binding Themes.SaveCommand}" Margin="0,0,6,6"
                                            ToolTip="{loc:Tr Settings.KeepTheColorChangesTheyAre}" />
                                    <Button Content="{loc:Tr Common.Revert}" Command="{Binding Themes.RevertCommand}" Margin="0,0,6,6" ToolTip="{loc:Tr Settings.DiscardUnsavedColorChanges}" />
                                    <Button Content="{loc:Tr Settings.RestoreOriginalAppearance}" Command="{Binding Themes.ResetAllCommand}" Margin="0,0,6,6"
                                            ToolTip="{loc:Tr Settings.MakeTheSystemThemeActiveAgain}" />
                                </WrapPanel>
                                <TextBlock Text="{loc:Tr Settings.UnsavedColorChangesTheyAreAlready}" Foreground="{DynamicResource App.Warning}"
                                           FontSize="12" TextWrapping="Wrap" Visibility="{Binding Themes.HasUnsavedChanges, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,-4,0,10"
                                   Text="{loc:Tr Settings.SystemFollowsTheWindowsAppMode}" />

                        <!-- Color editor (custom themes) -->
                        <Border Style="{StaticResource Panel}" Padding="10" Margin="0,0,0,12" Visibility="{Binding Themes.CanEdit, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="300" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Bottom" Content="{loc:Tr Settings.ShowAllColors}" IsChecked="{Binding Themes.ShowAllColors}" Margin="0,6,0,0"
                                              ToolTip="{loc:Tr Settings.AlsoListTheColorsThatNormally}" />
                                    <ListBox ItemsSource="{Binding Themes.ColorView}" SelectedItem="{Binding Themes.SelectedColor}" Height="330" AutomationProperties.Name="{loc:Tr Settings.ThemeColors}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.GroupStyle>
                                            <GroupStyle>
                                                <GroupStyle.HeaderTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Margin="4,8,0,2" Foreground="{DynamicResource App.TextSecondary}" Typography.Capitals="AllSmallCaps" />
                                                    </DataTemplate>
                                                </GroupStyle.HeaderTemplate>
                                            </GroupStyle>
                                        </ListBox.GroupStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:ThemeColorRow}">
                                                <DockPanel Margin="0,1" ToolTip="{Binding ToolTip}">
                                                    <Border DockPanel.Dock="Left" Width="18" Height="18" CornerRadius="3" Margin="0,0,8,0" Background="{Binding Swatch}"
                                                            BorderBrush="{DynamicResource App.BorderStrong}" BorderThickness="1" />
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding StateText}" FontSize="11" Foreground="{DynamicResource App.TextSecondary}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Hex}" FontFamily="{StaticResource App.MonoFont}" FontSize="11" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                    <TextBlock Text="{loc:Tr Settings.ChooseAColorOnTheLeft}" Style="{StaticResource Muted}" TextWrapping="Wrap"
                                               Visibility="{Binding Themes.HasSelectedColor, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                    <StackPanel Visibility="{Binding Themes.HasSelectedColor, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding Themes.SelectedColor.Label}" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="{Binding Themes.SelectedColor.Description}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,8" />
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Border Width="64" Height="40" CornerRadius="6" Background="{Binding Themes.EditSwatch}" BorderBrush="{DynamicResource App.BorderStrong}" BorderThickness="1"
                                                    ToolTip="{loc:Tr Settings.NewColor}" AutomationProperties.Name="{loc:Tr Settings.NewColor}" />
                                            <Border Width="32" Height="40" CornerRadius="6" Margin="6,0,0,0" Background="{Binding Themes.BaseSwatch}" BorderBrush="{DynamicResource App.BorderStrong}" BorderThickness="1"
                                                    AutomationProperties.Name="{loc:Tr Settings.ColorOfTheBasePalette}">
                                                <Border.ToolTip>
                                                    <TextBlock><Run Text="{loc:Tr Settings.BasePalette}" /><Run Text="{Binding Themes.BaseHex, Mode=OneWay}" /></TextBlock>
                                                </Border.ToolTip>
                                            </Border>
                                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                <DockPanel>
                                                    <TextBlock Text="{loc:Tr Settings.Hex}" Width="34" VerticalAlignment="Center" />
                                                    <TextBox Text="{Binding Themes.HexInput, UpdateSourceTrigger=PropertyChanged, Delay=250}" Width="110" FontFamily="{StaticResource App.MonoFont}"
                                                             AutomationProperties.Name="{loc:Tr Settings.HexadecimalColor}" ToolTip="{loc:Tr Settings.RRGGBBForExample2F6FDBAppliesAs}" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding Themes.HexProblem}" Foreground="{DynamicResource App.Danger}" FontSize="11" TextWrapping="Wrap" MaxWidth="320"
                                                           Visibility="{Binding Themes.HexProblem, Converter={StaticResource NullToVisibility}}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="{loc:Tr Settings.Hue}" Width="80" VerticalAlignment="Center" />
                                            <TextBlock DockPanel.Dock="Right" Width="48" TextAlignment="Right" VerticalAlignment="Center" Text="{Binding Themes.Hue, StringFormat={}{0:0}°}" />
                                            <Grid>
                                                <Border Height="8" CornerRadius="4" Background="{Binding Themes.HueGradient}" Margin="6,0" />
                                                <Slider Minimum="0" Maximum="359" Value="{Binding Themes.Hue}" SmallChange="1" LargeChange="10" AutomationProperties.Name="{loc:Tr Settings.Hue}" />
                                            </Grid>
                                        </DockPanel>
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="{loc:Tr Settings.Saturation}" Width="80" VerticalAlignment="Center" />
                                            <TextBlock DockPanel.Dock="Right" Width="48" TextAlignment="Right" VerticalAlignment="Center" Text="{Binding Themes.Saturation, StringFormat={}{0:0} %}" />
                                            <Grid>
                                                <Border Height="8" CornerRadius="4" Background="{Binding Themes.SaturationGradient}" Margin="6,0" />
                                                <Slider Minimum="0" Maximum="100" Value="{Binding Themes.Saturation}" SmallChange="1" LargeChange="5" AutomationProperties.Name="{loc:Tr Settings.Saturation}" />
                                            </Grid>
                                        </DockPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock Text="{loc:Tr Settings.Lightness}" Width="80" VerticalAlignment="Center" />
                                            <TextBlock DockPanel.Dock="Right" Width="48" TextAlignment="Right" VerticalAlignment="Center" Text="{Binding Themes.Lightness, StringFormat={}{0:0} %}" />
                                            <Grid>
                                                <Border Height="8" CornerRadius="4" Background="{Binding Themes.LightnessGradient}" Margin="6,0" />
                                                <Slider Minimum="0" Maximum="100" Value="{Binding Themes.Lightness}" SmallChange="1" LargeChange="5" AutomationProperties.Name="{loc:Tr Settings.Lightness}" />
                                            </Grid>
                                        </DockPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Button Content="{loc:Tr Settings.ResetThisColor}" Command="{Binding Themes.ResetColorCommand}" Margin="0,0,6,0"
                                                    ToolTip="{loc:Tr Settings.BackToTheBasePaletteS}" />
                                            <Button Content="{loc:Tr Settings.ResetAllColors}" Command="{Binding Themes.ResetThemeCommand}" ToolTip="{loc:Tr Settings.EveryColorOfThisThemeBack}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Readability -->
                                    <TextBlock Text="{loc:Tr Settings.Readability}" FontWeight="SemiBold" Margin="0,4,0,4" />
                                    <TextBlock Text="{loc:Tr Settings.NoReadabilityProblemsTextControlsAnd}" Foreground="{DynamicResource App.Success}" FontSize="12" TextWrapping="Wrap"
                                               Visibility="{Binding Themes.HasWarnings, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                    <ItemsControl ItemsSource="{Binding Themes.Warnings}" AutomationProperties.Name="{loc:Tr Settings.ReadabilityWarnings}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,0,0,2">
                                                    <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource App.Warning}" Margin="0,2,6,0" VerticalAlignment="Top" />
                                                    <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Live preview: real controls styled by the active palette. -->
                        <GroupBox Header="{loc:Tr Common.Preview}" Margin="0,0,0,12" AutomationProperties.Name="{loc:Tr Settings.ThemePreview}">
                            <WrapPanel>
                                <StackPanel Width="260" Margin="0,0,16,8">
                                    <TextBlock Text="{loc:Tr Settings.PrimaryTextOnAPanel}" />
                                    <TextBlock Text="{loc:Tr Settings.SecondaryTextAndHints}" Foreground="{DynamicResource App.TextSecondary}" />
                                    <TextBlock Text="{loc:Tr Settings.DisabledText}" Foreground="{DynamicResource App.TextDisabled}" />
                                    <TextBlock><Hyperlink ToolTip="{loc:Tr Settings.LinksLookLikeThisThisOne}"><Run Text="{loc:Tr Settings.ALink}" /></Hyperlink></TextBlock>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Content="{loc:Tr Settings.Button}" Margin="0,0,6,0" />
                                        <Button Content="{loc:Tr Settings.Accent}" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" />
                                        <Button Content="{loc:Tr Settings.Disabled}" IsEnabled="False" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Width="230" Margin="0,0,16,8">
                                    <TextBox Text="{loc:Tr Settings.InputText}" Margin="0,0,0,6" AutomationProperties.Name="{loc:Tr Settings.PreviewInput}" />
                                    <CheckBox Content="{loc:Tr Settings.CheckBox}" IsChecked="True" />
                                    <ListBox Height="58" Margin="0,4,0,0" SelectedIndex="1" AutomationProperties.Name="{loc:Tr Settings.PreviewList}">
                                        <ListBoxItem Content="{loc:Tr Settings.ListItem}" />
                                        <ListBoxItem Content="{loc:Tr Settings.SelectedItem}" />
                                    </ListBox>
                                </StackPanel>
                                <StackPanel Width="200" Margin="0,0,0,8">
                                    <Border Background="{DynamicResource App.SuccessSoft}" CornerRadius="{StaticResource App.Radius}" Padding="8,3" Margin="0,0,0,4">
                                        <TextBlock Text="{loc:Tr Settings.Success}" Foreground="{DynamicResource App.Success}" />
                                    </Border>
                                    <Border Background="{DynamicResource App.WarningSoft}" CornerRadius="{StaticResource App.Radius}" Padding="8,3" Margin="0,0,0,4">
                                        <TextBlock Text="{loc:Tr Settings.Warning}" Foreground="{DynamicResource App.Warning}" />
                                    </Border>
                                    <Border Background="{DynamicResource App.DangerSoft}" CornerRadius="{StaticResource App.Radius}" Padding="8,3" Margin="0,0,0,4">
                                        <TextBlock Text="{loc:Tr Settings.Error}" Foreground="{DynamicResource App.Danger}" />
                                    </Border>
                                    <ProgressBar Height="8" Value="60" Margin="0,4,0,0" AutomationProperties.Name="{loc:Tr Settings.PreviewProgress}" />
                                </StackPanel>
                            </WrapPanel>
                        </GroupBox>

                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="{loc:Tr Settings.InterfaceSize}" Style="{StaticResource RowLabel}" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding UiScaleText}" Width="54" VerticalAlignment="Center" Margin="10,0,0,0" />
                            <Slider Minimum="0.8" Maximum="1.5" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding UiScale, Delay=250}" Width="260" HorizontalAlignment="Left"
                                    AutomationProperties.Name="{loc:Tr Settings.InterfaceSize}" ToolTip="{loc:Tr Settings.ZoomOfTheWholeInterface}" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="{loc:Tr Settings.MakesTextControlsAndPreviewsLarger}" />
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="{loc:Tr Settings.NavigationBar}" Style="{StaticResource RowLabel}" />
                            <ComboBox ItemsSource="{Binding NavigationChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Navigation}" Width="320" HorizontalAlignment="Left"
                                      AutomationProperties.Name="{loc:Tr Settings.NavigationBar}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="{loc:Tr Settings.Window}" Style="{StaticResource RowLabel}" />
                            <CheckBox Content="{loc:Tr Settings.RememberSizePositionAndMaximizedState}" IsChecked="{Binding RememberWindowPlacement}" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="{loc:Tr Settings.Previews}" Style="{StaticResource RowLabel}" />
                            <CheckBox Content="{loc:Tr Settings.AnimatePreviews}" IsChecked="{Binding AnimatePreviews}" VerticalAlignment="Center" Margin="0,0,16,0"
                                      ToolTip="{loc:Tr Settings.WhenOffPreviewsShowTheirFirst}" />
                            <CheckBox Content="{loc:Tr Settings.ShowValuesThatAreAtTheir}" IsChecked="{Binding ShowDefaultValues}" VerticalAlignment="Center"
                                      ToolTip="{loc:Tr Settings.DataListsAppearancesStaticDataAlso}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="{loc:Tr Settings.EditorListThumbnails}" Style="{StaticResource RowLabel}" />
                            <ComboBox ItemsSource="{Binding ThumbnailSizes}" SelectedItem="{Binding ThumbnailSize}" Width="90" HorizontalAlignment="Left" AutomationProperties.Name="{loc:Tr Settings.ThumbnailSize}"
                                      ToolTip="{loc:Tr Settings.SizeOfThePicturesInThe}" />
                        </DockPanel>
                        <Button Style="{StaticResource SectionReset}" Content="{loc:Tr Settings.RestoreDefaultsForTheInterfaceOptions}" Command="{Binding ResetAppearanceCommand}"
                                ToolTip="{loc:Tr Settings.InterfaceSizeNavigationBarWindowAnd}" />
                    </StackPanel>
                </GroupBox>

                <!-- ============================================================ Tibia client -->
                <GroupBox Header="{loc:Tr Settings.TibiaClientAndDataLocations}" Tag="Tibia client" Margin="0,0,0,14">
                    <StackPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="{loc:Tr Common.Server}" Style="{StaticResource RowLabel}" />
                            <CheckBox Content="{loc:Tr Settings.UseTheTestServerClient}" IsChecked="{Binding UseTestServer}" VerticalAlignment="Center" ToolTip="{loc:Tr Settings.ReadTheFilesOfTheTest}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="{loc:Tr Settings.TestServerPackage}" Style="{StaticResource RowLabel}" />
                            <ComboBox IsEditable="True" ItemsSource="{Binding InstalledPackages}" Text="{Binding TestServerPackage, UpdateSourceTrigger=LostFocus}"
                                      Width="260" HorizontalAlignment="Left" AutomationProperties.Name="{loc:Tr Settings.TestServerPackage}" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="{loc:Tr Settings.NameOfTheTestServerClient}" />
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="{loc:Tr Settings.ClientStore}" Style="{StaticResource RowLabel}" VerticalAlignment="Top" />
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="{loc:Tr Settings.Clients}" Command="{Binding OpenClientsCommand}" Margin="8,0,0,0"
                                            ToolTip="{loc:Tr Settings.ClientFoldersArchivedRevisionsTheClient}" />
                                    <TextBlock Text="{Binding ClientStoreText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </DockPanel>
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="{loc:Tr Settings.NewArchives}" Style="{StaticResource RowLabel}" VerticalAlignment="Top" />
                            <StackPanel>
                                <ComboBox ItemsSource="{Binding StorageModes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ClientStorageMode}" Width="420" HorizontalAlignment="Left"
                                          AutomationProperties.Name="{loc:Tr Settings.HowNewArchivesAreKept}" ToolTip="{loc:Tr Settings.AppliesToArchivesMadeFromNow}" />
                                <CheckBox Content="{loc:Tr Settings.IncludePersonalDataHotkeysCharactersData}" IsChecked="{Binding ArchivePersonalData}" Margin="0,6,0,0"
                                          ToolTip="{loc:Tr Settings.LeftOutByDefaultAndListed}" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="{loc:Tr Settings.CheckAtStart}" Style="{StaticResource RowLabel}" VerticalAlignment="Top" />
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox Content="{loc:Tr Settings.DefaultLiveClient}" IsChecked="{Binding MonitorInstalledLive}" Margin="0,0,16,0" />
                                    <CheckBox Content="{loc:Tr Settings.DefaultTestClient}" IsChecked="{Binding MonitorInstalledTest}" />
                                </StackPanel>
                                <ComboBox ItemsSource="{Binding LaunchCheckChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ClientLaunchCheck}" Width="520" HorizontalAlignment="Left" Margin="0,6,0,0"
                                          AutomationProperties.Name="{loc:Tr Settings.HowTheInstalledClientIsChecked}" ToolTip="{loc:Tr Settings.InTheBackgroundAfterTheFirst}" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="{loc:Tr Settings.WhenItChanged}" Style="{StaticResource RowLabel}" />
                            <ComboBox ItemsSource="{Binding ChangeHandlingChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ClientChangeHandling}" Width="320" HorizontalAlignment="Left"
                                      AutomationProperties.Name="{loc:Tr Settings.WhenTheInstalledClientChanged}" ToolTip="{loc:Tr Settings.OnlyForContentThatIsNot}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="{loc:Tr Settings.AtStart}" Style="{StaticResource RowLabel}" VerticalAlignment="Top" />
                            <StackPanel>
                                <ComboBox ItemsSource="{Binding StartupModeChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding StartupClientMode}" Width="260" HorizontalAlignment="Left"
                                          AutomationProperties.Name="{loc:Tr Settings.WhichClientAtStart}" />
                                <DockPanel Margin="0,6,0,0">
                                    <Button DockPanel.Dock="Right" Content="{loc:Tr Common.Clear}" Command="{Binding ClearRememberedClientCommand}" Margin="6,0,0,0" ToolTip="{loc:Tr Settings.UseTheInstalledClientOfThis}" />
                                    <Button DockPanel.Dock="Right" Content="{loc:Tr Common.Change}" Command="{Binding SwitchClientCommand}" Margin="8,0,0,0" ToolTip="{loc:Tr Settings.ChooseAnotherClientNow}" />
                                    <TextBlock Text="{Binding RememberedClientText, Converter={StaticResource LocFormat}, ConverterParameter=Settings.RememberedClient0}" TextWrapping="Wrap" VerticalAlignment="Center" />
