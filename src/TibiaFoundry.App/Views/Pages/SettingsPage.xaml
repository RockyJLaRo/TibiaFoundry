                            <TextBlock Text="{loc:Tr Common.History}" Style="{StaticResource RowLabel}" />
                            <CheckBox Content="{loc:Tr Settings.KeepAHistoryOfRunsUp}" IsChecked="{Binding ScriptsKeepHistory}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox ItemsSource="{Binding HistorySizes}" SelectedItem="{Binding ScriptsMaxHistory}" Width="80" HorizontalAlignment="Left" AutomationProperties.Name="{loc:Tr Settings.HistorySize}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="{loc:Tr Settings.ScriptsAtTheSameTime}" Style="{StaticResource RowLabel}" />
                            <ComboBox ItemsSource="{Binding OperationLimits}" SelectedItem="{Binding ScriptsMaxConcurrent}" Width="70" HorizontalAlignment="Left" AutomationProperties.Name="{loc:Tr Settings.ScriptsAtTheSameTime}" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="{loc:Tr Settings.NeverMoreThanTheGeneralLimit}" />
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="{loc:Tr Settings.Options}" Style="{StaticResource RowLabel}" />
                            <CheckBox Content="{loc:Tr Settings.ShowAdvancedOptionsOfEveryScript}" IsChecked="{Binding ScriptsShowAdvanced}" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="{loc:Tr Settings.ScriptsAreBuiltIntoTibiaFoundry}" />
                        <Button Style="{StaticResource SectionReset}" Content="{loc:Tr Settings.RestoreDefaultsForScripts}" Command="{Binding ResetScriptsCommand}" />
                    </StackPanel>
                </GroupBox>

                <!-- ============================================================ Diagnostics -->
                <GroupBox Header="{loc:Tr Settings.Diagnostics}" Tag="Diagnostics" Margin="0,0,0,14">
                    <StackPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="{loc:Tr Common.Performance}" Style="{StaticResource RowLabel}" />
                            <CheckBox Content="{loc:Tr Settings.MeasureProcessorMemoryAndDiskSpace}" IsChecked="{Binding PerformanceMonitoring}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox ItemsSource="{Binding SampleIntervals}" SelectedItem="{Binding SampleIntervalSeconds}" Width="64" HorizontalAlignment="Left" AutomationProperties.Name="{loc:Tr Common.MeasurementIntervalInSeconds}" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="{loc:Tr Settings.SecondsBetweenMeasurementsNothingIsMeasured}" />
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="{loc:Tr Settings.OperationHistory}" Style="{StaticResource RowLabel}" />
                            <TextBlock Text="{loc:Tr Settings.KeepTheLast}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox ItemsSource="{Binding OperationHistorySizes}" SelectedItem="{Binding OperationHistoryEntries}" Width="80" Margin="0,0,6,0" AutomationProperties.Name="{loc:Tr Settings.OperationsKeptInTheHistory}" />
                            <TextBlock Text="{loc:Tr Settings.FinishedOperationsNamesDurationsAndCounts}" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="{loc:Tr Settings.DiagnosticsReports}" Style="{StaticResource RowLabel}" />
                            <TextBlock Text="{loc:Tr Settings.IncludeTheLogsOfTheLast}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox ItemsSource="{Binding ReportLogDayChoices}" SelectedItem="{Binding ReportLogDays}" Width="64" Margin="0,0,6,0" AutomationProperties.Name="{loc:Tr Settings.DaysOfLogsInAReport}" />
                            <TextBlock Text="{loc:Tr Settings.DayS}" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="{loc:Tr Settings.ReportsAreSavedInTheReports}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Left" Content="{loc:Tr Common.OpenDiagnostics}" Command="{Binding OpenDiagnosticsCommand}" Margin="190,0,0,0" />
                            <Button Style="{StaticResource SectionReset}" Content="{loc:Tr Settings.RestoreDefaultsForDiagnostics}" Command="{Binding ResetDiagnosticsCommand}" />
                        </DockPanel>
                    </StackPanel>
                </GroupBox>

                <!-- ============================================================ Advanced -->
                <GroupBox Header="{loc:Tr Settings.Advanced}" Tag="Advanced">
                    <StackPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="{loc:Tr Common.Storage}" Style="{StaticResource RowLabel}" />
                            <TextBlock Text="{Binding StorageMode}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="{loc:Tr Settings.SettingsFile}" Style="{StaticResource RowLabel}" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Command="{Binding OpenSettingsFolderCommand}" ToolTip="{loc:Tr Settings.OpenTheFolderThatContainsThe}" Margin="8,0,0,0" AutomationProperties.Name="{loc:Tr Settings.OpenSettingsFolder}">
                                <TextBlock Text="&#xE838;" Style="{StaticResource Icon}" FontSize="13" />
                            </Button>
                            <TextBox Style="{StaticResource PathBox}" Text="{Binding SettingsFile, Mode=OneWay}" AutomationProperties.Name="{loc:Tr Settings.SettingsFile}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="{loc:Tr Settings.LogFile}" Style="{StaticResource RowLabel}" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Command="{Binding OpenLogFolderCommand}" ToolTip="{loc:Tr Settings.OpenTheFolderThatContainsThe2}" Margin="8,0,0,0" AutomationProperties.Name="{loc:Tr Common.OpenLogFolder}">
                                <TextBlock Text="&#xE838;" Style="{StaticResource Icon}" FontSize="13" />
                            </Button>
                            <TextBox Style="{StaticResource PathBox}" Text="{Binding LogFile, Mode=OneWay, Converter={StaticResource LocOr}, ConverterParameter=Settings.LoggingDisabled}" AutomationProperties.Name="{loc:Tr Settings.LogFile}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="{loc:Tr Settings.MemoryAndStorage}" Style="{StaticResource RowLabel}" VerticalAlignment="Top" />
                            <StackPanel>
                                <TextBlock Text="{Binding StorageSummary}" TextWrapping="Wrap" />
                                <WrapPanel Margin="0,6,0,0">
                                    <Button Content="{loc:Tr Settings.ClearCaches}" Command="{Binding ClearCachesCommand}" Margin="0,0,6,6" ToolTip="{loc:Tr Settings.FreeTheMemoryOfDecodedSprites}" />
                                    <Button Content="{loc:Tr Settings.RemoveTemporaryFiles}" Command="{Binding CleanTempCommand}" Margin="0,0,6,6" ToolTip="{loc:Tr Settings.FoldersOfRunningOperationsAreKept}" />
                                    <Button Content="{loc:Tr Settings.OpenBackupFolder}" Command="{Binding OpenBackupFolderCommand}" Margin="0,0,6,6" />
                                    <Button Content="{loc:Tr Common.OpenDiagnostics}" Command="{Binding OpenDiagnosticsCommand}" Margin="0,0,6,6" ToolTip="{loc:Tr Settings.OperationsLogsSelfCheckAndDiagnostics}" />
                                </WrapPanel>
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="{loc:Tr Settings.ThisSession}" Style="{StaticResource RowLabel}" />
                            <CheckBox Content="{loc:Tr Settings.SaveSettingsChangesMadeInThis}" IsChecked="{Binding SaveSettingsThisSession}" VerticalAlignment="Center"
                                      ToolTip="{loc:Tr Settings.TurnThisOffToTryOptions}" />
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="190,4,0,0">
                            <Button Content="{loc:Tr Settings.ImportSettingsOfTheOriginal1}" Command="{Binding ImportLegacyCommand}" Margin="0,0,8,0"
                                    ToolTip="{loc:Tr Settings.ImportTheFoldersAndTheCreator}" />
                            <Button Content="{loc:Tr Settings.ResetAllSettings}" Command="{Binding ResetDefaultsCommand}" ToolTip="{loc:Tr Settings.ResetEveryCategoryExceptTheCreator}" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
