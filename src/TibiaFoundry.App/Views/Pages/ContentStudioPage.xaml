<UserControl x:Class="TibiaFoundry.App.Views.Pages.ContentStudioPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TibiaFoundry.App.Controls"
             xmlns:vm="clr-namespace:TibiaFoundry.App.ViewModels"
             xmlns:lib="clr-namespace:TibiaFoundry.Core.Library;assembly=TibiaFoundry.Core"
             xmlns:loc="clr-namespace:TibiaFoundry.App.Localization">
    <UserControl.Resources>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Margin" Value="0,0,2,0" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="16,14,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Background="{DynamicResource App.WarningSoft}" CornerRadius="6" Padding="12,8" Margin="0,0,0,10"
                Visibility="{Binding Problem, Converter={StaticResource NullToVisibility}}">
            <TextBlock Text="{Binding Problem}" TextWrapping="Wrap" />
        </Border>

        <TabControl Grid.Row="1" SelectedIndex="{Binding Tab}">
            <!-- ===================================================== Projects and workflow builder -->
            <TabItem Header="{loc:Tr ContentStudio.Projects}">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250" MinWidth="200" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" MinWidth="480" />
                    </Grid.ColumnDefinitions>

                    <!-- Project list -->
                    <Border Style="{StaticResource Panel}" Padding="10">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Button Content="{loc:Tr ContentStudio.NewProject}" Style="{StaticResource PrimaryButton}" Command="{Binding NewProjectCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                        ToolTip="{loc:Tr ContentStudio.CreatureGalleryOutfitGalleryItemCollection}" />
                                <Button Content="{loc:Tr ContentStudio.ImportWorkflow}" Command="{Binding ImportWorkflowCommand}" HorizontalAlignment="Stretch" ToolTip="{loc:Tr ContentStudio.OpenASharedWorkflowFileTfworkflow}" />
                            </StackPanel>
                            <Grid>
                                <ListBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" BorderThickness="0" AutomationProperties.Name="{loc:Tr ContentStudio.Projects}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type lib:ContentProject}">
                                            <StackPanel Margin="2,3">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Status}" FontSize="11.5" Foreground="{DynamicResource App.TextSecondary}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Style="{StaticResource EmptyState}" Margin="8" Visibility="{Binding HasProjects, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"
                                           Text="{loc:Tr ContentStudio.NoProjectsYetAProjectRemembers}" />
                            </Grid>
                        </DockPanel>
                    </Border>

                    <!-- Project editor -->
                    <Grid Grid.Column="2">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480"
                                    Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                            <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" FontSize="40" Foreground="{DynamicResource App.TextSecondary}" Opacity="0.7" Margin="0,0,0,10" />
                            <TextBlock Style="{StaticResource Muted}" TextAlignment="Center"
                                       Text="{loc:Tr ContentStudio.CreateAProjectToStartChoose}" />
                            <Button Content="{loc:Tr ContentStudio.NewProject}" Style="{StaticResource PrimaryButton}" Command="{Binding NewProjectCommand}" HorizontalAlignment="Center" Margin="0,14,0,0" />
                        </StackPanel>
                        <Grid Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Header: name, type, profile, output, actions -->
                            <Border Style="{StaticResource Panel}" Padding="14,12" Margin="0,0,0,10">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Top" Margin="12,0,0,0">
                                            <Button Content="{loc:Tr Common.Run}" Style="{StaticResource PrimaryButton}" Command="{Binding RunProjectCommand}" MinWidth="80" Margin="0,0,8,0"
                                                    ToolTip="{loc:Tr ContentStudio.SaveTheProjectAndRunIt}" />
                                            <Button Content="{loc:Tr Common.Save}" Command="{Binding SaveProjectCommand}" Margin="0,0,8,0" />
                                            <Button Content="{loc:Tr Common.OpenOutput}" Command="{Binding OpenOutputCommand}" />
                                        </WrapPanel>
                                        <StackPanel>
                                            <TextBox Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" FontSize="16" FontWeight="SemiBold" AutomationProperties.Name="{loc:Tr ContentStudio.ProjectName}" />
                                            <TextBlock Text="{Binding ProjectType}" Style="{StaticResource Muted}" FontSize="12" Margin="2,4,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{loc:Tr ContentStudio.PublishingProfile}" Style="{StaticResource Label}" />
                                            <ComboBox ItemsSource="{Binding ProfileChoices}" SelectedItem="{Binding ProjectProfile}" DisplayMemberPath="Name" AutomationProperties.Name="{loc:Tr ContentStudio.PublishingProfile}"
                                                      ToolTip="{loc:Tr ContentStudio.SizeFormatNamesFoldersManifestsAnd}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{loc:Tr ContentStudio.EachRun}" Style="{StaticResource Label}" />
                                            <ComboBox ItemsSource="{Binding OutputModes}" SelectedItem="{Binding ProjectOutputMode}" AutomationProperties.Name="{loc:Tr ContentStudio.OutputMode}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock>
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="{loc:Tr ContentStudio.WritesANewDatedFolder}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding}" Value="{x:Static lib:OutputMode.UpdateInPlace}">
                                                                            <Setter Property="Text" Value="{loc:Tr ContentStudio.UpdatesOneFolderInPlace}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                                            <Button Content="{loc:Tr ContentStudio.OutputFolder}" Command="{Binding BrowseOutputCommand}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding EffectiveOutput}">
                                        <Run Text="{loc:Tr ContentStudio.WritesTo}" /> <Run Text="{Binding EffectiveOutput, Mode=OneWay}" FontFamily="{StaticResource App.MonoFont}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding ValidationText}" Foreground="{DynamicResource App.Warning}" TextWrapping="Wrap" Margin="0,6,0,0"
                                               Visibility="{Binding ValidationText, Converter={StaticResource NullToVisibility}}" />
                                </StackPanel>
                            </Border>

                            <!-- Workflow builder: steps, step settings, picker, history -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.9*" MinWidth="260" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="1.1*" MinWidth="300" />
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource Panel}" Padding="0">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Top" Background="{DynamicResource App.CardHeader}" BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,0,1"
                                                CornerRadius="8,8,0,0" Padding="12,8">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                    <Button Style="{StaticResource IconButton}" Command="{Binding AddStepCommand}" ToolTip="{loc:Tr ContentStudio.AddAStep}" AutomationProperties.Name="{loc:Tr ContentStudio.AddAStep}">
                                                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12" />
                                                    </Button>
                                                    <Button Style="{StaticResource IconButton}" Command="{Binding MoveStepUpCommand}" ToolTip="{loc:Tr ContentStudio.MoveTheStepUp}" AutomationProperties.Name="{loc:Tr ContentStudio.MoveUp}">
                                                        <TextBlock Text="&#xE70E;" Style="{StaticResource Icon}" FontSize="12" />
                                                    </Button>
                                                    <Button Style="{StaticResource IconButton}" Command="{Binding MoveStepDownCommand}" ToolTip="{loc:Tr ContentStudio.MoveTheStepDown}" AutomationProperties.Name="{loc:Tr ContentStudio.MoveDown}">
                                                        <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="12" />
                                                    </Button>
                                                    <Button Style="{StaticResource IconButton}" Command="{Binding RemoveStepCommand}" ToolTip="{loc:Tr ContentStudio.RemoveTheStep}" AutomationProperties.Name="{loc:Tr ContentStudio.RemoveStep}">
                                                        <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="12" />
                                                    </Button>
                                                </StackPanel>
                                                <TextBlock Text="{loc:Tr ContentStudio.Workflow}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Border>
                                        <WrapPanel DockPanel.Dock="Bottom" Margin="10,8">
                                            <Button Content="{loc:Tr ContentStudio.SaveAsTemplate}" Command="{Binding SaveAsTemplateCommand}" Margin="0,0,6,6" />
                                            <Button Content="{loc:Tr ContentStudio.LoadTemplate}" Command="{Binding LoadTemplateCommand}" Margin="0,0,6,6" />
                                            <Button Content="{loc:Tr Common.Export2}" Command="{Binding ExportWorkflowCommand}" Margin="0,0,6,6" ToolTip="{loc:Tr ContentStudio.SaveTheStepsAsAFile}" />
                                            <Button Content="{loc:Tr ContentStudio.DuplicateProject}" Command="{Binding DuplicateProjectCommand}" Margin="0,0,6,6" />
                                            <Button Content="{loc:Tr ContentStudio.DeleteProject}" Command="{Binding DeleteProjectCommand}" Margin="0,0,6,6" />
                                        </WrapPanel>
                                        <ListBox ItemsSource="{Binding Steps}" SelectedItem="{Binding SelectedStep}" BorderThickness="0" Padding="6" AutomationProperties.Name="{loc:Tr ContentStudio.WorkflowSteps}"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:StepRow}">
                                                    <DockPanel Margin="2,4">
                                                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Enabled}" VerticalAlignment="Top" Margin="0,2,8,0" ToolTip="{loc:Tr ContentStudio.IncludeThisStep}"
                                                                  AutomationProperties.Name="{Binding Title}" />
                                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="14" Width="20" VerticalAlignment="Top" Margin="0,1,8,0"
                                                                   Foreground="{DynamicResource App.Accent}" />
                                                        <StackPanel>
                                                            <TextBlock>
                                                                <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" />
                                                                <Run Text="{Binding GroupName, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource App.TextSecondary}" />
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding Summary}" FontSize="11.5" Foreground="{DynamicResource App.TextSecondary}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>
                                </Border>

                                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                    <StackPanel>
                                        <GroupBox Header="{Binding SelectedStep.Title, FallbackValue=Step}" Visibility="{Binding SelectedStep, Converter={StaticResource NullToVisibility}}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding SelectedStep.Description}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,10" />
                                                <ItemsControl ItemsSource="{Binding SelectedStep.Parameters}" Focusable="False">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:StepParameterRow}">
                                                            <StackPanel Margin="0,0,0,10">
                                                                <TextBlock Text="{Binding Label}" Style="{StaticResource Label}"
                                                                           Visibility="{Binding IsBoolean, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Label}"
                                                                         Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}" />
                                                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" MaxHeight="180"
                                                                         VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{Binding Label}"
                                                                         Visibility="{Binding IsMultiline, Converter={StaticResource BoolToVisibility}}" />
                                                                <CheckBox Content="{Binding Label}" IsChecked="{Binding Flag}" Visibility="{Binding IsBoolean, Converter={StaticResource BoolToVisibility}}" />
                                                                <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Value}" AutomationProperties.Name="{Binding Label}"
                                                                          Visibility="{Binding IsChoice, Converter={StaticResource BoolToVisibility}}" />
                                                                <DockPanel Visibility="{Binding IsPath, Converter={StaticResource BoolToVisibility}}">
                                                                    <Button DockPanel.Dock="Right" Content="{loc:Tr Common.Browse}" Margin="6,0,0,0"
                                                                            Command="{Binding DataContext.BrowseParameterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Label}" />
                                                                </DockPanel>
                                                                <TextBlock Text="{Binding Help}" FontSize="11.5" Foreground="{DynamicResource App.TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                                           Visibility="{Binding Help, Converter={StaticResource NullToVisibility}}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Style="{StaticResource Muted}" FontSize="12" Text="{loc:Tr ContentStudio.ThisStepHasNoSettings}"
                                                           Visibility="{Binding SelectedStep.Parameters.Count, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}" />
                                            </StackPanel>
                                        </GroupBox>

                                        <GroupBox Header="{Binding PickerTitle}" Visibility="{Binding HasPicker, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel>
                                                <TextBox Text="{Binding PickerFilter, UpdateSourceTrigger=PropertyChanged, Delay=200}" controls:Input.Placeholder="{loc:Tr Common.FilterByNameOrID}" Margin="0,0,0,6"
                                                         AutomationProperties.Name="{loc:Tr ContentStudio.FilterTheList}" />
                                                <ListBox x:Name="Picker" ItemsSource="{Binding PickerItems}" SelectionMode="Extended" Height="200" SelectionChanged="OnPickerSelectionChanged"
                                                         AutomationProperties.Name="{loc:Tr ContentStudio.ChooseEntries}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:PickerItem}">
                                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                                <Button Content="{loc:Tr ContentStudio.AddTheSelectedEntries}" Command="{Binding AddPickedCommand}" HorizontalAlignment="Left" Margin="0,6,0,0"
                                                        ToolTip="{loc:Tr ContentStudio.CtrlClickAndShiftClickChoose}" />
                                            </StackPanel>
                                        </GroupBox>

                                        <GroupBox Header="{loc:Tr Common.Description}">
                                            <TextBox Text="{Binding ProjectDescription, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="50" MaxHeight="120"
                                                     VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{loc:Tr ContentStudio.ProjectDescription}" />
                                        </GroupBox>

                                        <GroupBox Header="{loc:Tr ContentStudio.Runs}">
                                            <StackPanel>
                                                <ItemsControl ItemsSource="{Binding History}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type lib:ProjectRun}">
                                                            <Border BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,0,1" Padding="0,5">
                                                                <DockPanel>
                                                                    <Button DockPanel.Dock="Right" Content="{loc:Tr Common.Open}" Style="{StaticResource SubtleButton}" Margin="8,0,0,0" VerticalAlignment="Top"
                                                                            Command="{Binding DataContext.OpenRunCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                                            Visibility="{Binding OutputFolder, Converter={StaticResource NullToVisibility}}" />
                                                                    <StackPanel>
                                                                        <TextBlock>
                                                                            <Run Text="{Binding Outcome, Mode=OneWay}" FontWeight="SemiBold" />
                                                                            <Run Text="{Binding StartedUtc, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Foreground="{DynamicResource App.TextSecondary}" />
                                                                            <Run Text="·" Foreground="{DynamicResource App.TextSecondary}" />
                                                                            <Run Text="{Binding Files, Mode=OneWay}" Foreground="{DynamicResource App.TextSecondary}" />
                                                                            <Run Text="{loc:Tr ContentStudio.Files}" Foreground="{DynamicResource App.TextSecondary}" />
                                                                            <Run Text="{Binding Seconds, Mode=OneWay, StringFormat={}{0:N1} s}" Foreground="{DynamicResource App.TextSecondary}" />
                                                                        </TextBlock>
                                                                        <ItemsControl ItemsSource="{Binding Problems}">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <TextBlock Text="{Binding}" FontSize="11.5" Foreground="{DynamicResource App.Warning}" TextWrapping="Wrap" />
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </StackPanel>
                                                                </DockPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Style="{StaticResource Muted}" FontSize="12" Text="{loc:Tr ContentStudio.NotRunYetEachRunIs}"
                                                           Visibility="{Binding History.Count, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}" />
                                            </StackPanel>
                                        </GroupBox>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ===================================================== Publishing profiles -->
            <TabItem Header="{loc:Tr ContentStudio.PublishingProfiles}">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250" MinWidth="200" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" MinWidth="460" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Panel}" Padding="10">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Button Content="{loc:Tr ContentStudio.NewProfile}" Style="{StaticResource PrimaryButton}" Command="{Binding NewProfileCommand}" HorizontalAlignment="Stretch" />
                                <TextBlock Style="{StaticResource Muted}" FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="{loc:Tr ContentStudio.EveryWebsiteWantsItsImagesDifferently}" />
                            </StackPanel>
                            <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" BorderThickness="0" AutomationProperties.Name="{loc:Tr ContentStudio.Profiles}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type lib:ExportProfile}">
                                        <StackPanel Margin="2,3">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Website}" FontSize="11.5" Foreground="{DynamicResource App.TextSecondary}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                                  Visibility="{Binding Profile, Converter={StaticResource NullToVisibility}}">
                        <StackPanel DataContext="{Binding Profile}">
                            <GroupBox Header="{loc:Tr Common.Website}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{loc:Tr ContentStudio.ProfileName}" Style="{StaticResource Label}" />
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:Tr ContentStudio.ProfileName}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{loc:Tr Common.Website}" Style="{StaticResource Label}" />
                                        <TextBox Text="{Binding Website, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:Tr Common.Website}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0">
                                        <TextBlock Text="{loc:Tr Common.Description}" Style="{StaticResource Label}" />
                                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AutomationProperties.Name="{loc:Tr Common.Description}" />
                                    </StackPanel>
                                </Grid>
                            </GroupBox>
                            <GroupBox Header="{loc:Tr Common.Images}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{loc:Tr Common.Format}" Style="{StaticResource Label}" />
                                        <ComboBox ItemsSource="{x:Static vm:ContentStudioViewModel.ImageFormats}" loc:Choice.Prefix="Choice.ImageFormat" SelectedItem="{Binding ImageFormat}"
                                                  AutomationProperties.Name="{loc:Tr Common.Format}" ToolTip="{loc:Tr ContentStudio.KeepStillImagesAsPNGAnimations}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{loc:Tr ContentStudio.Animations}" Style="{StaticResource Label}" />
                                        <ComboBox ItemsSource="{x:Static vm:ContentStudioViewModel.AnimatedChoices}" loc:Choice.Prefix="Choice.AnimatedOutput" SelectedItem="{Binding Animated}" AutomationProperties.Name="{loc:Tr ContentStudio.Animations}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="{loc:Tr ContentStudio.ScaleNearestNeighbor}" Style="{StaticResource Label}" />
                                        <controls:NumericUpDown Value="{Binding Scale}" Minimum="1" Maximum="8" AutomationProperties.Name="{loc:Tr ContentStudio.Scale}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Margin="0,8,0,0">
                                        <TextBlock Text="{loc:Tr ContentStudio.CanvasWidth0None}" Style="{StaticResource Label}" />
                                        <controls:NumericUpDown Value="{Binding CanvasWidth}" Minimum="0" Maximum="4096" AutomationProperties.Name="{loc:Tr ContentStudio.CanvasWidth}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,8,0,0">
                                        <TextBlock Text="{loc:Tr ContentStudio.CanvasHeight}" Style="{StaticResource Label}" />
                                        <controls:NumericUpDown Value="{Binding CanvasHeight}" Minimum="0" Maximum="4096" AutomationProperties.Name="{loc:Tr ContentStudio.CanvasHeight}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,8,0,0">
                                        <TextBlock Text="{loc:Tr ContentStudio.Padding}" Style="{StaticResource Label}" />
                                        <controls:NumericUpDown Value="{Binding Padding}" Minimum="0" Maximum="512" AutomationProperties.Name="{loc:Tr ContentStudio.Padding}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                                        <TextBlock Text="{loc:Tr Common.Background}" Style="{StaticResource Label}" />
                                        <TextBox Text="{Binding Background, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:Tr Common.Background}" ToolTip="{loc:Tr ContentStudio.TransparentOrAColorLikeFFFFFF}" />
                                    </StackPanel>
                                    <CheckBox Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3" Content="{loc:Tr ContentStudio.TrimTransparentBordersFirst}" IsChecked="{Binding TrimTransparent}" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                                </Grid>
                            </GroupBox>
                            <GroupBox Header="{loc:Tr ContentStudio.NamesAndFolders}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{loc:Tr ContentStudio.FileNameTemplate}" Style="{StaticResource Label}" />
                                            <TextBox Text="{Binding FileNameTemplate, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource App.MonoFont}" AutomationProperties.Name="{loc:Tr ContentStudio.FileNameTemplate}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{loc:Tr ContentStudio.FolderTemplate}" Style="{StaticResource Label}" />
                                            <TextBox Text="{Binding FolderTemplate, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource App.MonoFont}" AutomationProperties.Name="{loc:Tr ContentStudio.FolderTemplate}" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{loc:Tr ContentStudio.LetterCase}" Style="{StaticResource Label}" />
                                            <ComboBox ItemsSource="{x:Static vm:ContentStudioViewModel.CaseChoices}" loc:Choice.Prefix="Choice.NameCase" SelectedItem="{Binding Case}" AutomationProperties.Name="{loc:Tr ContentStudio.LetterCase}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{loc:Tr ContentStudio.ReplaceSpacesWithEmptyKeepSpaces}" Style="{StaticResource Label}" />
                                            <ComboBox ItemsSource="{x:Static vm:ContentStudioViewModel.SpaceChoices}" SelectedItem="{Binding SpaceReplacement}" AutomationProperties.Name="{loc:Tr ContentStudio.SpaceReplacement}" />
                                        </StackPanel>
                                    </Grid>
                                    <Border Style="{StaticResource InfoBanner}" Margin="0,10,0,0">
                                        <TextBlock Text="{Binding DataContext.ProfilePreview, RelativeSource={RelativeSource AncestorType=UserControl}}" TextWrapping="Wrap" FontFamily="{StaticResource App.MonoFont}" FontSize="12" />
                                    </Border>
                                    <TextBlock Text="{Binding DataContext.VariableHelp, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource Muted}" FontSize="11.5" Margin="0,8,0,0" />
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="{loc:Tr ContentStudio.ManifestsCreditsAndSnippets}">
                                <StackPanel>
                                    <WrapPanel Margin="0,0,0,8">
                                        <CheckBox Content="{loc:Tr ContentStudio.JSONManifest}" IsChecked="{Binding WriteJsonManifest}" Margin="0,0,16,4" />
                                        <CheckBox Content="{loc:Tr ContentStudio.CSVManifest}" IsChecked="{Binding WriteCsvManifest}" Margin="0,0,16,4" />
                                        <CheckBox Content="{loc:Tr ContentStudio.MarkdownIndex}" IsChecked="{Binding WriteMarkdownIndex}" Margin="0,0,16,4" />
                                        <CheckBox Content="{loc:Tr ContentStudio.HTMLGallery}" IsChecked="{Binding WriteGallery}" Margin="0,0,16,4" />
                                    </WrapPanel>
                                    <TextBlock Text="{loc:Tr ContentStudio.CreditLineManifestsGalleriesSnippets}" Style="{StaticResource Label}" />
                                    <TextBox Text="{Binding AttributionTemplate, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Margin="0,0,0,8" AutomationProperties.Name="{loc:Tr ContentStudio.CreditLine}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{loc:Tr ContentStudio.SnippetPerImageWikiMarkupHTML}" Style="{StaticResource Label}" />
                                            <TextBox Text="{Binding DocumentationTemplate, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource App.MonoFont}" TextWrapping="Wrap" AutomationProperties.Name="{loc:Tr ContentStudio.SnippetTemplate}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{loc:Tr ContentStudio.SnippetFile}" Style="{StaticResource Label}" />
                                            <TextBox Text="{Binding DocumentationFileName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:Tr ContentStudio.SnippetFileName}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Style="{StaticResource Muted}" FontSize="11.5" Margin="0,8,0,0" TextWrapping="Wrap"
                                               Text="{loc:Tr ContentStudio.TheCreatorAttributionIsAlwaysEmbedded}" />
                                </StackPanel>
                            </GroupBox>
                            <WrapPanel Margin="0,0,0,10">
                                <Button Content="{loc:Tr ContentStudio.SaveProfile}" Style="{StaticResource PrimaryButton}" Command="{Binding DataContext.SaveProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,0,8,0" />
                                <Button Command="{Binding DataContext.DeleteProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Content" Value="{loc:Tr ContentStudio.DeleteProfile}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BuiltIn}" Value="True">
                                                    <Setter Property="Content" Value="{loc:Tr ContentStudio.ResetToTheOriginal}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ===================================================== Queue -->
            <TabItem Header="{loc:Tr Common.Queue}">
                <DockPanel Margin="0,10,0,0">
                    <Border DockPanel.Dock="Top" Style="{StaticResource Panel}" Padding="12,10" Margin="0,0,0,10">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Tr ContentStudio.AtATime}" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding ConcurrencyChoices}" SelectedItem="{Binding QueueConcurrency}" Width="60" Margin="0,0,10,0" AutomationProperties.Name="{loc:Tr ContentStudio.JobsAtATime}" />
                                <Button Content="{loc:Tr ContentStudio.ClearFinished}" Command="{Binding ClearFinishedCommand}" />
                            </StackPanel>
                            <TextBlock Text="{Binding QueueSummary}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>
                    <Expander DockPanel.Dock="Bottom" Header="{loc:Tr ContentStudio.HistoryFinishedJobsNewestFirst}" Margin="0,10,0,0">
                        <ListView ItemsSource="{Binding QueueHistory}" MaxHeight="220" Margin="8" BorderThickness="0" controls:GridViewBehavior.FillLastColumn="True">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="{loc:Tr ContentStudio.Finished}" Width="140" DisplayMemberBinding="{Binding FinishedUtc, StringFormat=yyyy-MM-dd HH:mm:ss}" />
                                    <GridViewColumn Header="{loc:Tr ContentStudio.Job}" Width="220" DisplayMemberBinding="{Binding Title}" />
                                    <GridViewColumn Header="{loc:Tr Common.State}" Width="90" DisplayMemberBinding="{Binding State}" />
                                    <GridViewColumn Header="{loc:Tr Common.Result}" Width="300" DisplayMemberBinding="{Binding Result}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Expander>
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding QueueRows}" AutomationProperties.Name="{loc:Tr ContentStudio.Jobs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:QueueRow}">
                                        <Border Style="{StaticResource Panel}" Padding="12,10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock>
                                                        <Run Text="{Binding Job.Title, Mode=OneWay}" FontWeight="SemiBold" />
                                                        <Run Text="{Binding Job.Category, Mode=OneWay}" Foreground="{DynamicResource App.TextSecondary}" FontSize="12" />
                                                        <Run Text="{loc:Tr ContentStudio.Added}" Foreground="{DynamicResource App.TextSecondary}" FontSize="12" />
                                                        <Run Text="{Binding When, Mode=OneWay}" Foreground="{DynamicResource App.TextSecondary}" FontSize="12" />
                                                    </TextBlock>
                                                    <TextBlock FontSize="12" Margin="0,2,0,6" TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding Job.State, Mode=OneWay}" FontWeight="SemiBold" />
                                                        <Run Text="·" />
                                                        <Run Text="{Binding Job.Message, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <ProgressBar Height="6" Minimum="0" Maximum="1" Value="{Binding Job.Progress, Mode=OneWay}" Visibility="{Binding Job.CanCancel, Converter={StaticResource BoolToVisibility}}" />
                                                    <TextBlock Text="{Binding Job.Result}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource App.TextSecondary}"
                                                               Visibility="{Binding Job.Result, Converter={StaticResource NullToVisibility}}" />
                                                    <TextBlock Text="{Binding Job.Error}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource App.Danger}"
                                                               Visibility="{Binding Job.Error, Converter={StaticResource NullToVisibility}}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                                                    <Button Content="{loc:Tr Common.Cancel}" Margin="0,0,6,0" IsEnabled="{Binding Job.CanCancel}"
                                                            Command="{Binding DataContext.CancelJobCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                    <Button Content="{loc:Tr ContentStudio.Retry}" Margin="0,0,6,0" IsEnabled="{Binding Job.CanRetry}"
                                                            Command="{Binding DataContext.RetryJobCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                    <Button Content="{loc:Tr Common.Details}" Command="{Binding DataContext.JobDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Style="{StaticResource EmptyState}" Visibility="{Binding QueueRows.Count, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}"
                                   Text="{loc:Tr ContentStudio.TheQueueIsEmptyRunningA}" />
                    </Grid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
