<UserControl x:Class="TibiaFoundry.App.Views.Pages.ClientsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TibiaFoundry.App.Controls"
             xmlns:vm="clr-namespace:TibiaFoundry.App.ViewModels"
             xmlns:loc="clr-namespace:TibiaFoundry.App.Localization">
    <UserControl.Resources>
        <!-- A labeled value of the selected folder or revision; the labels share one width. -->
        <DataTemplate x:Key="FactRow" DataType="{x:Type vm:DetailFact}">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="FactLabel" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Foreground="{DynamicResource App.TextSecondary}" Margin="0,0,18,0" VerticalAlignment="Top" />
                <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" AutomationProperties.Name="{Binding Label}">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource ValueText}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPath}" Value="True">
                                    <Setter Property="FontFamily" Value="{StaticResource App.MonoFont}" />
                                    <Setter Property="FontSize" Value="12" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource App.Warning}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16,14,16,20" MaxWidth="1240" HorizontalAlignment="Left">
            <!-- What this page is -->
            <Border Style="{StaticResource Panel}" Padding="18,14" Margin="0,0,0,14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,0,0,0">
                        <Button Content="{loc:Tr Clients.FindInstallation}" Style="{StaticResource PrimaryButton}" Command="{Binding FindInstallationCommand}" Margin="0,0,8,0"
                                ToolTip="{loc:Tr Clients.LookWhereTibiaInstallationsUsuallyAre}" />
                        <Button Content="{loc:Tr Clients.BrowseForFolder}" Command="{Binding BrowseFolderCommand}" Margin="0,0,8,0"
                                ToolTip="{loc:Tr Clients.AnyFolderWithATibiaClient}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                                   Text="{loc:Tr Clients.ClientFoldersAreReadWhereThey}" />
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12"
                                   Text="{loc:Tr Clients.LocalOnlyNothingIsUploadedOr}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Reminder: the installed client's version is not archived yet -->
            <Border Background="{DynamicResource App.WarningSoft}" CornerRadius="6" Padding="14,10" Margin="0,0,0,14"
                    Visibility="{Binding Reminder, Converter={StaticResource NullToVisibility}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button Content="{loc:Tr Clients.ArchiveItNow}" Style="{StaticResource PrimaryButton}" Command="{Binding ArchiveInstalledNowCommand}" Margin="0,0,8,0"
                                ToolTip="{loc:Tr Clients.KeepARevisionOfThisVersion}" />
                        <Button Content="{loc:Tr Common.DonTAskForThisVersion}" Command="{Binding DismissReminderCommand}" Margin="0,0,8,0"
                                ToolTip="{loc:Tr Clients.NotOfferedAgainForThisContent}" />
                        <Button Content="{loc:Tr Clients.OnlyShowItHere}" Command="{Binding DisableRemindersCommand}"
                                ToolTip="{loc:Tr Clients.NoNoticeAtStartAnyMore}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Reminder}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Server -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <RadioButton Style="{StaticResource SegmentRadio}" GroupName="ClientServer" Content="{loc:Tr Clients.LiveServer}" IsChecked="{Binding ShowLive}" AutomationProperties.Name="{loc:Tr Clients.LiveServerClients}" />
                <RadioButton Style="{StaticResource SegmentRadio}" GroupName="ClientServer" Content="{loc:Tr Common.TestServer}" IsChecked="{Binding ShowTest}" AutomationProperties.Name="{loc:Tr Clients.TestServerClients}" />
            </StackPanel>

            <!-- Client folders: one card with a header (title, count, actions), the table, and the selected folder's details. -->
            <Border Style="{StaticResource Panel}" Padding="0" Margin="0,0,0,14">
                <StackPanel>
                    <Border Background="{DynamicResource App.CardHeader}" BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0" Padding="14,10">
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                                <Button Content="{loc:Tr Clients.UseThisClient}" Style="{StaticResource PrimaryButton}" Command="{Binding UseSourceCommand}" Margin="0,0,8,0"
                                        ToolTip="{loc:Tr Clients.EveryPageReadsThisFolderFrom}" />
                                <Button Content="{loc:Tr Clients.Archive}" Command="{Binding ArchiveSourceCommand}" Margin="0,0,8,0" IsEnabled="{Binding SelectedSource.IsAvailable, FallbackValue=False}"
                                        ToolTip="{loc:Tr Clients.ReadEveryFileOfTheFolder}" />
                                <Button Content="{loc:Tr Clients.CheckForChanges}" Command="{Binding RescanCommand}" Margin="0,0,8,0" IsEnabled="{Binding SelectedSource.IsAvailable, FallbackValue=False}"
                                        ToolTip="{loc:Tr Clients.ReadTheFolderAgainAndCompare}" />
                                <Button Style="{StaticResource SubtleButton}" Padding="8,4" ToolTip="{loc:Tr Clients.MoreActionsForTheSelectedFolder}" AutomationProperties.Name="{loc:Tr Clients.MoreFolderActions}"
                                        Click="OnMoreClick">
                                    <TextBlock Text="&#xE712;" Style="{StaticResource Icon}" FontSize="13" />
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{loc:Tr Common.Rename}" Command="{Binding RenameSourceCommand}" IsEnabled="{Binding SelectedSource.IsFolder, FallbackValue=False}" />
                                            <MenuItem Header="{loc:Tr Clients.LocateAgain}" Command="{Binding LocateAgainCommand}" IsEnabled="{Binding SelectedSource.IsFolder, FallbackValue=False}"
                                                      ToolTip="{loc:Tr Clients.TheFolderMovedOrWasRenamed}" />
                                            <Separator />
                                            <MenuItem Header="{loc:Tr Clients.Forget}" Command="{Binding RemoveSourceCommand}" IsEnabled="{Binding SelectedSource.IsFolder, FallbackValue=False}"
                                                      ToolTip="{loc:Tr Clients.StopListingThisFolderTheFolder}" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </WrapPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{loc:Tr Clients.ClientFolders}" Style="{StaticResource SectionTitle}" AutomationProperties.HeadingLevel="Level2" />
                                <TextBlock Text="{Binding SourceCount}" Style="{StaticResource Muted}" FontSize="12" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <ListView ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" MinHeight="44" MaxHeight="240" BorderThickness="0" Margin="6,4,6,0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled" controls:GridViewBehavior.FillLastColumn="True" AutomationProperties.Name="{loc:Tr Clients.ClientFolders}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="" Width="72">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource App.AccentSoft}" CornerRadius="9" Padding="7,1" HorizontalAlignment="Left"
                                                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding ActiveText}" FontSize="11.5" FontWeight="SemiBold" />
                                            </Border>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{loc:Tr Common.Name}" Width="200">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{loc:Tr Common.Kind}" Width="180" DisplayMemberBinding="{Binding TypeText}" />
                                <GridViewColumn Header="{loc:Tr Common.Version}" Width="120" DisplayMemberBinding="{Binding Version}" />
                                <GridViewColumn Header="{loc:Tr Common.Archived}" Width="100" DisplayMemberBinding="{Binding Archived}" />
                                <GridViewColumn Header="{loc:Tr Common.Status}" Width="240">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <!-- The selected folder: labeled values instead of a block of text. -->
                    <Border BorderBrush="{DynamicResource App.Border}" BorderThickness="0,1,0,0" Padding="14,10,14,12" Margin="0,4,0,0"
                            Visibility="{Binding SelectedSource, Converter={StaticResource NullToVisibility}}">
                        <ItemsControl ItemsSource="{Binding SourceFacts}" ItemTemplate="{StaticResource FactRow}" Grid.IsSharedSizeScope="True" Focusable="False"
                                      AutomationProperties.Name="{loc:Tr Clients.SelectedClientFolder}" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- Archived revisions -->
            <Border Style="{StaticResource Panel}" Padding="0" Margin="0,0,0,14">
                <StackPanel>
                    <Border Background="{DynamicResource App.CardHeader}" BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0" Padding="14,10">
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0" IsEnabled="{Binding HasRevisions}">
                                <Button Content="{loc:Tr Clients.UseThisRevision}" Command="{Binding UseRevisionCommand}" Margin="0,0,8,0"
                                        ToolTip="{loc:Tr Clients.EveryPageReadsThisArchivedRevision}" />
                                <Button Command="{Binding RebuildCommand}" Margin="0,0,8,0" ToolTip="{loc:Tr Clients.MakeANormalFolderFromThis}">
                                    <Button.Content>
                                        <PriorityBinding>
                                            <Binding Path="SelectedRevision.RebuildText" />
                                            <Binding Source="{x:Static loc:LocalizedStrings.Instance}" Path="[Clients.RebuildEllipsis]" Mode="OneWay" />
                                        </PriorityBinding>
                                    </Button.Content>
                                </Button>
                                <Button Content="{loc:Tr Clients.Compare}" Command="{Binding CompareCommand}" Margin="0,0,8,0"
                                        ToolTip="{loc:Tr Clients.CompareThisRevisionWithAnotherOne}" />
                                <Button Style="{StaticResource SubtleButton}" Padding="8,4" ToolTip="{loc:Tr Clients.MoreActionsForTheSelectedRevision}" AutomationProperties.Name="{loc:Tr Clients.MoreRevisionActions}"
                                        Click="OnMoreClick">
                                    <TextBlock Text="&#xE712;" Style="{StaticResource Icon}" FontSize="13" />
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{loc:Tr Common.Rename}" Command="{Binding RenameRevisionCommand}" />
                                            <Separator />
                                            <MenuItem Header="{loc:Tr Common.Delete}" Command="{Binding DeleteRevisionCommand}"
                                                      ToolTip="{loc:Tr Clients.DeleteThisRevisionContentOtherRevisions}" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </WrapPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{loc:Tr Common.ArchivedRevisions}" Style="{StaticResource SectionTitle}" AutomationProperties.HeadingLevel="Level2" />
                                <TextBlock Text="{Binding RevisionCount}" Style="{StaticResource Muted}" FontSize="12" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Grid>
                        <ListView ItemsSource="{Binding Revisions}" SelectedItem="{Binding SelectedRevision}" MinHeight="44" MaxHeight="280" BorderThickness="0" Margin="6,4,6,0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" controls:GridViewBehavior.FillLastColumn="True" AutomationProperties.Name="{loc:Tr Common.ArchivedRevisions}"
                                  Visibility="{Binding HasRevisions, Converter={StaticResource BoolToVisibility}}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="" Width="72">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource App.AccentSoft}" CornerRadius="9" Padding="7,1" HorizontalAlignment="Left"
                                                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="{Binding ActiveText}" FontSize="11.5" FontWeight="SemiBold" />
                                                </Border>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="{loc:Tr Common.Name}" Width="190">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="{loc:Tr Common.Version}" Width="130" DisplayMemberBinding="{Binding VersionText}" />
                                    <GridViewColumn Header="{loc:Tr Common.Archived}" Width="130" DisplayMemberBinding="{Binding Archived}" />
                                    <GridViewColumn Header="{loc:Tr Common.Files}" Width="70">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Files}" HorizontalAlignment="Right" /></DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="{loc:Tr Common.Size}" Width="80">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Size}" HorizontalAlignment="Right" /></DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="{loc:Tr Clients.OnlyHere}" Width="80">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Unique}" HorizontalAlignment="Right" ToolTip="{loc:Tr Clients.SpaceOnlyThisRevisionUsesFreed}" /></DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="{loc:Tr Common.Status}" Width="100" DisplayMemberBinding="{Binding Status}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <StackPanel Margin="16,18" HorizontalAlignment="Center" Visibility="{Binding HasRevisions, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                            <TextBlock Text="&#xE7B8;" Style="{StaticResource Icon}" FontSize="26" Foreground="{DynamicResource App.TextSecondary}" Opacity="0.7" Margin="0,0,0,6" />
                            <TextBlock Style="{StaticResource Muted}" TextAlignment="Center" MaxWidth="460"
                                       Text="{loc:Tr Clients.NoRevisionOfThisServerIs}" />
                        </StackPanel>
                    </Grid>
                    <!-- The selected revision: labeled values, then what it left out as a small table. -->
                    <Border BorderBrush="{DynamicResource App.Border}" BorderThickness="0,1,0,0" Padding="14,10,14,12" Margin="0,4,0,0"
                            Visibility="{Binding SelectedRevision, Converter={StaticResource NullToVisibility}}">
                        <StackPanel Grid.IsSharedSizeScope="True">
                            <ItemsControl ItemsSource="{Binding RevisionFacts}" ItemTemplate="{StaticResource FactRow}" Focusable="False" AutomationProperties.Name="{loc:Tr Clients.SelectedRevision}" />
                            <Expander Margin="0,8,0,0" Header="{loc:Tr Clients.LeftOutPersonalDataListedSo}"
                                      Visibility="{Binding RevisionExclusions, Converter={StaticResource NullToVisibility}}">
                                <ListView ItemsSource="{Binding RevisionExclusions}" BorderThickness="0" Margin="8" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          controls:GridViewBehavior.FillLastColumn="True" AutomationProperties.Name="{loc:Tr Clients.LeftOut}">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="{loc:Tr Common.Category}" Width="300" DisplayMemberBinding="{Binding Category}" />
                                            <GridViewColumn Header="{loc:Tr Common.Files}" Width="80">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate><TextBlock Text="{Binding Files}" HorizontalAlignment="Right" /></DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="{loc:Tr Common.Size}" Width="90">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate><TextBlock Text="{Binding Size}" HorizontalAlignment="Right" /></DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="{loc:Tr Clients.WhatItIs}" Width="300" DisplayMemberBinding="{Binding Reason}" />
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Expander>
                            <ItemsControl ItemsSource="{Binding RevisionProblems}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="{DynamicResource App.Warning}" TextWrapping="Wrap" FontSize="12" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Storage -->
            <GroupBox Header="{loc:Tr Common.Storage}" Margin="0,4,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding StorageSummary}" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding ArchiveSettings}" TextWrapping="Wrap" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,8" />
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                            <Button Content="{loc:Tr Clients.VerifyStore}" Command="{Binding VerifyStoreCommand}" Margin="0,0,8,0"
                                    ToolTip="{loc:Tr Clients.ReadEveryArchivedFileAgainAnd}" />
                            <Button Content="{loc:Tr Clients.ReclaimSpace}" Command="{Binding ReclaimSpaceCommand}" Margin="0,0,8,0"
                                    ToolTip="{loc:Tr Clients.FreeTheFilesThatNoArchived}" />
                            <Button Content="{loc:Tr Clients.OpenFolder}" Command="{Binding OpenStoreFolderCommand}" Margin="0,0,8,0" ToolTip="{loc:Tr Clients.OpenTheClientArchiveFolderIn}" />
                            <Button Content="{loc:Tr Clients.MoveStore}" Command="{Binding MoveStoreCommand}" Visibility="{Binding CanMoveStore, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="{loc:Tr Clients.MoveTheClientArchiveToAnother}" />
                        </StackPanel>
                        <TextBlock Text="{Binding StoreLocation}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
