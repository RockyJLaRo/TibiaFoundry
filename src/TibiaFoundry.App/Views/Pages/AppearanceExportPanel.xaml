<UserControl x:Class="TibiaFoundry.App.Views.Pages.AppearanceExportPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TibiaFoundry.App.Controls"
             xmlns:loc="clr-namespace:TibiaFoundry.App.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <WrapPanel>
            <!-- ===================================== GIF -->
            <GroupBox Header="{loc:Tr AppearanceExport.ExportGIF}" Width="470" Margin="0,0,12,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,10"
                               Text="{loc:Tr AppearanceExport.SavesTheSelectedAppearancesAsAnimated}" TextWrapping="Wrap" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="{loc:Tr Common.Preset}" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,5,8,0"
                                   ToolTip="{loc:Tr AppearanceExport.ReadyMadeSettingsForCommonFansite}" />
                        <StackPanel Grid.Column="1" Margin="0,0,0,8">
                            <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Name" Width="250" HorizontalAlignment="Left"
                                      AutomationProperties.Name="{loc:Tr AppearanceExport.ExportPreset}" />
                            <TextBlock Text="{Binding SelectedPreset.Description}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>

                        <TextBlock Grid.Row="1" Text="{loc:Tr Common.Size}" Style="{StaticResource FieldLabel}"
                                   ToolTip="{loc:Tr AppearanceExport.WholeNumberEnlargementWithNearestNeighbor}" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                            <ComboBox ItemsSource="{Binding Scales}" SelectedItem="{Binding Scale}" Width="70" ItemStringFormat="{}{0}×" AutomationProperties.Name="{loc:Tr AppearanceExport.Enlargement}" />
                            <TextBlock Text="{loc:Tr AppearanceExport.PixelExactTransparentBackground}" Style="{StaticResource Muted}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Grid.Row="2" Text="{loc:Tr Common.Attribution}" Style="{StaticResource FieldLabel}" ToolTip="{loc:Tr AppearanceExport.WrittenIntoTheMetadataOfEvery}" />
                        <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="{loc:Tr Common.Change}" Command="{Binding ChangeCreatorCommand}" Margin="8,0,0,0"
                                    ToolTip="{loc:Tr AppearanceExport.OpenSettingsToChangeTheCreator}" AutomationProperties.Name="{loc:Tr Common.ChangeCreatorName}" />
                            <TextBox Style="{StaticResource ValueText}" Text="{Binding AttributionPreview, Mode=OneWay}" VerticalAlignment="Center"
                                     AutomationProperties.Name="{loc:Tr Common.Attribution}" />
                        </DockPanel>

                        <TextBlock Grid.Row="3" Text="{loc:Tr AppearanceExport.FrameDelays}" Style="{StaticResource FieldLabel}"
                                   ToolTip="{loc:Tr AppearanceExport.EachAnimationPhaseInTheClient}" />
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                            <RadioButton Content="{loc:Tr AppearanceExport.Minimum}" GroupName="Delay" Margin="0,0,14,0" IsChecked="{Binding DelayMode, Converter={StaticResource EnumEquals}, ConverterParameter=Minimum}" />
                            <RadioButton Content="{loc:Tr AppearanceExport.Average}" GroupName="Delay" Margin="0,0,14,0" IsChecked="{Binding DelayMode, Converter={StaticResource EnumEquals}, ConverterParameter=Average}" />
                            <RadioButton Content="{loc:Tr AppearanceExport.Maximum}" GroupName="Delay" IsChecked="{Binding DelayMode, Converter={StaticResource EnumEquals}, ConverterParameter=Maximum}" />
                        </StackPanel>

                        <TextBlock Grid.Row="4" Text="{loc:Tr AppearanceExport.NoAnimationDelay}" Style="{StaticResource FieldLabel}" ToolTip="{loc:Tr AppearanceExport.DelayBetweenFramesForAppearancesThat}" />
                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                            <controls:NumericUpDown Value="{Binding NoAnimationDelay}" Minimum="0" Maximum="60000" Increment="100" AutomationProperties.Name="{loc:Tr AppearanceExport.NoAnimationDelay}" />
                            <TextBlock Text="{loc:Tr Common.Ms}" Style="{StaticResource FieldLabel}" Margin="6,0,0,0" />
                        </StackPanel>

                        <TextBlock Grid.Row="5" Text="{loc:Tr AppearanceExport.Pattern}" Style="{StaticResource FieldLabel}" Visibility="{Binding HasPatterns, Converter={StaticResource BoolToVisibility}}"
                                   ToolTip="{loc:Tr AppearanceExport.PatternsAreVariantsOfOneAppearance}" />
                        <ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{Binding PatternOptions}" loc:Choice.Prefix="Choice.Common" SelectedItem="{Binding SelectedPattern}" Width="110" HorizontalAlignment="Left"
                                  Margin="0,0,0,8" Visibility="{Binding HasPatterns, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{loc:Tr AppearanceExport.Pattern}" />

                        <TextBlock Grid.Row="6" Text="{loc:Tr AppearanceExport.OutfitDirection}" Style="{StaticResource FieldLabel}"
                                   ToolTip="{loc:Tr AppearanceExport.ForOutfitsTheDirectionTheCharacter}" />
                        <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                            <ComboBox ItemsSource="{Binding Directions}" loc:Choice.Prefix="Choice.Direction" SelectedItem="{Binding Direction}" Width="100" AutomationProperties.Name="{loc:Tr Common.Facing}" />
                            <ComboBox SelectedIndex="{Binding MovementIndex}" Width="100" Margin="8,0,0,0" AutomationProperties.Name="{loc:Tr Common.Movement}">
                                <ComboBoxItem Content="{loc:Tr Common.Idle}" />
                                <ComboBoxItem Content="{loc:Tr Common.Moving}" />
                            </ComboBox>
                        </StackPanel>

                        <TextBlock Grid.Row="7" Text="{loc:Tr AppearanceExport.ExtraFrame}" Style="{StaticResource FieldLabel}" />
                        <StackPanel Grid.Row="7" Grid.Column="1" Margin="0,0,0,8">
                            <CheckBox Content="{loc:Tr AppearanceExport.AddAnEmptyFrameAtThe}" IsChecked="{Binding ExtraFrame}" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <controls:NumericUpDown Value="{Binding ExtraDelay}" Minimum="0" Maximum="60000" Increment="100" AutomationProperties.Name="{loc:Tr AppearanceExport.ExtraDelay}" />
                                <TextBlock Text="{loc:Tr AppearanceExport.MsHowLongTheEmptyFrame}" Style="{StaticResource Muted}" Margin="8,0,0,0" VerticalAlignment="Center" Width="200" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Grid.Row="8" Text="{loc:Tr Common.OutputFolder}" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,7,8,0" />
                        <StackPanel Grid.Row="8" Grid.Column="1">
                            <CheckBox Content="{loc:Tr AppearanceExport.SortIntoObjectsOutfitsEffectsAnd}" IsChecked="{Binding KindFolders}" Margin="0,0,0,6"
                                      ToolTip="{loc:Tr AppearanceExport.AutomaticallyNamedGIFsGoIntoA}" />
                            <CheckBox Content="{loc:Tr AppearanceExport.NameFilesAutomatically}" IsChecked="{Binding AutoName}" Margin="0,0,0,6"
                                      ToolTip="{loc:Tr AppearanceExport.ObjectsAreNamedAfterTheirName}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Command="{Binding OpenOutputFolderCommand}" ToolTip="{loc:Tr Common.OpenTheOutputFolder}" AutomationProperties.Name="{loc:Tr Common.OpenOutputFolder}">
                                    <TextBlock Text="&#xE838;" Style="{StaticResource Icon}" FontSize="13" />
                                </Button>
                                <Button DockPanel.Dock="Right" Content="{loc:Tr Common.Change}" Command="{Binding ChangeOutputFolderCommand}" Margin="6,0,2,0" ToolTip="{loc:Tr AppearanceExport.ChooseTheFolderThatGIFsAre}" />
                                <TextBox Style="{StaticResource PathBox}" Text="{Binding OutputFolder, Mode=OneWay}" AutomationProperties.Name="{loc:Tr AppearanceExport.GIFOutputFolder}" />
                            </DockPanel>
                        </StackPanel>
                    </Grid>
                    <Button Content="{loc:Tr AppearanceExport.SaveAsGIF}" Style="{StaticResource PrimaryButton}" Command="{Binding SaveGifCommand}" HorizontalAlignment="Right" Margin="0,12,0,0" MinWidth="130" />
                </StackPanel>
            </GroupBox>

            <StackPanel Width="300">
                <!-- ===================================== outfiter sheet -->
                <GroupBox Header="{loc:Tr Common.OutfiterSheet}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,8" Text="{loc:Tr AppearanceExport.AllSpritesOfTheSelectedOutfit}" TextWrapping="Wrap" />
                        <RadioButton Content="{loc:Tr AppearanceExport.CopyPNGToClipboard}" GroupName="SheetOut" IsChecked="{Binding SheetOutput, Converter={StaticResource EnumEquals}, ConverterParameter=PngClipboard}" />
                        <RadioButton Content="{loc:Tr AppearanceExport.SavePNGFile}" GroupName="SheetOut" IsChecked="{Binding SheetOutput, Converter={StaticResource EnumEquals}, ConverterParameter=PngFile}" />
                        <RadioButton Content="{loc:Tr AppearanceExport.CopyAsBase64DataURI}" GroupName="SheetOut" IsChecked="{Binding SheetOutput, Converter={StaticResource EnumEquals}, ConverterParameter=Base64}" />
                        <CheckBox Content="{loc:Tr Common.MagentaBackground}" IsChecked="{Binding SheetMagenta}" Margin="0,8,0,0" ToolTip="{loc:Tr AppearanceExport.FillTransparentAreasWithMagentaInstead}" />
                        <Button Content="{loc:Tr AppearanceExport.CreateSheet}" Command="{Binding GenerateSheetCommand}" HorizontalAlignment="Right" Margin="0,8,0,0" ToolTip="{loc:Tr AppearanceExport.CreateTheSheetForTheOutfit}" />
                    </StackPanel>
                </GroupBox>
                <!-- ===================================== filtered data -->
                <GroupBox Header="{loc:Tr AppearanceExport.ExportTheCurrentList}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,8" Text="{loc:Tr AppearanceExport.SavesOrCopiesTheAppearancesCurrently}" TextWrapping="Wrap" />
                        <Button Content="{loc:Tr Common.SaveAsJSON}" Command="{Binding ExportFilteredJsonCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,6" ToolTip="{loc:Tr AppearanceExport.SaveTheFullDataOfThe}" />
                        <Button Content="{loc:Tr AppearanceExport.SaveIDAndNameTable}" Command="{Binding ExportFilteredTableCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,6" ToolTip="{loc:Tr AppearanceExport.SaveATextFileWithOne}" />
                        <Button Content="{loc:Tr AppearanceExport.CopyIDAndNameTable}" Command="{Binding CopyFilteredTableCommand}" HorizontalAlignment="Stretch" ToolTip="{loc:Tr AppearanceExport.CopyOneAppearancePerLineID}" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </WrapPanel>
    </ScrollViewer>
</UserControl>
