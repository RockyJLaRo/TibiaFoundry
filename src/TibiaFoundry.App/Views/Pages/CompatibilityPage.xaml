<UserControl x:Class="TibiaFoundry.App.Views.Pages.CompatibilityPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TibiaFoundry.App.ViewModels"
             xmlns:compat="clr-namespace:TibiaFoundry.Core.Compatibility;assembly=TibiaFoundry.Core"
             xmlns:loc="clr-namespace:TibiaFoundry.App.Localization">
    <UserControl.Resources>
        <!-- Status badge colors: supported = green, unfamiliar = blue, partial = amber, missing/unsupported = red. -->
        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="{DynamicResource App.SurfaceAlt}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static compat:CompatibilityStatus.Supported}">
                    <Setter Property="Background" Value="{DynamicResource App.SuccessSoft}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static compat:CompatibilityStatus.Unfamiliar}">
                    <Setter Property="Background" Value="{DynamicResource App.AccentSoft}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static compat:CompatibilityStatus.Partial}">
                    <Setter Property="Background" Value="{DynamicResource App.WarningSoft}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static compat:CompatibilityStatus.Missing}">
                    <Setter Property="Background" Value="{DynamicResource App.DangerSoft}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static compat:CompatibilityStatus.Unsupported}">
                    <Setter Property="Background" Value="{DynamicResource App.DangerSoft}" />
                </DataTrigger>
                <!-- A missing optional file is not a problem of the client data. -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Status}" Value="{x:Static compat:CompatibilityStatus.Missing}" />
                        <Condition Binding="{Binding Required}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource App.SurfaceAlt}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static compat:CompatibilityStatus.Supported}">
                    <Setter Property="Foreground" Value="{DynamicResource App.Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static compat:CompatibilityStatus.Unfamiliar}">
                    <Setter Property="Foreground" Value="{DynamicResource App.Link}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static compat:CompatibilityStatus.Partial}">
                    <Setter Property="Foreground" Value="{DynamicResource App.Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static compat:CompatibilityStatus.Missing}">
                    <Setter Property="Foreground" Value="{DynamicResource App.Danger}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static compat:CompatibilityStatus.Unsupported}">
                    <Setter Property="Foreground" Value="{DynamicResource App.Danger}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Status}" Value="{x:Static compat:CompatibilityStatus.Missing}" />
                        <Condition Binding="{Binding Required}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="{DynamicResource App.TextSecondary}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16,14,16,20" MaxWidth="1000" HorizontalAlignment="Left">
            <!-- Summary -->
            <Border Style="{StaticResource Panel}" Padding="18,14" Margin="0,0,0,14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,0,0,0">
                        <Button Content="{loc:Tr Compatibility.CheckAgain}" Style="{StaticResource PrimaryButton}" Command="{Binding CheckCommand}" Margin="0,0,8,0" ToolTip="{loc:Tr Compatibility.CheckTheClientFilesAgainFor}" />
                        <Button Content="{loc:Tr Compatibility.CopyReport}" Command="{Binding CopyReportCommand}" Margin="0,0,8,0"
                                ToolTip="{loc:Tr Compatibility.CopyTheFullReportToThe}" />
                        <Button Content="{loc:Tr Compatibility.AllLocations}" Command="{Binding OpenLocationSettingsCommand}" Margin="0,0,8,0"
                                ToolTip="{loc:Tr Compatibility.SettingsClientAndDataLocationsEvery}" />
                        <Button Style="{StaticResource SubtleButton}" Command="{Binding OpenLogFolderCommand}" ToolTip="{loc:Tr Common.OpenTheFolderWithTheProgram}" AutomationProperties.Name="{loc:Tr Common.OpenLogFolder}">
                            <TextBlock Text="&#xE838;" Style="{StaticResource Icon}" FontSize="13" />
                        </Button>
                    </StackPanel>
                    <StackPanel>
                        <Border Margin="0,0,0,8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="10" />
                                    <Setter Property="Padding" Value="10,2" />
                                    <Setter Property="HorizontalAlignment" Value="Left" />
                                    <Setter Property="Background" Value="{DynamicResource App.SurfaceAlt}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Overall}" Value="{x:Static compat:CompatibilityStatus.Supported}"><Setter Property="Background" Value="{DynamicResource App.SuccessSoft}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding Overall}" Value="{x:Static compat:CompatibilityStatus.Unfamiliar}"><Setter Property="Background" Value="{DynamicResource App.AccentSoft}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding Overall}" Value="{x:Static compat:CompatibilityStatus.Partial}"><Setter Property="Background" Value="{DynamicResource App.WarningSoft}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding Overall}" Value="{x:Static compat:CompatibilityStatus.Missing}"><Setter Property="Background" Value="{DynamicResource App.DangerSoft}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding Overall}" Value="{x:Static compat:CompatibilityStatus.Unsupported}"><Setter Property="Background" Value="{DynamicResource App.DangerSoft}" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding OverallText}" FontSize="15" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Text="{Binding ClientText}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding CheckedText}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,8" />
                        <TextBlock Text="{Binding Advice}" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Extracted sprites folder from another client version -->
            <Border Padding="12,8" Margin="0,0,0,14" CornerRadius="{StaticResource App.Radius}" Background="{DynamicResource App.WarningSoft}"
                    BorderBrush="{DynamicResource App.Warning}" BorderThickness="1"
                    Visibility="{Binding SpriteFolderNotice, Converter={StaticResource NullToVisibility}}">
                <DockPanel>
                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource App.Warning}" Margin="0,1,8,0" VerticalAlignment="Top" />
                    <TextBlock Text="{Binding SpriteFolderNotice}" TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <TextBlock Style="{StaticResource EmptyState}" Text="{loc:Tr Compatibility.NoReportYetTheCheckRuns}"
                       Visibility="{Binding Rows.Count, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}" />

            <!-- Components -->
            <ItemsControl ItemsSource="{Binding Rows}" AutomationProperties.Name="{loc:Tr Compatibility.CompatibilityOfEachDataFile}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CompatibilityRow}">
                        <Border Style="{StaticResource Panel}" Padding="16,12" Margin="0,0,0,10">
                            <StackPanel>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource StatusBadge}" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusText}" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Component, Converter={StaticResource LocChoice}, ConverterParameter=Component}" FontWeight="SemiBold" FontSize="14" />
                                        <TextBlock Text="{Binding FileName}" Style="{StaticResource Muted}" FontSize="11" FontFamily="{StaticResource App.MonoFont}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}" Visibility="{Binding FileName, Converter={StaticResource NullToVisibility}}" />
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                <!-- Where the file or folder is, where that came from, and how to change it. -->
                                <DockPanel Margin="0,8,0,0" Visibility="{Binding CanLocate, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,0,0,0">
                                        <Button Content="{Binding LocateText}" Margin="0,0,6,0"
                                                Command="{Binding DataContext.LocateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                AutomationProperties.Name="{Binding Component, Converter={StaticResource LocFormat}, ConverterParameter=Compatibility.Locate0}"
                                                ToolTip="{loc:Tr Compatibility.ChooseTheFileOrFolderYourself}" />
                                        <Button Content="{loc:Tr Compatibility.ResetToAutomatic}" Visibility="{Binding IsChosen, Converter={StaticResource BoolToVisibility}}"
                                                Command="{Binding DataContext.ResetLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                AutomationProperties.Name="{Binding Component, Converter={StaticResource LocFormat}, ConverterParameter=Compatibility.Reset0ToAutomatic}"
                                                ToolTip="{loc:Tr Compatibility.ForgetYourChoiceAndUseThe}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Path}" FontSize="11" FontFamily="{StaticResource App.MonoFont}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"
                                                   Foreground="{DynamicResource App.TextSecondary}" />
                                        <TextBlock FontSize="11" Foreground="{DynamicResource App.TextSecondary}" Visibility="{Binding SourceText, Converter={StaticResource NullToVisibility}}">
                                            <Run Text="{loc:Tr Compatibility.Location}" /> <Run Text="{Binding SourceText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Visibility="{Binding ShowAffected, Converter={StaticResource BoolToVisibility}}">
                                    <Run Text="{loc:Tr Compatibility.Affected}" FontWeight="SemiBold" /> <Run Text="{Binding Affected, Mode=OneWay}" />
                                </TextBlock>
                                <Expander Header="{loc:Tr Common.Details}" Margin="0,6,0,0" Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl ItemsSource="{Binding Details}" Margin="4,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,0,0,3">
                                                    <TextBlock Text="•" Margin="0,0,6,0" Foreground="{DynamicResource App.TextSecondary}" />
                                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource App.TextSecondary}" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="2,6,0,0"
                       Text="{loc:Tr Compatibility.SupportedValidatedWithThisVersionOf}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
