<UserControl x:Class="TibiaFoundry.App.Views.Pages.MapToolsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TibiaFoundry.App.Controls"
             xmlns:vm="clr-namespace:TibiaFoundry.App.ViewModels"
             xmlns:map="clr-namespace:TibiaFoundry.Core.Map;assembly=TibiaFoundry.Core"
             xmlns:loc="clr-namespace:TibiaFoundry.App.Localization">
    <Grid Margin="16,14,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Panel}" Padding="12,10" Margin="0,0,0,12">
            <DockPanel>
                <TextBlock Text="{loc:Tr MapTools.MapData}" Style="{StaticResource FieldLabel}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button Content="{loc:Tr Common.Load}" Style="{StaticResource PrimaryButton}" Command="{Binding LoadCommand}" MinWidth="70" ToolTip="{loc:Tr MapTools.ReadTheMapFileShownBelow}" />
                    <Button Content="{loc:Tr Common.ChangeFile}" Command="{Binding ChangeFileCommand}" Margin="6,0,0,0" ToolTip="{loc:Tr MapTools.ChooseADifferentMapDatFile}" />
                    <Button Content="{loc:Tr Common.ExportJSON}" Command="{Binding ExportJsonCommand}" Margin="6,0,0,0" ToolTip="{loc:Tr MapTools.SaveTheWholeMapFileAs}" />
                </StackPanel>
                <TextBox Style="{StaticResource PathBox}" Text="{Binding DatPath, Mode=OneWay, Converter={StaticResource LocOr}, ConverterParameter=MapTools.NoMapFileFound}" AutomationProperties.Name="{loc:Tr MapTools.MapFile}" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="230" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Panel}" Padding="10">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource SegmentHost}" HorizontalAlignment="Left" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource SegmentRadio}" Content="{loc:Tr MapTools.Areas}" GroupName="MK" IsChecked="{Binding ListKind, Converter={StaticResource EnumEquals}, ConverterParameter=Areas}" />
                            <RadioButton Style="{StaticResource SegmentRadio}" Content="{loc:Tr MapTools.NPCs}" GroupName="MK" IsChecked="{Binding ListKind, Converter={StaticResource EnumEquals}, ConverterParameter=Npcs}" />
                            <RadioButton Style="{StaticResource SegmentRadio}" Content="{loc:Tr Common.Files}" GroupName="MK" IsChecked="{Binding ListKind, Converter={StaticResource EnumEquals}, ConverterParameter=Files}" />
                        </StackPanel>
                    </Border>
                    <TextBox DockPanel.Dock="Top" Margin="0,0,0,8" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=150}" ToolTip="{loc:Tr MapTools.FilterByNameIDOrSubarea}" controls:Input.Placeholder="{loc:Tr Common.Filter}" AutomationProperties.Name="{loc:Tr Common.Filter}" />
                    <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" Foreground="{DynamicResource App.TextSecondary}" FontSize="12">
                        <Run Text="{Binding VisibleCount, Mode=OneWay, Converter={StaticResource Number}}" /> <Run Text="{loc:Tr Common.Of}" /> <Run Text="{Binding TotalCount, Mode=OneWay, Converter={StaticResource Number}}" />
                    </TextBlock>
                    <Grid>
                        <ListView ItemsSource="{Binding VisibleItems}" SelectedItem="{Binding SelectedItem}" AutomationProperties.Name="{loc:Tr MapTools.MapEntries}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="{loc:Tr MapTools.IDPosition}" Width="100" DisplayMemberBinding="{Binding Id}" />
                                    <GridViewColumn Header="{loc:Tr Common.Name}" Width="180">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type vm:ListItem}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource App.TextSecondary}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <TextBlock Style="{StaticResource EmptyState}" Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"
                                   Text="{loc:Tr MapTools.NoMapDataLoadedYetClick}" />
                    </Grid>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" />

            <TabControl Grid.Column="2" Padding="0,10,0,0">
                <TabItem Header="{loc:Tr Common.Data}">
                    <ItemsControl Style="{StaticResource PropertyList}" ItemsSource="{Binding Properties}" Tag="190" AutomationProperties.Name="{loc:Tr Common.Properties}" />
                </TabItem>

                <TabItem Header="{loc:Tr MapTools.ExtractMapFiles}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <GroupBox Header="{loc:Tr MapTools.ExtractMinimapSatelliteAndSubareaImages}" MaxWidth="760" HorizontalAlignment="Left">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,10"
                                           Text="{loc:Tr MapTools.DecodesTheMapImagesListedIn}" TextWrapping="Wrap" />
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="{loc:Tr Common.InputFolder}" Style="{StaticResource FieldLabel}" Width="100" />
                                    <Button DockPanel.Dock="Right" Content="{loc:Tr Common.Change}" Command="{Binding BrowseExtractInputCommand}" Margin="6,0,0,0" ToolTip="{loc:Tr MapTools.ChooseTheFolderWithTheClient}" />
                                    <TextBox Style="{StaticResource PathBox}" Text="{Binding ExtractInput, Mode=OneWay}" AutomationProperties.Name="{loc:Tr Common.InputFolder}" />
                                </DockPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Text="{loc:Tr Common.OutputFolder}" Style="{StaticResource FieldLabel}" Width="100" />
                                    <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Command="{Binding OpenExtractOutputCommand}" ToolTip="{loc:Tr Common.OpenTheOutputFolder}" AutomationProperties.Name="{loc:Tr Common.OpenOutputFolder}">
                                        <TextBlock Text="&#xE838;" Style="{StaticResource Icon}" FontSize="13" />
                                    </Button>
                                    <Button DockPanel.Dock="Right" Content="{loc:Tr Common.Change}" Command="{Binding BrowseExtractOutputCommand}" Margin="6,0,2,0" ToolTip="{loc:Tr MapTools.ChooseWhereThePNGFilesAre}" />
                                    <TextBox Style="{StaticResource PathBox}" Text="{Binding ExtractOutput, Mode=OneWay}" AutomationProperties.Name="{loc:Tr Common.OutputFolder}" />
                                </DockPanel>
                                <WrapPanel Margin="100,0,0,10">
                                    <CheckBox Content="{loc:Tr MapTools.Satellite}" IsChecked="{Binding ExtractSatellite}" Margin="0,0,16,0" />
                                    <CheckBox Content="{loc:Tr MapTools.Minimap}" IsChecked="{Binding ExtractMinimap}" Margin="0,0,16,0" />
                                    <CheckBox Content="{loc:Tr MapTools.Subareas}" IsChecked="{Binding ExtractSubareas}" />
                                </WrapPanel>
                                <Button Content="{loc:Tr MapTools.ExtractImages}" Style="{StaticResource PrimaryButton}" Command="{Binding ExtractCommand}" HorizontalAlignment="Right" ToolTip="{loc:Tr MapTools.DecodeTheCheckedImageTypesInto}" />
                            </StackPanel>
                        </GroupBox>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{loc:Tr MapTools.BuildHRMap}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                            <GroupBox Header="{loc:Tr MapTools.HighResolutionMapFromExtractedTiles}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock Text="{loc:Tr Common.InputFolder}" Style="{StaticResource FieldLabel}" Width="100" />
                                        <Button DockPanel.Dock="Right" Content="{loc:Tr Common.Change}" Command="{Binding BrowseHrInputCommand}" Margin="6,0,0,0" ToolTip="{loc:Tr MapTools.ChooseTheFolderWithTheImages}" />
                                        <TextBox Style="{StaticResource PathBox}" Text="{Binding HrInput, Mode=OneWay}" AutomationProperties.Name="{loc:Tr MapTools.HRInputFolder}" />
                                    </DockPanel>
                                    <WrapPanel Margin="100,0,0,0">
                                        <StackPanel Margin="0,0,20,10">
                                            <TextBlock Text="{loc:Tr MapTools.MapType}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                            <ComboBox SelectedValue="{Binding HrType}" SelectedValuePath="Tag" Width="130" AutomationProperties.Name="{loc:Tr MapTools.MapType}">
                                                <ComboBoxItem Content="{loc:Tr MapTools.Satellite}" Tag="{x:Static map:HrMapType.Satellite}" />
                                                <ComboBoxItem Content="{loc:Tr MapTools.Minimap}" Tag="{x:Static map:HrMapType.Minimap}" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,20,10">
                                            <TextBlock Text="{loc:Tr Common.Zoom}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                            <ComboBox ItemsSource="{Binding HrZoomOptions}" SelectedIndex="{Binding HrZoomIndex}" Width="100" AutomationProperties.Name="{loc:Tr Common.Zoom}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,20,10">
                                            <TextBlock Text="{loc:Tr MapTools.TopFloor}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                            <ComboBox ItemsSource="{Binding HrFloorOptions}" SelectedIndex="{Binding HrTopFloor}" Width="120" AutomationProperties.Name="{loc:Tr MapTools.TopFloor}" />
                                        </StackPanel>
                                    </WrapPanel>
                                    <WrapPanel Margin="100,0,0,10">
                                        <CheckBox Content="{loc:Tr MapTools.StackFloors}" IsChecked="{Binding HrCumulative}" Margin="0,0,16,4" ToolTip="{loc:Tr MapTools.DrawEveryFloorFromTheGround}" />
                                        <CheckBox Content="{loc:Tr MapTools.FloorOffset}" IsChecked="{Binding HrFloorOffset}" Margin="0,0,16,4" ToolTip="{loc:Tr MapTools.ShiftEachHigherFloorOneSquare}" />
                                        <CheckBox Content="{loc:Tr MapTools.TibiaWikiWatermark}" IsChecked="{Binding HrWatermark}" ToolTip="{loc:Tr MapTools.RepeatAFaintTibiaWikiLogo10}" />
                                    </WrapPanel>
                                    <Button Content="{loc:Tr MapTools.BuildHRMap2}" Style="{StaticResource PrimaryButton}" Command="{Binding BuildHrCommand}" HorizontalAlignment="Right" ToolTip="{loc:Tr MapTools.ChooseWhereToSaveTheMap}" />
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="{loc:Tr MapTools.CyclopediaMinimapTiles}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,8"
                                               Text="{loc:Tr MapTools.CutsTheCyclopediaFloorImagesFloor}" TextWrapping="Wrap" />
                                    <Button Content="{loc:Tr MapTools.CutIntoMinimapTiles}" Command="{Binding CropCyclopediaCommand}" HorizontalAlignment="Right" ToolTip="{loc:Tr MapTools.ChooseTheFolderWithTheCyclopedia}" />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{loc:Tr MapTools.ExportData}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <WrapPanel>
                            <GroupBox Header="{loc:Tr MapTools.TibiaWikiListsCopiedToTheClipboard}" Width="330" Margin="0,0,12,12">
                                <StackPanel>
                                    <Button Content="{loc:Tr MapTools.AreasAndSubareasWikiTable}" Command="{Binding CopyWikiAreaListCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,6" ToolTip="{loc:Tr MapTools.CopyAWikiTableOfEvery}" />
                                    <Button Content="{loc:Tr MapTools.MapLabelsWithCoordinates}" Command="{Binding CopyLabelsWithCoordinatesCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,6" ToolTip="{loc:Tr MapTools.CopyOneLinePerLabeledSubarea}" />
                                    <Button Content="{loc:Tr MapTools.SubareasWithoutAMapLabel}" Command="{Binding CopyLabelsWithoutCoordinatesCommand}" HorizontalAlignment="Stretch" ToolTip="{loc:Tr MapTools.CopyOneLinePerSubareaThat}" />
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="{loc:Tr MapTools.ExportTheAreasOrNPCsList}" Width="330">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,8"
                                               Text="{loc:Tr MapTools.SavesTheCompleteListSelectedOn}" TextWrapping="Wrap" />
                                    <Button Content="{loc:Tr Common.SaveAsJSON}" Command="{Binding ExportListJsonCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,6" />
                                    <Button Content="{loc:Tr MapTools.SaveAsTableTabSeparated}" Command="{Binding ExportListTableCommand}" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </GroupBox>
                        </WrapPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>
