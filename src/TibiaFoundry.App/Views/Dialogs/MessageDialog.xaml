<Window x:Class="TibiaFoundry.App.Views.Dialogs.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:TibiaFoundry.App.Localization"
        Style="{StaticResource AppWindow}"
        Width="460" MinWidth="360" SizeToContent="Height" MinHeight="150" MaxHeight="640"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="22,20,22,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="IconBadge" Width="34" Height="34" CornerRadius="17" VerticalAlignment="Top" Margin="0,0,14,0">
                <TextBlock x:Name="IconGlyph" Style="{StaticResource Icon}" FontSize="16" />
            </Border>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBox x:Name="MessageText" Style="{StaticResource ValueText}" FontSize="13.5" AutomationProperties.Name="{loc:Tr Common.Message}" />
            </ScrollViewer>
        </Grid>
        <Border Grid.Row="1" Background="{DynamicResource App.HeaderBackground}" BorderBrush="{DynamicResource App.Border}" BorderThickness="0,1,0,0" Padding="16,12">
            <DockPanel>
            <Button DockPanel.Dock="Left" Style="{StaticResource SubtleButton}" Click="OnCopy" ToolTip="{loc:Tr Dialog.CopyTheMessageAsTextCtrl}" AutomationProperties.Name="{loc:Tr Dialog.CopyDetails}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" FontSize="13" Text="&#xE8C8;" Margin="0,0,6,0" />
                    <TextBlock x:Name="CopyText" Text="{loc:Tr Common.Copy}" />
                </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" MinWidth="90" Margin="0,0,8,0" IsCancel="True" Click="OnCancel" />
                <Button x:Name="AlternativeButton" MinWidth="90" Margin="0,0,8,0" Visibility="Collapsed" Click="OnAlternative" />
                <Button x:Name="OkButton" MinWidth="90" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnOk" />
            </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
