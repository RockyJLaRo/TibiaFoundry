<Window x:Class="TibiaFoundry.App.Views.Dialogs.ReportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:TibiaFoundry.App.Localization"
        Style="{StaticResource AppWindow}"
        Width="620" MinWidth="440" SizeToContent="Height" MinHeight="220" MaxHeight="800"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: what happened, in one line, and the summary. -->
        <Grid Margin="22,18,22,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="IconBadge" Width="34" Height="34" CornerRadius="17" VerticalAlignment="Top" Margin="0,2,14,0">
                <TextBlock x:Name="IconGlyph" Style="{StaticResource Icon}" FontSize="16" />
            </Border>
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="Heading" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level1" />
                <TextBox x:Name="Summary" Style="{StaticResource ValueText}" Margin="0,4,0,0" Foreground="{DynamicResource App.TextSecondary}" AutomationProperties.Name="{loc:Tr Common.Summary}" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel x:Name="Body" Margin="22,0,22,14" Grid.IsSharedSizeScope="True" />
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource App.HeaderBackground}" BorderBrush="{DynamicResource App.Border}" BorderThickness="0,1,0,0" Padding="16,12">
            <DockPanel>
                <Button x:Name="CopyButton" DockPanel.Dock="Left" Style="{StaticResource SubtleButton}" Click="OnCopy"
                        ToolTip="{loc:Tr Dialog.CopyEveryDetailOfThisMessage}" AutomationProperties.Name="{loc:Tr Dialog.CopyDetails}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" FontSize="13" Text="&#xE8C8;" Margin="0,0,6,0" />
                        <TextBlock x:Name="CopyText" Text="{loc:Tr Dialog.CopyDetails}" />
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" MinWidth="90" Margin="0,0,8,0" IsCancel="True" Click="OnCancel" />
                    <Button x:Name="SecondaryButton" MinWidth="90" Margin="0,0,8,0" Visibility="Collapsed" Click="OnSecondary" />
                    <Button x:Name="PrimaryButton" MinWidth="90" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnPrimary" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
