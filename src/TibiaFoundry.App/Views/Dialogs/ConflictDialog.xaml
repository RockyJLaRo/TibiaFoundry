<Window x:Class="TibiaFoundry.App.Views.Dialogs.ConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:TibiaFoundry.App.Localization"
        Style="{StaticResource AppWindow}"
        Title="{loc:Tr Dialog.TheFileAlreadyExists}"
        Width="520" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="22,20,22,16">
            <TextBlock x:Name="Heading" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,8" />
            <TextBox x:Name="PathText" Style="{StaticResource ValueText}" FontFamily="{StaticResource App.MonoFont}" FontSize="12" Margin="0,0,0,10"
                     AutomationProperties.Name="{loc:Tr Dialog.ExistingFile}" />
            <TextBlock x:Name="BackupNote" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" />
            <CheckBox x:Name="ApplyToAll" Content="{loc:Tr Dialog.DoTheSameForTheOther}" AutomationProperties.Name="{loc:Tr Dialog.ApplyToAllFiles}" />
        </StackPanel>
        <Border Grid.Row="1" Background="{DynamicResource App.HeaderBackground}" BorderBrush="{DynamicResource App.Border}" BorderThickness="0,1,0,0" Padding="16,12">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="{loc:Tr Common.Cancel}" MinWidth="80" IsCancel="True" Click="OnCancel" ToolTip="{loc:Tr Dialog.StopTheOperationFilesAlreadyWritten}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{loc:Tr Dialog.Skip}" MinWidth="80" Margin="0,0,8,0" Click="OnSkip" ToolTip="{loc:Tr Dialog.KeepTheExistingFileAndDo}" />
                    <Button Content="{loc:Tr Dialog.KeepBoth}" MinWidth="90" Margin="0,0,8,0" Click="OnKeepBoth" ToolTip="{loc:Tr Dialog.KeepTheExistingFileAndSave}" />
                    <Button x:Name="ReplaceButton" Content="{loc:Tr Dialog.Replace}" MinWidth="90" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnReplace" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
