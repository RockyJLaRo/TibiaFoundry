<Window x:Class="TibiaFoundry.App.Views.Dialogs.ArchiveDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:TibiaFoundry.App.Localization"
        Style="{StaticResource AppWindow}"
        Title="{loc:Tr Dialog.ArchiveClient}"
        Width="600" MinWidth="480" SizeToContent="Height" MinHeight="300" MaxHeight="780"
        ResizeMode="CanResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <!-- A figure of the summary: the value large, its label below. -->
        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource App.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource App.Radius}" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="TileValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="TileLabel" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,3,14,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="NumberCell" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- A. Header: what is archived. -->
        <Grid Margin="22,18,22,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="34" Height="34" CornerRadius="17" VerticalAlignment="Top" Margin="0,2,14,0" Background="{DynamicResource App.AccentSoft}">
                <TextBlock Style="{StaticResource Icon}" FontSize="16" Foreground="{DynamicResource App.Accent}" Text="&#xE7B8;" />
            </Border>
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="Heading" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="Subtitle" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                <TextBlock x:Name="FolderText" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="22,0,22,16">
                <!-- Kept as an incomplete revision: said first, it changes what the revision is. -->
                <Border x:Name="IncompleteBanner" Style="{StaticResource InfoBanner}" Background="{DynamicResource App.WarningSoft}" Margin="0,0,0,12" Visibility="Collapsed">
                    <TextBlock x:Name="IncompleteText" TextWrapping="Wrap" />
                </Border>

                <!-- B. Summary. -->
                <Grid Margin="0,0,-8,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Tile}">
                        <StackPanel>
                            <TextBlock x:Name="FilesValue" Style="{StaticResource TileValue}" />
                            <TextBlock Style="{StaticResource TileLabel}" Text="{loc:Tr Common.Files}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Tile}" ToolTip="{loc:Tr Dialog.TheArchivedFilesAsRestoredThe}">
                        <StackPanel>
                            <TextBlock x:Name="SizeValue" Style="{StaticResource TileValue}" />
                            <TextBlock Style="{StaticResource TileLabel}" Text="{loc:Tr Dialog.ArchiveSize}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Tile}" ToolTip="{loc:Tr Dialog.WhatIsWrittenToTheArchive}">
                        <StackPanel>
                            <TextBlock x:Name="NewValue" Style="{StaticResource TileValue}" />
                            <TextBlock Style="{StaticResource TileLabel}" Text="{loc:Tr Dialog.NewDiskUsage}" />
                        </StackPanel>
                    </Border>
                </Grid>
                <Grid x:Name="Facts" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Dialog.Scope}" Margin="0,2,16,2" VerticalAlignment="Top" />
                    <TextBlock x:Name="ScopeValue" Grid.Column="1" TextWrapping="Wrap" Margin="0,2" />
                    <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="{loc:Tr Common.Storage}" Margin="0,2,16,2" VerticalAlignment="Top" />
                    <TextBlock x:Name="StorageValue" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" Margin="0,2" />
                    <TextBlock x:Name="ReusedLabel" Grid.Row="2" Style="{StaticResource FieldLabel}" Text="{loc:Tr Dialog.Reused}" Margin="0,2,16,2" VerticalAlignment="Top" />
                    <TextBlock x:Name="ReusedValue" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" Margin="0,2" />
                    <TextBlock x:Name="ChangesLabel" Grid.Row="3" Style="{StaticResource FieldLabel}" Text="{loc:Tr Common.Changes}" Margin="0,2,16,2" VerticalAlignment="Top" />
                    <TextBlock x:Name="ChangesValue" Grid.Row="3" Grid.Column="1" TextWrapping="Wrap" Margin="0,2" />
                </Grid>

                <!-- C. Personal data. -->
                <Border x:Name="PersonalSection" Background="{DynamicResource App.SurfaceAlt}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1"
                        CornerRadius="{StaticResource App.Radius}" Padding="14,10" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr Dialog.PersonalData}" />
                        <TextBlock x:Name="PersonalState" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <CheckBox x:Name="IncludePersonal" Content="{loc:Tr Dialog.IncludePersonalData}" Margin="0,8,0,0" Click="OnIncludePersonalClick"
                                  AutomationProperties.HelpText="{loc:Tr Dialog.ArchivesYourOptionsHotkeysCharacterData}" />
                        <TextBlock x:Name="PersonalHelp" Style="{StaticResource Muted}" FontSize="12" Margin="22,3,0,0" />
                        <StackPanel x:Name="Recalculating" Orientation="Vertical" Margin="0,8,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="RecalculatingText" Style="{StaticResource Muted}" FontSize="12" Text="{loc:Tr Dialog.ReadingTheFolderAgain}" />
                            <ProgressBar x:Name="RecalculatingProgress" Height="4" Margin="0,4,0,0" IsIndeterminate="True" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- D. File details: every category, included or not. -->
                <Expander x:Name="DetailsExpander" Header="{loc:Tr Dialog.FileDetails}" Margin="0">
                    <StackPanel Margin="0,6,0,0" Grid.IsSharedSizeScope="True">
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="120" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="State" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Files" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Size" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="New" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Cell}" Foreground="{DynamicResource App.TextSecondary}" Text="{loc:Tr Common.Category}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource Cell}" Foreground="{DynamicResource App.TextSecondary}" Text="{loc:Tr Common.Status}" />
                            <TextBlock Grid.Column="2" Style="{StaticResource NumberCell}" Foreground="{DynamicResource App.TextSecondary}" Text="{loc:Tr Common.Files}" />
                            <TextBlock Grid.Column="3" Style="{StaticResource NumberCell}" Foreground="{DynamicResource App.TextSecondary}" Text="{loc:Tr Common.Size}" />
                            <TextBlock Grid.Column="4" Style="{StaticResource NumberCell}" Foreground="{DynamicResource App.TextSecondary}" Text="{loc:Tr Dialog.NewOnDisk}" Margin="0,3,0,3" />
                        </Grid>
                        <Border BorderBrush="{DynamicResource App.Border}" BorderThickness="0,1,0,0" />
                        <ItemsControl x:Name="DetailRows" Focusable="False" AutomationProperties.Name="{loc:Tr Dialog.FileDetails}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="120" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="State" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="Files" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="Size" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="New" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Cell}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource Cell}" Text="{Binding State}" Foreground="{DynamicResource App.TextSecondary}" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource NumberCell}" Text="{Binding Files}" />
                                        <TextBlock Grid.Column="3" Style="{StaticResource NumberCell}" Text="{Binding Size}" />
                                        <TextBlock Grid.Column="4" Style="{StaticResource NumberCell}" Text="{Binding New}" Margin="0,3,0,3" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="ProblemList" Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <!-- E. Actions. -->
        <Border Grid.Row="2" Background="{DynamicResource App.HeaderBackground}" BorderBrush="{DynamicResource App.Border}" BorderThickness="0,1,0,0" Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="{loc:Tr Common.Cancel}" MinWidth="90" Margin="0,0,8,0" IsCancel="True" Click="OnCancel" />
                <Button x:Name="ArchiveButton" Content="{loc:Tr Common.Archive}" MinWidth="90" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnArchive" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
