<?xml version="1.0" encoding="utf-8"?>
<!--
  Portable edition: ONE self-contained executable (no .NET installation needed) that keeps its
  settings and logs in a "TibiaFoundry-Data" folder next to itself. TagLib# (LGPL-2.1, since 8.6) is
  bundled into it like every other library; the source package accompanies each release.
  Usage (from src/):  dotnet publish TibiaFoundry.App -p:PublishProfile=Portable
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- WPF, ImageMagick and the C runtime ship native DLLs; bundle them into the single file too. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- Symbols inside the executable, so log stack traces keep file and line numbers. -->
    <DebugType>embedded</DebugType>
    <PortableBuild>true</PortableBuild>
    <PublishDir>..\..\dist\TibiaFoundry-8.8.2-portable-win-x64\</PublishDir>
  </PropertyGroup>
</Project>
