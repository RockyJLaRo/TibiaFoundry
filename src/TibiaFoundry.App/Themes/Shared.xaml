<!--
    Shared resources: converters, view-model → view templates, and reusable templates used by
    several pages (property list rows, preview surfaces).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:infra="clr-namespace:TibiaFoundry.App.Infrastructure"
                    xmlns:vm="clr-namespace:TibiaFoundry.App.ViewModels"
             xmlns:loc="clr-namespace:TibiaFoundry.App.Localization">

    <infra:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <loc:LocFormatConverter x:Key="LocFormat" />
    <loc:LocOrConverter x:Key="LocOr" />
    <loc:LocChoiceConverter x:Key="LocChoice" />
    <infra:NullToVisibilityConverter x:Key="NullToVisibility" />
    <infra:InverseBoolConverter x:Key="InverseBool" />
    <infra:EnumEqualsConverter x:Key="EnumEquals" />
    <infra:ResourceKeyConverter x:Key="ResourceKey" />
    <infra:ArgbToBrushConverter x:Key="ArgbToBrush" />
    <infra:NumberConverter x:Key="Number" />
    <infra:ValuesEqualConverter x:Key="ValuesEqual" />
    <infra:IndentMarginConverter x:Key="IndentMargin" />

    <!--
        Page view-models are rendered by their views: the view-model → view templates are created
        from the page registrations (Services/BuiltInTools.cs, Infrastructure/PageTemplates.cs).
    -->

    <!--
        Sprite preview surface. Bind Tag to a PreviewBackground value; clicking cycles it
        (checkerboard → magenta → black → white → gray, like the original preview box).
    -->
    <Style x:Key="PreviewSurface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource App.Checkerboard}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ToolTip" Value="{loc:Tr Common.ClickToChangeTheBackground}" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="{x:Static vm:PreviewBackground.Magenta}">
                <Setter Property="Background" Value="#FF00FF" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static vm:PreviewBackground.Black}">
                <Setter Property="Background" Value="#000000" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static vm:PreviewBackground.White}">
                <Setter Property="Background" Value="#FFFFFF" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static vm:PreviewBackground.Gray}">
                <Setter Property="Background" Value="#F0F0F0" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- One row of a Data panel: label | value (+ swatch, link, play, sprites, copy). -->
    <DataTemplate x:Key="PropertyRowTemplate" DataType="{x:Type vm:PropertyRowViewModel}">
        <Border BorderBrush="{DynamicResource App.GridLine}" BorderThickness="0,0,0,1" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}, FallbackValue=230}" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Foreground="{DynamicResource App.TextSecondary}" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Label}" VerticalAlignment="Top" Margin="0,1,10,0" />
                <StackPanel Grid.Column="1">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="16" Height="16" CornerRadius="3" Margin="0,1,8,0" VerticalAlignment="Top"
                                Background="{Binding Swatch}" BorderBrush="{DynamicResource App.BorderStrong}" BorderThickness="1"
                                Visibility="{Binding Swatch, Converter={StaticResource NullToVisibility}}" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" MinHeight="22" Padding="6,1" Margin="6,-3,0,-3"
                                Command="{Binding PlayCommand}" Visibility="{Binding CanPlay, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="{loc:Tr Common.PlayThisSound}" AutomationProperties.Name="{loc:Tr Common.Play}">
                            <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource App.Accent}" />
                        </Button>
                        <TextBlock Visibility="{Binding HasLink, Converter={StaticResource BoolToVisibility}}" TextWrapping="Wrap">
                            <Hyperlink Command="{Binding OpenLinkCommand}" ToolTip="{loc:Tr Common.OpenOnTibiamapsIo}"><Run Text="{Binding Value, Mode=OneWay}" /></Hyperlink>
                        </TextBlock>
                        <TextBox Style="{StaticResource ValueText}" Text="{Binding Value, Mode=OneWay}"
                                 Visibility="{Binding HasLink, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Sprites}" Margin="0,4,0,0" Visibility="{Binding Sprites, Converter={StaticResource NullToVisibility}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource App.Checkerboard}" Margin="0,0,4,4" CornerRadius="3">
                                    <Image Source="{Binding}" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource SubtleButton}" MinHeight="22" Padding="5,1" Margin="6,-3,0,-3" VerticalAlignment="Top"
                        Command="{Binding CopyCommand}" ToolTip="{loc:Tr Common.CopyValue}" AutomationProperties.Name="{loc:Tr Common.CopyValue}" Opacity="0.6">
                    <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="11" />
                </Button>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- Scrollable, virtualised property list. Set Tag on the ItemsControl to change the label column width. -->
    <Style x:Key="PropertyList" TargetType="ItemsControl">
        <Setter Property="ItemTemplate" Value="{StaticResource PropertyRowTemplate}" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ItemsControl">
                    <Border Background="{DynamicResource App.Surface}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1" CornerRadius="{StaticResource App.CardRadius}">
                        <ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toolbar row that hosts "file: path [Load] [Change file]" controls on page headers. -->
    <Style x:Key="PathBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="FontFamily" Value="{StaticResource App.MonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
    </Style>

    <!-- Empty-state message centered in a panel. -->
    <Style x:Key="EmptyState" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Margin" Value="24" />
        <Setter Property="MaxWidth" Value="420" />
    </Style>
</ResourceDictionary>
