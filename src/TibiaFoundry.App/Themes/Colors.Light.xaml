<!--
    Light palette. Every brush key here must also exist in Colors.Dark.xaml and in
    Core/Theming/ThemeTokens.cs; all control styles reference these keys through DynamicResource
    so themes switch live. Custom themes (Settings → Appearance & Themes) start from this palette
    or the dark one and replace only the colors the user changed.
    Sections are separated clearly: a mid-gray content area and a darker navigation rail around
    white cards with visible borders and tinted card headers (contrast checked: secondary text
    stays above WCAG AA 4.5:1 on every surface, see ThemeResourceTests).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Surfaces -->
    <SolidColorBrush x:Key="App.WindowBackground" Color="#DDE3EA" />
    <SolidColorBrush x:Key="App.NavBackground" Color="#D0D8E2" />
    <SolidColorBrush x:Key="App.HeaderBackground" Color="#F6F8FA" />
    <SolidColorBrush x:Key="App.Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="App.SurfaceAlt" Color="#F0F3F7" />
    <SolidColorBrush x:Key="App.SurfaceSunken" Color="#FFFFFF" />
    <SolidColorBrush x:Key="App.SurfaceReadOnly" Color="#EDF1F5" />
    <SolidColorBrush x:Key="App.CardHeader" Color="#E7EDF4" />

    <!-- Lines -->
    <SolidColorBrush x:Key="App.Border" Color="#B7C1CE" />
    <SolidColorBrush x:Key="App.BorderStrong" Color="#8F9BAA" />
    <SolidColorBrush x:Key="App.GridLine" Color="#E1E6EC" />
    <SolidColorBrush x:Key="App.InputBorder" Color="#AAB5C2" />
    <SolidColorBrush x:Key="App.InputBorderHover" Color="#768395" />

    <!-- Inputs -->
    <SolidColorBrush x:Key="App.InputBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="App.InputText" Color="#1C2530" />

    <!-- Text -->
    <SolidColorBrush x:Key="App.Text" Color="#1C2530" />
    <SolidColorBrush x:Key="App.TextSecondary" Color="#4A5563" />
    <SolidColorBrush x:Key="App.TextDisabled" Color="#97A1AD" />
    <SolidColorBrush x:Key="App.Link" Color="#1F5FC9" />

    <!-- Accent -->
    <SolidColorBrush x:Key="App.Accent" Color="#2F6FDB" />
    <SolidColorBrush x:Key="App.AccentHover" Color="#2861C2" />
    <SolidColorBrush x:Key="App.AccentPressed" Color="#2153A8" />
    <SolidColorBrush x:Key="App.AccentText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="App.AccentSoft" Color="#E1EBFB" />
    <SolidColorBrush x:Key="App.Focus" Color="#2F6FDB" />

    <!-- Interaction states -->
    <SolidColorBrush x:Key="App.ButtonBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="App.ButtonBorder" Color="#C5CDD8" />
    <SolidColorBrush x:Key="App.ButtonText" Color="#1C2530" />
    <SolidColorBrush x:Key="App.Hover" Color="#E3E9F1" />
    <SolidColorBrush x:Key="App.Pressed" Color="#D3DBE6" />
    <SolidColorBrush x:Key="App.Selection" Color="#D4E3FB" />
    <SolidColorBrush x:Key="App.SelectionText" Color="#0E2B57" />
    <SolidColorBrush x:Key="App.SelectionInactive" Color="#DFE5ED" />
    <SolidColorBrush x:Key="App.NavItemHover" Color="#C4CDD8" />
    <SolidColorBrush x:Key="App.NavItemSelected" Color="#FFFFFF" />

    <!-- Status -->
    <SolidColorBrush x:Key="App.Danger" Color="#C42B2B" />
    <SolidColorBrush x:Key="App.DangerSoft" Color="#FBE6E6" />
    <SolidColorBrush x:Key="App.Warning" Color="#9A6A12" />
    <SolidColorBrush x:Key="App.WarningSoft" Color="#FDF3DE" />
    <SolidColorBrush x:Key="App.Success" Color="#2A7A33" />
    <SolidColorBrush x:Key="App.SuccessSoft" Color="#E3F4E5" />

    <!-- Misc -->
    <SolidColorBrush x:Key="App.ScrollThumb" Color="#AEB8C4" />
    <SolidColorBrush x:Key="App.ScrollThumbHover" Color="#98A3B0" />
    <SolidColorBrush x:Key="App.ToolTipBackground" Color="#2A313B" />
    <SolidColorBrush x:Key="App.ToolTipText" Color="#F3F5F8" />
    <SolidColorBrush x:Key="App.Shadow" Color="#22000000" />
    <Color x:Key="App.ShadowColor">#30000000</Color>
    <!-- Transparency checkerboard behind sprites (8 px squares). -->
    <DrawingBrush x:Key="App.Checkerboard" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#FFFFFF" Geometry="M0,0 H16 V16 H0 Z" />
                <GeometryDrawing Brush="#E2E6EB" Geometry="M0,0 H8 V8 H0 Z M8,8 H16 V16 H8 Z" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
</ResourceDictionary>
