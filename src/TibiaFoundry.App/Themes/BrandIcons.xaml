<!--
    Link icons of the About page (24×24 vector drawings, no image files). Each icon sits on its own
    colored badge so it reads in both themes. Simplified marks of the linked services, used only to
    label links to the creator's profiles.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- YouTube: red rounded rectangle with a white play triangle -->
    <DrawingImage x:Key="BrandIcon.YouTube">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#FF0000">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,4,24,16" RadiusX="5" RadiusY="5" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FFFFFF" Geometry="M9.6,8.4 L16.2,12 L9.6,15.6 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Instagram: gradient rounded square with the white camera outline -->
    <DrawingImage x:Key="BrandIcon.Instagram">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                            <GradientStop Color="#FEDA75" Offset="0" />
                            <GradientStop Color="#FA7E1E" Offset="0.25" />
                            <GradientStop Color="#D62976" Offset="0.55" />
                            <GradientStop Color="#962FBF" Offset="0.8" />
                            <GradientStop Color="#4F5BD5" Offset="1" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,24,24" RadiusX="6" RadiusY="6" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FFFFFF" Thickness="1.9" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="5,5,14,14" RadiusX="4" RadiusY="4" />
                            <EllipseGeometry Center="12,12" RadiusX="3.3" RadiusY="3.3" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FFFFFF">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="16.1,7.9" RadiusX="1" RadiusY="1" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- GitHub: the mark in dark gray with a thin light ring (visible on dark backgrounds too) -->
    <DrawingImage x:Key="BrandIcon.GitHub">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#FFFFFF">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="12,12" RadiusX="12" RadiusY="12" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <DrawingGroup>
                    <DrawingGroup.Transform>
                        <MatrixTransform Matrix="0.9,0,0,0.9,1.2,1.2" />
                    </DrawingGroup.Transform>
                    <GeometryDrawing Brush="#24292F"
                                     Geometry="M12,.297 C5.37,.297 0,5.67 0,12.297 C0,17.6 3.438,22.097 8.205,23.682 C8.805,23.795 9.025,23.424 9.025,23.105 C9.025,22.82 9.015,22.065 9.01,21.065 C5.672,21.789 4.968,19.455 4.968,19.455 C4.422,18.07 3.633,17.7 3.633,17.7 C2.546,16.956 3.717,16.971 3.717,16.971 C4.922,17.055 5.555,18.207 5.555,18.207 C6.625,20.042 8.364,19.512 9.05,19.205 C9.158,18.429 9.467,17.9 9.81,17.6 C7.145,17.3 4.344,16.268 4.344,11.67 C4.344,10.36 4.809,9.29 5.579,8.45 C5.444,8.147 5.039,6.927 5.684,5.274 C5.684,5.274 6.689,4.952 8.984,6.504 C9.944,6.237 10.964,6.105 11.984,6.099 C13.004,6.105 14.024,6.237 14.984,6.504 C17.264,4.952 18.269,5.274 18.269,5.274 C18.914,6.927 18.509,8.147 18.389,8.45 C19.154,9.29 19.619,10.36 19.619,11.67 C19.619,16.28 16.814,17.295 14.144,17.59 C14.564,17.95 14.954,18.686 14.954,19.81 C14.954,21.416 14.939,22.706 14.939,23.096 C14.939,23.411 15.149,23.786 15.764,23.666 C20.565,22.092 24,17.592 24,12.297 C24,5.67 18.627,.297 12,.297 Z" />
                </DrawingGroup>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Reddit: orange disc with a simplified white Snoo face -->
    <DrawingImage x:Key="BrandIcon.Reddit">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#FF4500">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="12,12" RadiusX="12" RadiusY="12" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FFFFFF">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="12,14" RadiusX="6.6" RadiusY="4.6" />
                            <EllipseGeometry Center="6.2,11.6" RadiusX="1.6" RadiusY="1.6" />
                            <EllipseGeometry Center="17.8,11.6" RadiusX="1.6" RadiusY="1.6" />
                            <EllipseGeometry Center="15.6,5.6" RadiusX="1.4" RadiusY="1.4" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M12,9.5 L13,5.2 L15.6,5.6">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FFFFFF" Thickness="1.1" StartLineCap="Round" EndLineCap="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FF4500">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="9.5,13.4" RadiusX="1.15" RadiusY="1.15" />
                            <EllipseGeometry Center="14.5,13.4" RadiusX="1.15" RadiusY="1.15" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M9.4,15.9 Q12,17.6 14.6,15.9">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FF4500" Thickness="1" StartLineCap="Round" EndLineCap="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- TibiaWiki: blue badge with a bold "W" (pages on tibia.fandom.com) -->
    <DrawingImage x:Key="BrandIcon.TibiaWiki">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#1F5FA8">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,24,24" RadiusX="5" RadiusY="5" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M4.4,7 L8,17 L12,9.4 L16,17 L19.6,7">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FFFFFF" Thickness="2.1" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Tibia character profile: gold badge with a sword (tibia.com) -->
    <DrawingImage x:Key="BrandIcon.Tibia">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#8A5A12">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,24,24" RadiusX="5" RadiusY="5" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#F4D78A" Geometry="M16.9,4 L20,4 L20,7.1 L11.4,15.7 L8.3,12.6 Z" />
                <GeometryDrawing Geometry="M6.6,11.6 L12.4,17.4 M8.9,15.1 L5.2,18.8">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#F4D78A" Thickness="2" StartLineCap="Round" EndLineCap="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
</ResourceDictionary>
