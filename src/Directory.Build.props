<Project>
  <!-- Settings shared by every project in the solution. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Symbols inside each assembly: single-file/portable builds stay one file, logs keep line numbers. -->
    <DebugType>embedded</DebugType>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!-- Application identity (also in TibiaFoundry.Core/Common/AppIdentity.cs). -->
    <Product>Tibia Foundry</Product>
    <!--
      THE version, and the only place to change it. Releases are "major.minor" ("9.0", tag v9.0), patch
      releases add a third part ("9.0.1", tag v9.0.1); a ".0" patch is never written. The packaging scripts,
      the installer, the About page, the User-Agent and the file names all read it from here.
      Windows needs four numbers for the file and assembly versions, so they are padded (9.0.1 -> 9.0.1.0);
      that internal form is never shown. app.manifest repeats it (BrandingTests checks that they agree).
    -->
    <Version>9.0.4</Version>
    <_PaddedVersion>$([System.Version]::Parse('$(Version)').Major).$([System.Version]::Parse('$(Version)').Minor).$([System.Math]::Max(0, $([System.Version]::Parse('$(Version)').Build))).0</_PaddedVersion>
    <FileVersion>$(_PaddedVersion)</FileVersion>
    <AssemblyVersion>$(_PaddedVersion)</AssemblyVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <!-- Keep the product version "9.0.4": the SDK would append "+<commit>" when building from a git checkout. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Company>RockyLaRo</Company>
    <Authors>RockyLaRo</Authors>
    <Copyright>Tibia Foundry © 2026 RockyLaRo (TibiaWiki Admin). Tibia game graphics © CipSoft GmbH.</Copyright>
    <Description>Tibia Foundry is an independent desktop toolkit for Tibia fansite administrators, wiki editors, artists and content creators: it turns the official files of the installed Tibia client into graphics, maps, sounds and data for TibiaWiki (https://tibia.fandom.com/) and Tibia community websites.</Description>

    <!-- CA1416 (platform compatibility) is noise: the whole solution is Windows-only by design. -->
    <NoWarn>$(NoWarn);CA1416;CA1848;CA1305;CA1307;CA1309;CA1310;CA1311;CA1304;CA2201;CA1031;CA1062;CA1716;CA1002;CA2227;CA1819;CA1720;CA1711;CA1707;CA1805;CA1852;CA1822;CA1859;CA1861;CA1865;CA1866;CA1847;CA1869;CA1510</NoWarn>
  </PropertyGroup>
</Project>
